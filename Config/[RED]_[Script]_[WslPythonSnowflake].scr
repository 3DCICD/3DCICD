import WslPythonCommon
import pyodbc
import os
import sys
import fnmatch
import pytds
from pytds import login
#
#.DESCRIPTION
#Used to run any SQL against Snowflake
#.EXAMPLE
#return_Msg = RunSnowflakeRedSQL( "SELECT * FROM stage_customers", "dssdemo", "Some Error step")
#
def RunSnowflakeRedSQL(sql,
                        dsn,
                        uid,
                        pwd,
                        failureMsg,
                        status,
                        step=0,
                        connection=""
    ):
    snowflakeResult =  RunRedSQL_SF(sql,dsn,uid, pwd,connection)
    if snowflakeResult[1] == 1:
      if snowflakeResult[2] >= 0:
        try:
            newvar = WslPythonCommon.WsWrkAudit ('I', "Step "+ str(step) + ": rows applied: " + str(snowflakeResult[2]),'','')
        except Exception as inst:
            print("Error: "+str(inst.args))
            print(inst)
      else:
        newvar = WslPythonCommon.WsWrkAudit ('I',"Step " + str(step) +": completed"+str(snowflakeResult[4]),'','')
    else:
       db_msg = snowflakeResult[3][1]
       db_code = snowflakeResult[3][0]
       newvar =  WslPythonCommon.WsWrkAudit ('E', "Step "+ str(step) + ": An error has occurred: " + db_msg,'','')
       i=0
       while i <= int(len(sql)/250):
        length_n = len(sql) - ((i*250)+1)
        if length_n > 250:
           length_n = 250
        newvar = WslPythonCommon.WsWrkError('E',sql[(i*250)+1:((i*250))+250],'','','')
        i=i+1
       raise Exception(db_msg)
    return snowflakeResult[0], snowflakeResult[1], snowflakeResult[2],failureMsg , snowflakeResult[4]

def addapplicationid(connectionstring):
    if connectionstring[-1] !=  ";":
        connectionstring+=";application='Wherescape_SFEP'"
    else:
        connectionstring+="application='Wherescape_SFEP'"   
    return connectionstring

def RunRedSQL_SF(
                sql,
                dsn,
                uid,
                pwd,
                connection="",
                options=''
               ):
    if os.environ.get('WSL_TGT_CONSTRING','') != "":
        connectionString = os.environ.get('WSL_TGT_CONSTRING','')
    else:
        connectionString = 'DSN='+dsn
        if uid and not uid.isspace():
            connectionString +=';UID='+uid
        if pwd and not pwd.isspace():
            connectionString +=';PWD='+pwd
    connectionString += options

    numberOfRows=0
    rows=''
    infoEvent=''
    flag=0
    try:
        if sql and not sql.isspace():
         if connection not in (None, ""):
           cursor=connection.cursor().execute(sql)
         else:
           if connection=="":
             flag=1
           connectionString =  addapplicationid(connectionString)
           connection = pyodbc.connect(connectionString, autocommit=True)
           query_tag = WslPythonCommon.GetExtendedProperty("SF_QUERY_TAG", str(os.environ.get('WSL_LOAD_TABLE',''))).strip()
           if query_tag and query_tag.strip():
               query_sql = f"ALTER SESSION SET QUERY_TAG = '{query_tag}'"
               connection.cursor().execute(query_sql)
           cursor=connection.cursor().execute(sql)

    except Exception as e:
           return connection,-2,0,e.args,rows
    try:

        if sql.lstrip().startswith("SELECT")==True:
         try:
          rows = cursor.fetchall()
          numberOfRows=len(rows)
         except Exception as inst:
            infoEvent=inst
        else:
           numberOfRows=cursor.rowcount
        if flag==1:
         connection.commit()
         connection.close()
        return connection,1,numberOfRows,infoEvent,rows
    except pyodbc.Error as ex:
        sqlstate = ex.args[0]
        return connection,-2,numberOfRows,ex.args,rows
