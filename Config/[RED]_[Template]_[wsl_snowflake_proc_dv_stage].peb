{# --                                                                                                                                                       -- #)
{# -- DBMS Name          : SNOWFLAKE                                                                                                                         -- #)
{# -- Template Name      : wsl_snowflake_proc_stage                                                                                                          -- #)
{# -- Template Version   : 8.1.1.0                                                                                                                          -- #}
{# -- Description        : This template creates a simple Teradata procedure using Insert                                                                   -- #)
{# --                      specifically designed for RED multi source stage tables                                                                          -- #)
{# --                                                                                                                                                       -- #)
{# -- =============================================================================                                                                         -- #)
{# --                                                                                                                                                       -- #)
{# --                                                                                                                                                       -- #)
{# -- Notes / History                                                                                                                                       -- #)
{# --                                                                                                                                                       -- #}
{# --                                                                                                                                                       -- #}
{% import "wsl_snowflake_utility" %}
{% import "wsl_snowflake_utility_dv" %}
{# --
{# --                     Start of main procedure text                                                               -- #}
--=============================================================================={%br%}
-- DBMS Name        :    {{table.dbType.name}}{%br%}
-- Procedure Name   :    {{settings.procedureName}}{%br%}
-- Template         :    {{settings.template.name}}{%br%}
-- Template Version :    8.1.1.0{%br%}
-- Description      :    Update the {{table.objectType.name}} table {{table.name}}{%br%}
-- Generated by     :    {{env.productVersion}}{%br%}
-- Generated for    :    {{env.licensedTo}}{%br%}
-- Generated on     :    {{env.currentTimestamp}}{%br%}
-- Author           :    {{env.userName}}{%br%}
--=============================================================================={%br%}
-- Notes / History{%br%}
--{%br%}
{#- Set things up #}
{{- addProcedureHeader(settings.deleteBeforeInsert, settings.deleteBeforeInsertTruncate)}}
  {{- addProcedureCommentBlock(commentMessage = "MAIN")}}

{#- Insert new records #}
BEGIN{%br%}

{#- Delete old records #}

{%- if settings.deleteBeforeInsert %}
    {{- addProcedureCommentBlock(commentMessage = "Delete existing data from the table")}}
    v_step         := {% counter %}00;{%br%}
    {%- if settings.deleteBeforeInsertTruncate %}
    DELETE FROM [TABLEOWNER].[{{table.name}}];{%br%}{%br%}
    {%- else %}
    DELETE FROM [TABLEOWNER].[{{table.name}}]{%br%}
    {%- if settings.deleteWhereClause | trim != "" %}    {{settings.deleteWhereClause}}{%br%} {%- endif %}
    ;{%br%}{%br%}
    v_row_count := SQLROWCOUNT;
    v_delete_count := v_delete_count + v_row_count;{%br%}{%br%}
    {%- endif %}
{%- endif %}

{#- Insert new records #}
    {{- addProcedureCommentBlock(commentMessage = "Insert new records")}}
    v_step := {% counter %}00;{%br%}{%br%}
      INSERT INTO [TABLEOWNER].[{{table.name}}]{%br%}
      {{- addSetInsertTargetColumns(indentString= "  ")}}
      SELECT {{distinct()}} {{addSetInsertColumns(indentString= "       ")}}
      {%- if table.sourceJoinDetails.join | trim != "" %}  {{table.sourceJoinDetails.join}}{%br%} {%- endif %}
      {%- if table.sourceJoinDetails.where | trim != "" %}  {{table.sourceJoinDetails.where | trim }}{%br%} {%- endif %}
      {%- if table.sourceJoinDetails.groupBy | trim != "" %}  {{table.sourceJoinDetails.groupBy | trim }}{%br%} {%- endif %}
      ;{%br%}{%br%}
    v_row_count := SQLROWCOUNT;
    v_insert_count := v_insert_count + v_row_count;{%br%}{%br%}

    COMMIT;{%br%}
{#- Finish Up #}

    {{- addProcedureCommentBlock(commentMessage = "All Done report the results")}}
    {{- addReturnMessage(settings.deleteBeforeInsert, settings.deleteBeforeInsertTruncate, addMerge = FALSE, addInsert = TRUE)}}

{{- addProcedureException()}}

END;{%br%}
