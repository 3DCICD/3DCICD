WHERE NOT EXISTS (SELECT 1 FROM red.ws_table_attributes WHERE ta_type = 'R');
-- Update Script Connection
"@
		}
   Execute-SQL-Block $sql
  }
}


# Install FieldSolutions
Function Install-FieldSolutions {
	  $res = @{Step = $installStep+1; Outcome = 'Unknown'; Operation = 'Install-FieldSolutions'; Information = "{Install FieldSolutions}"; Command = ''}
	  if( ([string]::IsNullOrEmpty($metaUser) -and [string]::IsNullOrEmpty($metaPwd)) -or ([string]::IsNullorWhitespace($metaUser) -and [string]::IsNullorWhitespace($metaPwd))) {
	   & powershell -ExecutionPolicy ByPass -file ".\FieldSolutions\import_fieldsolutions.ps1" -metaDsn "$metaDsn"
	  }else{
	  & powershell -ExecutionPolicy ByPass -file ".\FieldSolutions\import_fieldsolutions.ps1" -metaDsn "$metaDsn" -metaUser "$metaUser" -metaPwd "$metaPwd"
	  }
	  if( $LASTEXITCODE -eq 0 ) {
		Write-Output "FieldSolutions updated successfully"
		$res.Outcome = 'Success'
	  } else {
		Write-Warning "Failures during FieldSolutions import"
		Exit $LASTEXITCODE
		$res.Outcome = 'Warning'
		$res.Information = 'Failures during FieldSolutions import'
	  }
	  $global:results += $res
	  [PSCustomObject]$res | Format-Table -AutoSize -Wrap -Property Step,Outcome,Operation,Information
	  if ($res.Outcome -ne 'Success' -and $continueOnFailure -eq $false) {
			# stop the script
			#throw $res.Outcome
	  }
}
