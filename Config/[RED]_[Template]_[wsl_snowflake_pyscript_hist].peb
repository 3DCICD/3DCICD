{# --                                                                                                                                                       -- #}
{# -- DBMS Name          : SNOWFLAKE                                                                                                                        -- #}
{# -- Template Name      : wsl_snowflake_pyscript_hist                                                                                                      -- #}
{# -- RED Version        : 8.5.1.0                                                                                                                          -- #}
{# -- Description        : This template creates a Python based Snowflake update script                                                                     -- #}
{# --                      specifically designed for all RED non-stage tables with history tracking                                                         -- #}
{# --                                                                                                                                                       -- #}
{# -- =============================================================================                                                                         -- #}
{# --                                                                                                                                                       -- #}
{# --                                                                                                                                                       -- #}
{# -- Notes / History                                                                                                                                       -- #}
{# --                                                                                                                                                       -- #}
{% fetch table %}
{% set counter = 0 %}
{% set dssDeleteTime = "DSS_DELETE_TIME" %}
{% set dssDeleteFlag = "DSS_DELETE_FLAG" %}
{% import "wsl_snowflake_utility" %}
{% import "wsl_snowflake_utility_dml" %}
{% import "wsl_snowflake_utility_dml_py" %}
{# --                                                            Start of main procedure text                                                               -- #}
#--=============================================================================={%br%}
#-- DBMS Name        :    SNOWFLAKE {{table.dbType.name}}{%br%}
#-- Block Name       :    {{settings.procedureName}}{%br%}
#-- Template         :    {{settings.template.name}}{%br%}
#-- Template Version :    8.5.1.0{%br%}
#-- Description      :    Update the {{table.objectType.name}} table {{table.name}}{%br%}
#-- Generated by     :    {{env.productVersion}}{%br%}
#-- Generated for    :    {{env.licensedTo}}{%br%}
#-- Generated on     :    {{env.currentTimestamp}}{%br%}
#-- Author           :    {{env.userName}}{%br%}
#--=============================================================================={%br%}
#-- Notes / History{%br%}
#--{%br%}

import os{%br%}
import sys{%br%}
import fnmatch{%br%}
import json{%br%}
import traceback{%br%}

pathToWslPythonCommon = r"$WSL_SCRIPT_WslPythonCommon_CODE$"
pathToWslPythonSnowflake = r"$WSL_SCRIPT_WslPythonSnowflake_CODE$"

import WslPythonCommon{%br%}
import WslPythonSnowflake{%br%}

if sys.platform == 'win32':{%br%}
    WslPythonCommon.HideWindow(){%br%}


#--============================================================================{%br%}
#-- Init Logger{%br%}
#--============================================================================{%br%}
debugModeExt = 'FALSE'
{% include "wsl_template_pyscript_utility" %}
{%br%}


#--============================================================================{%br%}
#-- General Variables{%br%}
#--============================================================================{%br%}{%br%}
sequence = os.environ.get('WSL_SEQUENCE',''){%br%}
jobName = os.environ.get('WSL_JOB_NAME',''){%br%}
taskName = os.environ.get('WSL_TASK_NAME',''){%br%}
jobId = os.environ.get('WSL_JOB_KEY',''){%br%}
taskId = os.environ.get('WSL_TASK_KEY',''){%br%}
returnMsg = "{{table.name}} updated."{%br%}
status = 1{%br%}
connection=None{%br%}
#--============================================================================{%br%}
#-- Main{%br%}
#--============================================================================{%br%}{%br%}
step = {% counter %}00{%br%}
{#- Work out if we are doing logical deletes -#}
{%- set dssDeleteTimePresent = false -%}
{%- set dssDeleteFlagPresent = false -%}
{%- from table.columns as column where column.name == dssDeleteTime -%}
  {% set dssDeleteTimePresent = true %}
{%- endfrom -%}
{%- from table.columns as column where column.name == dssDeleteFlag -%}
  {% set dssDeleteFlagPresent = true %}
{%- endfrom -%}
{%- from table.columns as column where column.name == dssDeleteTime or column.name == dssDeleteFlag -%}
logicalDeleteCount = 0{%br%}
{%- endfrom -%}
{%- if settings.deleteBeforeInsert and not settings.deleteBeforeInsertTruncate %}
deleteCount = 0{%br%}
{%- endif %}
mergeCount = 0{%br%}
DSN = str(os.environ.get('WSL_TGT_DSN',''))
USER = str(os.environ.get('WSL_TGT_USER',''))
PWD = str(os.environ.get('WSL_TGT_PWD',''))
{%- for par in settings.parameters %}
  {%- if loop.first %}
{%br%}
#--============================================================================{%br%}
#-- Set Parameter Variables{%br%}
#--============================================================================{%br%}
step = {% counter %}00{%br%}{%br%}
  {%- endif %}
{{par}} = WslPythonCommon.WsParameterRead ("{{par}}")[0][0]{%br%}
{%- endfor %}
{%br%}
{%br%}
try:{%br%}
    {% set timezoneParam = getExtendedProperty( propertyName = "SF_TIMEZONE" ) | trim -%}
    {%- if timezoneParam != "" -%}
    #--============================================================================{%br%}
    #-- Set Timezone{%br%}
    #--============================================================================{%br%}
    step = {% counter %}00{%br%}{%br%}
    timeZone = WslPythonCommon.GetExtendedProperty("SF_TIMEZONE","{{table.name}}"){% br %}
    if timeZone and not timeZone.isspace():
        tzSql = "ALTER SESSION SET TIMEZONE = '"+timeZone+"'"
        MSG = 'Failed to alter session timezone to '
        SnowflakeResult=WslPythonSnowflake.RunSnowflakeRedSQL(tzSql,DSN,USER,PWD,MSG+str(step),'',step,connection)
        status=SnowflakeResult[1]
        connection=SnowflakeResult[0]
        if status<1:
          returnMsg = str(SnowflakeResult[3])
          scriptResultMessage = str(SnowflakeResult[3])
          write_error(scriptResultMessage)
          raise Exception(scriptResultMessage)
        else:
          returnMsg = str(SnowflakeResult[2])
    {% br %}
    {%- endif %}{% br %}

    {%- if settings.deleteBeforeInsert %}
      {%- if settings.deleteBeforeInsertTruncate %}{%br%}
    if status==1:
    {%br%}
      #--============================================================================{%br%}
      #-- Truncate existing records{%br%}
      #--============================================================================{%br%}
      step = {% counter %}00{%br%}{%br%}
      sql = "TRUNCATE TABLE [TABLEOWNER].[{{table.name}}];"{%br%}
      SnowflakeResult =WslPythonSnowflake.RunSnowflakeRedSQL(sql,DSN,USER,PWD,'Failed truncating table {{table.name}} step '+str(step) , '',step,connection)
      returnMsg = str(SnowflakeResult[2]){%br%}
      status=SnowflakeResult[1]
      connection=SnowflakeResult[0]
      if status<1:
       returnMsg = str(SnowflakeResult[3])
       scriptResultMessage = str(SnowflakeResult[3])
       write_error(scriptResultMessage)
       raise Exception(scriptResultMessage)
      else:
       returnMsg += str(SnowflakeResult[2])
      {%br%}
      {%- else %}{%br%}
    if status==1:
    {%br%}
      #--============================================================================{%br%}
      #-- Delete existing records{%br%}
      #--============================================================================{%br%}
      step = {% counter %}00{%br%}{%br%}
      sql = """DELETE FROM [TABLEOWNER].[{{table.name}}]{%br%}
      {%- if settings.deleteWhereClause | trim != "" %}  {{settings.deleteWhereClause}}{%br%}{%- endif %}
      ;{%br%}
    """
      SnowflakeResult =WslPythonSnowflake.RunSnowflakeRedSQL(sql,str(os.environ.get('WSL_TGT_DSN','')),str(os.environ.get('WSL_TGT_USER','')), str(os.environ.get('WSL_TGT_PWD','')),
      'Failed deleting table {{table.name}} step '+str(step) , '',step,connection)
      deleteCount = SnowflakeResult[2]
      status=SnowflakeResult[1]
      connection=SnowflakeResult[0]
      if status<1:
       returnMsg = str(SnowflakeResult[3])
       scriptResultMessage = str(SnowflakeResult[3])
       write_error(scriptResultMessage)
       raise Exception(scriptResultMessage)
      else:
       returnMsg = str(SnowflakeResult[2]){%br%}
      {%- endif %}
    {%- endif %}

    {%- if settings.insertZeroKeyRecord %}
      {% from table.columns as column where column.artificial %}
        {% if loop.first %}{%br%}
    if status==1:
    {%br%}
    #--============================================================================{%br%}
    #-- Refresh zero key records{%br%}
    #--============================================================================{%br%}{%br%}
      step = {% counter %}00{%br%}{%br%}
      sql ="""MERGE INTO [TABLEOWNER].[{{table.name}}]{%br%}
      USING ({%br%}
        SELECT {{defaultColumnsSnowflake()}}
        FROM   DUAL{%br%}
        ) AS src{%br%}
      ON {{getArtificialKey()}} = 0{%br%}
      WHEN MATCHED THEN UPDATE{%br%}
      SET{{- addMergeUpdateColumns(alias = "src")}}
      WHEN NOT MATCHED THEN INSERT{%br%}
      {{addSetInsertTargetColumns(includeIdentity = true)}}
      ){%br%}
      VALUES
      ({{- addSetInsertColumnsSnowflake(addArtificialKey = true, alias = "src", zeroKeyInsert = true, indent = "  ", addColumnName = false, ignoreDssColumns = true,includeIdentity = true)}}
      ){%br%}
      ;{%br%}
    """

      SnowflakeResult =WslPythonSnowflake.RunSnowflakeRedSQL(sql,str(os.environ.get('WSL_TGT_DSN','')),str(os.environ.get('WSL_TGT_USER','')), str(os.environ.get('WSL_TGT_PWD','')),
      'Failed zero key merge into table {{table.name}} step '+str(step) , '',step,connection)
      mergeCount = mergeCount + SnowflakeResult[2]
      status=SnowflakeResult[1]
      connection=SnowflakeResult[0]
      returnMsg = SnowflakeResult[2]{%br%}
      if status<1:
         scriptResultMessage = str(SnowflakeResult[3])
         write_error(scriptResultMessage)
         raise Exception(scriptResultMessage)
        {%- endif -%}
      {%- endfrom -%}
    {%- endif %}

    {%- if dssDeleteTimePresent or dssDeleteFlagPresent -%}{%br%}
    if status==1:
    #--============================================================================{%br%}
    #-- Ensure there is Source Data before performing a logical delete {%br%}
    #--============================================================================{%br%}{%br%}
      step = {% counter %}00{%br%}{%br%}
      sql = """ {%- br %}
      SELECT COUNT(*) {%- br %}
      {%- for joinLine in (table.sourceJoinDetails.join | lines)%}  {{joinLine}}{%br%}{%- endfor%}
      ;{%br%}
    """ {%- br %}
      SourceCount = WslPythonSnowflake.RunSnowflakeRedSQL(sql,str(DSN,USER,PWD,'Failed batch distinct select from source tables  {{table.name}} step '+str(step) , '',step,connection)
      connection=SourceCount[0]
      for row in SourceCount[4]:{%br%}
        if row[0] >0: {%br%}
    #--============================================================================{%br%}
    #-- Perform Logical Deletes{%br%}
    #--============================================================================{%br%}{%br%}
          step = {% counter %}00{%br%}{%br%}
          sql = """
          UPDATE [TABLEOWNER].[{{table.name}}]{%br%}
          {%- if dssDeleteTimePresent and dssDeleteFlagPresent %}
          SET    {{dssDeleteTime}} = CAST(CURRENT_TIMESTAMP AS TIMESTAMP){%br%}
               , {{dssDeleteFlag}} = 'Y'{%br%}
          {%- elseif dssDeleteTimePresent %}
          SET    {{dssDeleteTime}} = CAST(CURRENT_TIMESTAMP AS TIMESTAMP){%br%}
          {%- elseif dssDeleteFlagPresent %}
          SET    {{dssDeleteFlag}} = 'Y'{%br%}
          {%- endif -%}
          {%- from table.columns as column where column.currentFlag or column.dssEndDate %}
            {%- if column.currentFlag %}
               , {{column.name}} = 'N'{%br%}
            {%- elseif column.dssEndDate %}
               , {{column.name}} = {{settings.changeDetectionEndExpiring}}{%br%}
            {%- endif %}
          {%- endfrom %}
          WHERE NOT EXISTS ( {%br%}
            SELECT 1{%br%}
          {%- for joinLine in (table.sourceJoinDetails.join | lines)%}        {{joinLine | trim}}{%br%}{%- endfor%}
            {{addWhereJoinToTarget()}}{%br%}
            ){%br%}
          {%- if dssDeleteFlagPresent %}
          AND   {{dssDeleteFlag}} = 'N'{%br%}
         {%- from table.columns as column where column.dssVersion %}
          AND   {{ table.name }}.{{ column.name }} =({%br%}
          {%- endfrom %}
            SELECT MAX(maxversion.dss_version)
            FROM [TABLEOWNER].[{{table.name}}] AS maxversion
            {{addWhereJoinToTargetMaxVersion()}}
            )
          {%- elseif dssDeleteTimePresent %}
          AND   {{dssDeleteTime}} IS NULL{%br%}
          {%- endif -%}
          {%- from table.columns as column where column.artificial %}
          AND   {{column.name}} <> 0{%br%}
          {%- endfrom %}
          ;{%br%}
    """
          SnowflakeResult = WslPythonSnowflake.RunSnowflakeRedSQL(sql,str(os.environ.get('WSL_TGT_DSN','')),str(os.environ.get('WSL_TGT_USER','')), str(os.environ.get('WSL_TGT_PWD','')),
          ' Failed logical delete in table {{table.name}} step'+ str(step)  , '',step,connection)
          logicalDeleteCount = logicalDeleteCount + SnowflakeResult[1]
          status=SnowflakeResult[1]
          connection=SnowflakeResult[0]
          returnMsg = SnowflakeResult[2]{%br%}
          if status<1:
              scriptResultMessage = str(SnowflakeResult[3])
              write_error(scriptResultMessage)
              raise Exception(scriptResultMessage)
        {%br%}
      {%br%}
    {%br%}
    {%- endif %}
    {%- if settings.batchProcessingField != ""   %}
     {%- if dssDeleteTimePresent or dssDeleteFlagPresent  %}
    	 {%- error "Batch delete is not supported with logical delete for history tables" -%}
     {%- endif %}
      {%- set batchIndent = "  " %}
    {%- else %}
      {%- set batchIndent = "" %}
    {%- endif %}
    {%br%}

    {#-                           -#}
    {#- C H E C K  I F  T A B L E  I S  H I S T -#}
    {#-                            #}
    {%- set dimKeypresent = "" %}
    {% from table.columns as column where column.artificial %}
        {% if loop.first %}{%br%}{%- set dimKeypresent = column.name %}{%- endif %}
    {%- endfrom %}
    {%- if dimKeypresent == ""  %}{%br%}
    if status==1:
    {%br%}
    {%- set dssFlag = false %}
      {%- from table.columns as currFlag where currFlag.currentFlag %}
        {%- set dssFlag = true %}
      {%- endfrom %}
             {{- addBatchLoopSelectClause("      ")}}
        {{batchIndent}}#--============================================================================{%br%}
        {{batchIndent}}#--UPDATE DELETED RECORD TO N{%br%}
        {{batchIndent}}#--============================================================================{%br%}{%br%}
        {{batchIndent}}step = {% counter %}00{%br%}{%br%}
        {{batchIndent}}sql = """
        {{batchIndent}}MERGE INTO [TABLEOWNER].[{{table.name}}]{%br%}
        {{batchIndent}}USING ({%br%}
         {#-                           -#}
        {#- D E L E T E D   R O W S -#}
        {#-                            #}
          {{batchIndent}}-- DELETED ROWS THAT NEED TO BE EXPIRED{%br%}
        {{- addType2ExpiringRowSelect ( indent = "    " + batchIndent ) -}}
        {{- addFromClause ( indent = "    " + batchIndent ) -}}
        {{- addJoinToTarget ( joinType = "RIGHT OUTER", indent = "    " + batchIndent ) -}}
        {{- addMaxKeyJoin ( indent = "    " + batchIndent ) -}}
        {{- addWhereClause ( indent = "    " + batchIndent ) -}}
        {#- WHERE STAFF ID IS NOT NULL #}
        {%- if table.sourceJoinDetails.where | trim != "" %}{{batchIndent}}    AND {% else %}{{batchIndent}}    WHERE {% endif %}
        {%- from table.columns as bk where bk.businessKey -%}
          {%- if not loop.first -%}{{batchIndent}}    AND {% endif -%}
          {{- bk.source}} IS NULL{% br %}
        {%- endfrom %}
        {#- WHERE CURRENT FLAG -#}
        {%- from table.columns as column where column.currentFlag %}{{batchIndent}}    AND {{ table.name }}.{{ column.name }} = 'Y'{% br %}{% endfrom %}
        {{- addBatchLoopWhereClause(dssFlag = dssFlag)}}
        {{- addGroupByClause ( indent = "    " + batchIndent ) -}}
        {{batchIndent}}
        {{batchIndent}}) AS src{%br%}
        {{batchIndent}}{{addMergeJoinCondition(alias = "src", indent = batchIndent+"  ")}}
        {{batchIndent}}WHEN MATCHED THEN UPDATE{%br%}
        {{batchIndent}}SET{{- addMergeUpdateColumns(alias = "src", indent = batchIndent+"    ")}}
        {{batchIndent}}WHEN NOT MATCHED THEN INSERT{%br%}
        {{batchIndent}}{{addSetInsertTargetColumns(indent = batchIndent)}}
        {{batchIndent}}){%br%}
        {{batchIndent}}VALUES{%br%}
        {{batchIndent}}({{- addSetInsertColumnsSnowflake(addArtificialKey = true, alias = "src", indent = batchIndent+"  ", addColumnName = false, ignoreDssColumns = true)}}
        {{batchIndent}}){%br%}
        {{batchIndent}};{%br%}
    """
        {{batchIndent}}SnowflakeResult =WslPythonSnowflake.RunSnowflakeRedSQL(sql,str(os.environ.get('WSL_TGT_DSN','')),str(os.environ.get('WSL_TGT_USER','')), str(os.environ.get('WSL_TGT_PWD','')),
        {{batchIndent}}' Failed  merge into table {{table.name}} step '+str(step) , '',step,connection)
        {{batchIndent}}mergeCount = mergeCount + SnowflakeResult[2]
        {{batchIndent}}status=SnowflakeResult[1]{%br%}
        {{batchIndent}}connection=SnowflakeResult[0]{%br%}
        {{batchIndent}}returnMsg = SnowflakeResult[2]{%br%}
        {{batchIndent}}{%br%}
        {{batchIndent}}if status<1:
            {{batchIndent}}scriptResultMessage = str(SnowflakeResult[3])
            {{batchIndent}}write_error(scriptResultMessage)
            {{batchIndent}}raise Exception(scriptResultMessage)
        {%- if settings.batchProcessingField != "" %}
        {%- endif %}{%br%}


             {{- addBatchLoopSelectClause("      ")}}
        {{batchIndent}}#--============================================================================{%br%}
        {{batchIndent}}#--SELECT MAX DSS_VERSION WHERE DSS_CURRENT_FLAG IS N AND CHANGE IT TO 'D'{%br%}
        {{batchIndent}}#--============================================================================{%br%}{%br%}
        {{batchIndent}}step = {% counter %}00{%br%}{%br%}
        {{batchIndent}}sql = """
        {{batchIndent}}MERGE INTO [TABLEOWNER].[{{table.name}}]{%br%}
        {{batchIndent}}USING ({%br%}
         {#-                           -#}
        {#- M A X  D S S  V E R S I O N  R O W S  F O R  F L A G  N -#}
        {#-                            #}
          {{batchIndent}}-- CHANGE FLAG TO D WHERE FLAG IS N AND DSS_VERSION IS MAX{%br%}
        {{- addType2ExpiringRowSelect_setting_flag_d  ( indent = "    " + batchIndent ) -}}
        {{batchIndent}}    FROM [TABLEOWNER].[{{table.name}}]{%br%}
        {#- WHERE CURRENT FLAG -#}
        {%- from table.columns as column where column.currentFlag %}{{batchIndent}}    WHERE {{ table.name }}.{{ column.name }} = 'N'{% br %}{% endfrom %}
        {{- addBatchLoopWhereClause(dssFlag = dssFlag)}}
        {{- addGroupByClause ( indent = "    " + batchIndent ) -}}
          ) ranked{%br%}
          WHERE ranked.rn = 1 {%br%}
        {{batchIndent}}
        {{batchIndent}}) AS src{%br%}
        {{batchIndent}}{{addMergeJoinCondition(alias = "src", indent = batchIndent+"  ")}}
        {{batchIndent}}WHEN MATCHED THEN UPDATE{%br%}
        {{batchIndent}}SET{{- addMergeUpdateColumns(alias = "src", indent = batchIndent+"    ")}}
        {{batchIndent}}WHEN NOT MATCHED THEN INSERT{%br%}
        {{batchIndent}}{{addSetInsertTargetColumns(indent = batchIndent)}}
        {{batchIndent}}){%br%}
        {{batchIndent}}VALUES{%br%}
        {{batchIndent}}({{- addSetInsertColumnsSnowflake(addArtificialKey = true, alias = "src", indent = batchIndent+"  ", addColumnName = false, ignoreDssColumns = true)}}
        {{batchIndent}}){%br%}
        {{batchIndent}};{%br%}
    """
        {{batchIndent}}SnowflakeResult =WslPythonSnowflake.RunSnowflakeRedSQL(sql,str(os.environ.get('WSL_TGT_DSN','')),str(os.environ.get('WSL_TGT_USER','')), str(os.environ.get('WSL_TGT_PWD','')),
        {{batchIndent}}' Failed  merge into table {{table.name}} step '+str(step) , '',step,connection)
        {{batchIndent}}mergeCount = mergeCount + SnowflakeResult[2]
        {{batchIndent}}status=SnowflakeResult[1]{%br%}
        {{batchIndent}}connection=SnowflakeResult[0]{%br%}
        {{batchIndent}}returnMsg = SnowflakeResult[2]{%br%}
        {{batchIndent}}{%br%}
        {{batchIndent}}if status<1:
            {{batchIndent}}scriptResultMessage = str(SnowflakeResult[3])
            {{batchIndent}}write_error(scriptResultMessage)
            {{batchIndent}}raise Exception(scriptResultMessage)
    {%- if settings.batchProcessingField != "" %}
    {%- endif %}{%br%}
    {%- endif %}

    if status==1:
    {%br%}
      {%- set dssFlag = false %}
      {%- from table.columns as currFlag where currFlag.currentFlag %}
        {%- set dssFlag = true %}
      {%- endfrom %}
         {{- addBatchLoopSelectClause("      ")}}
      {{batchIndent}}#--============================================================================{%br%}
      {{batchIndent}}#-- Refresh data{%br%}
      {{batchIndent}}#--============================================================================{%br%}{%br%}
     {{batchIndent}}step = {% counter %}00{%br%}{%br%}
     {{batchIndent}}sql = """
     {{batchIndent}}MERGE INTO [TABLEOWNER].[{{table.name}}]{%br%}
      {{batchIndent}}USING ({%br%}
      {#-                             -#}
      {#- V E R S I O N   1   R O W S -#}
      {#-                              #}
        {{batchIndent}}-- NEW BUSINESS KEY VALUES THAT WILL EACH CREATE A VERSION 1 ROW{%br%}
      {{- addNewRowSelect ( indent = "    " + batchIndent ) -}}
      {{- addFromClause ( indent = "    " + batchIndent ) -}}
      {{- addJoinToTarget ( joinType = "LEFT OUTER", indent = "    " + batchIndent ) -}}
      {{- addMaxKeyJoin ( indent = "    " + batchIndent ) -}}
      {{- addWhereClause ( indent = "    " + batchIndent ) -}}
      {%- if table.sourceJoinDetails.where | trim != "" %}{{batchIndent}}    AND {% else %}{{batchIndent}}    WHERE {% endif %}
      {%- from table.columns as bk where bk.businessKey -%}
        {%- if not loop.first -%}{{batchIndent}}    AND {% endif -%}
        {{- table.name}}.{{bk.name}} IS NULL{% br %}
      {%- endfrom %}
      {{- addBatchLoopWhereClause(dssFlag = dssFlag)}}
      {{- addGroupByClause ( indent = "    " + batchIndent ) -}}
      {#-                                 -#}
      {#- N E W   R O W   V E R S I O N S -#}
      {#-                                  #}
        {{batchIndent}}UNION ALL{% br %}
        {{batchIndent}}-- NEW VERSIONS OF EXISTING BUSINESS KEY ROWS{%br%}
      {{- addVersionedRowSelect ( indent = "    " + batchIndent ) -}}
      {{- addFromClause ( indent = "    " + batchIndent ) -}}
      {{- addJoinToTarget ( joinType = "INNER", indent = "    " + batchIndent ) -}}
      {{- addMaxKeyJoin ( indent = "    " + batchIndent ) -}}
      {{- addWhereClause ( indent = "    " + batchIndent ) -}}
      {%- if table.sourceJoinDetails.where | trim != "" %}{{batchIndent}}    AND {% else %}{{batchIndent}}    WHERE {% endif %}
      {%- from table.columns as currFlag where currFlag.currentFlag %}{{ table.name }}.{{ currFlag.name }} = 'Y'{% br %}{% endfrom %}
      {#- WHERE SLOWLY CHANGING ROWS HAVE CHANGED #}
      {{- addType2TrackedWhere ( indent = "    " + batchIndent, whereType = "AND", compareOperator = "<>", compareType = "OR ", nullSupport = settings.nullSupport ) }}
      {%- if dssDeleteTimePresent and dssDeleteFlagPresent -%}
        {{batchIndent}}    OR ( {{table.name}}.{{dssDeleteFlag}} = 'Y'{%  br -%}
        {{batchIndent}}      AND {{table.name}}.{{dssDeleteTime}} IS NOT NULL {%  br -%}
        {{batchIndent}}      AND {{table.name}}.dss_version = ( {%-  br -%}
        {{batchIndent}}        SELECT MAX( maxversion.dss_version ) {%-  br -%}
        {{batchIndent}}        FROM [TABLEOWNER].[{{table.name}}] AS maxversion {%-  br -%}
        {{batchIndent}}        {{addWhereJoinToTargetMaxVersion()}} )
        {{batchIndent}}    ){% br %}
      {%- endif -%}
      {{- addBatchLoopWhereClause(dssFlag = dssFlag)}}
      {{- addGroupByClause ( indent = "    " + batchIndent ) }}
      {#-                           -#}
      {#- E X P I R I N G   R O W S -#}
      {#-                            #}
        {{batchIndent}}UNION ALL{% br %}
        {{batchIndent}}-- CURRENT ROWS THAT NEED TO BE EXPIRED{%br%}
      {{- addType2ExpiringRowSelect ( indent = "    " + batchIndent ) -}}
      {{- addFromClause ( indent = "    " + batchIndent ) -}}
      {{- addJoinToTarget ( joinType = "INNER", indent = "    " + batchIndent ) -}}
      {{- addWhereClause ( indent = "    " + batchIndent ) -}}
      {#- WHERE CURRENT FLAG -#}
      {%- if table.sourceJoinDetails.where | trim != "" %}{{batchIndent}}    AND {% else %}{{batchIndent}}    WHERE {% endif -%}
      {%- from table.columns as column where column.currentFlag %}{{ table.name }}.{{ column.name }} = 'Y'{% br %}{% endfrom %}
      {#- WHERE SLOWLY CHANGING ROWS HAVE CHANGED #}
      {{- addType2TrackedWhere ( indent = "    " + batchIndent, whereType = "AND", compareOperator = "<>", compareType = "OR ", nullSupport = settings.nullSupport ) -}}
      {{- addBatchLoopWhereClause(dssFlag = dssFlag)}}
      {{- addGroupByClause ( indent = "    " + batchIndent ) }}
      {#-                         -#}
      {#- C H A N G E D   R O W S -#}
      {#-                         -#}
      {#- ARE THERE ANY UNTRACKED COLUMNS? -#}
      {%- set untracked = false -%}
      {%- from table.columns as untrackedCol where not ( untrackedCol.slowlyChanging or untrackedCol.businessKey or untrackedCol.dss or untrackedCol.artificial or untrackedCol.name == dssDeleteTime ) -%}
        {%- if loop.first -%}
          {%- set untracked = true -%}
        {%- endif -%}
      {%- endfrom -%}
      {%- if untracked %}
        {{batchIndent}}UNION ALL{% br %}
        {{batchIndent}}-- ROWS WHERE ONLY NON_TRACKED FIELDS HAVE CHANGED{%br%}
        {{- addChangedRowSelect ( indent = "    " + batchIndent ) -}}
        {{- addFromClause ( indent = "    " + batchIndent ) -}}
        {{- addJoinToTarget ( joinType = "INNER", indent = "    " + batchIndent ) -}}
        {{- addWhereClause ( indent = "    " + batchIndent ) -}}
        {#- WHERE CURRENT FLAG #}
        {%- if table.sourceJoinDetails.where | trim != "" %}{{batchIndent}}    AND {% else %}{{batchIndent}}    WHERE {% endif -%}
        {%- from table.columns as column where column.currentFlag %}
          {{- table.name }}.{{ column.name }} = 'Y'{% br %}
        {%- endfrom %}
        {#- WHERE SLOWLY CHANGING ROWS HAVE NOT CHANGED #}
        {{- addType2TrackedWhere ( indent = "    " + batchIndent, whereType = "AND", compareOperator = "=", compareType = "AND", nullSupport = settings.nullSupport ) -}}
        {#- WHERE UNTRACKED COLUMNS HAVE CHANGED #}
        {{- addType2UntrackedWhere ( indent = "    " + batchIndent, whereType = "AND", compareOperator = "<>", compareType = "OR ", nullSupport = settings.nullSupport ) -}}
       {{- addBatchLoopWhereClause(dssFlag = dssFlag)}}
        {{- addGroupByClause ( indent = "    " + batchIndent ) -}}
      {%- endif %}
      {{batchIndent}}) AS src{%br%}
      {{batchIndent}}{{addMergeJoinCondition(alias = "src", indent = batchIndent+"  ")}}
      {{batchIndent}}WHEN MATCHED THEN UPDATE{%br%}
      {{batchIndent}}SET{{- addMergeUpdateColumns(alias = "src", indent = batchIndent+"    ")}}
      {{batchIndent}}WHEN NOT MATCHED THEN INSERT{%br%}
      {{batchIndent}}{{addSetInsertTargetColumns(indent = batchIndent)}}
      {{batchIndent}}){%br%}
      {{batchIndent}}VALUES{%br%}
      {{batchIndent}}({{- addSetInsertColumnsSnowflake(addArtificialKey = true, alias = "src", indent = batchIndent+"  ", addColumnName = false, ignoreDssColumns = true)}}
      {{batchIndent}}){%br%}
      {{batchIndent}};{%br%}
    """

     {{batchIndent}}SnowflakeResult =WslPythonSnowflake.RunSnowflakeRedSQL(sql,str(os.environ.get('WSL_TGT_DSN','')),str(os.environ.get('WSL_TGT_USER','')), str(os.environ.get('WSL_TGT_PWD','')),
     {{batchIndent}}' Failed zero key merge into table {{table.name}} step '+str(step) , '',step,connection)
     {{batchIndent}}mergeCount = mergeCount + SnowflakeResult[2]
     {{batchIndent}}status=SnowflakeResult[1]{%br%}
     {{batchIndent}}connection=SnowflakeResult[0]{%br%}
     {{batchIndent}}returnMsg = SnowflakeResult[2]{%br%}
    {{batchIndent}}{%br%}
     {{batchIndent}}if status<1:
        {{batchIndent}}scriptResultMessage = str(SnowflakeResult[3])
        {{batchIndent}}write_error(scriptResultMessage)
        {{batchIndent}}raise Exception(scriptResultMessage)
    {%- if settings.batchProcessingField != "" %}
    {%- endif %}{%br%}

    {%- set dimKeypresent = "" %}
    {% from table.columns as column where column.artificial %}
        {% if loop.first %}{%br%}{%- set dimKeypresent = column.name %}{%- endif %}
    {%- endfrom %}
    {%- if dimKeypresent == ""  %}{%br%}
    if status==1:
        #--============================================================================{%br%}
        #-- UPDATE FLAG D TO N WHERE CURRENT FLAG IS 'Y' FOR STAFF_ID HAVING MAX_DSS_VERSION{%br%}
        #--============================================================================{%br%}{%br%}
        step = {% counter %}00{%br%}{%br%}
        sql = """
        UPDATE [TABLEOWNER].[{{table.name}}] AS T{%br%}
        SET
        {%-  from table.columns as column where column.currentFlag %}
        {{ column.name}} = 'N'{%br%}
        {%- endfrom %}
        WHERE
        {%-  from table.columns as column where column.currentFlag %}
        {{ column.name}} = 'D'{%br%}
        {%- endfrom %}
        AND EXISTS (
        SELECT 1
        FROM [TABLEOWNER].[{{table.name}}] AS S
        WHERE {%- from table.columns as column where column.businessKey -%} {%- if not loop.first %}{{batchIndent}}  AND {% else %} {% endif -%}{{batchIndent}} S.{{ column.name }} {{batchIndent}} =  T.{{ column.name }} {%- endfrom %}{%br%}
        AND {%- from table.columns as column where column.currentFlag -%}{{batchIndent}} S.{{ column.name }} {{batchIndent}} =  'Y' {%- endfrom %}{%br%}
        )
        ;{%br%}
    """
        SnowflakeResult =WslPythonSnowflake.RunSnowflakeRedSQL(sql,DSN,USER,PWD,'Failed truncating table {{table.name}} step '+str(step) , '',step,connection)
        returnMsg = str(SnowflakeResult[2]){%br%}
        status=SnowflakeResult[1]
        connection=SnowflakeResult[0]
        if status<1:
            returnMsg = str(SnowflakeResult[3])
            scriptResultMessage = str(SnowflakeResult[3])
            write_error(scriptResultMessage)
            raise Exception(scriptResultMessage)
        else:
            returnMsg += str(SnowflakeResult[2])
    {%- endif %}{%br%}

    {%- set dimKeypresent = "" %}
    {% from table.columns as column where column.artificial %}
        {% if loop.first %}{%br%}{%- set dimKeypresent = column.name %}{%- endif %}
    {%- endfrom %}
    {%- if dimKeypresent == ""  %}{%br%}
    if status==1:
             {{- addBatchLoopSelectClause("      ")}}{%br%}
        {{batchIndent}}#--============================================================================{%br%}
        {{batchIndent}}#--INSERT DELETED ROW AGAIN WHERE DATA IS SAME{%br%}
        {{batchIndent}}#--============================================================================{%br%}{%br%}
        {{batchIndent}}step = {% counter %}00{%br%}{%br%}
        {{batchIndent}}sql = """
        {{batchIndent}}MERGE INTO [TABLEOWNER].[{{table.name}}]{%br%}
        {{batchIndent}}USING ({%br%}
        {#-                                 -#}
        {#- I N S E R T  D E L E T E D  R E C O R D  W I T H  S A M E  D A T A  -#}
        {#-                                  #}
          {{batchIndent}}-- INSERT DELETED ROW AGAIAN WHERE DATA IS SAME{%br%}
        {{- addType2ExpiringRowSelect_InsertDeletedSameRowAgain ( indent = "    " + batchIndent ) -}}
        {{- addFromClause ( indent = "    " + batchIndent ) -}}
        {{- addJoinToTarget ( joinType = "FULL OUTER", indent = "    " + batchIndent ) -}}
        {{- addWhereClause ( indent = "    " + batchIndent ) -}}
        {#- WHERE CURRENT FLAG -#}
        {%- if table.sourceJoinDetails.where | trim != "" %}{{batchIndent}}    AND {% else %}{{batchIndent}}    WHERE {% endif -%}
        {%- from table.columns as column where column.currentFlag %}{{ table.name }}.{{ column.name }} = 'D'{% br %}{% endfrom %}
        {#- WHERE STAFF ID IS NOT NULL #}
        {%- from table.columns as bk where bk.businessKey -%}
          {{batchIndent}}    AND {{batchIndent}}
          {{- bk.source}} IS NOT NULL{% br %}
        {%- endfrom %}
        {#- WHERE SLOWLY CHANGING ROWS HAVE NOT CHANGED #}
        {{- addType2TrackedWhere ( indent = "    " + batchIndent, whereType = "AND", compareOperator = "=", compareType = "AND", nullSupport = settings.nullSupport ) -}}
        {#- WHERE UNTRACKED COLUMNS HAVE NOT CHANGED #}
        {{- addType2UntrackedWhere ( indent = "    " + batchIndent, whereType = "AND", compareOperator = "=", compareType = "AND ", nullSupport = settings.nullSupport ) -}}
        {{- addBatchLoopWhereClause(dssFlag = dssFlag)}}
        {{- addGroupByClause ( indent = "    " + batchIndent ) -}}
            ) ranked{%br%}
          WHERE ranked.rn = 1 {%br%}
        {{batchIndent}}
        {#-                                 -#}
        {#- I N S E R T  D E L E T E D  R E C O R D  W I T H  D I F F E R E N T  D A T A  -#}
        {#-                                  #}
          {{batchIndent}}UNION ALL{% br %}
          {{batchIndent}}-- INSERT DELETED ROW AGAIAN WHERE DATA IS DIFFERENT{%br%}
        {{- addType2ExpiringRowSelect_InsertDeletedDifferentRowAgain ( indent = "    " + batchIndent ) -}}
        {{- addFromClause ( indent = "    " + batchIndent ) -}}
        {{- addJoinToTarget ( joinType = "INNER", indent = "    " + batchIndent ) -}}
        {{- addWhereClause ( indent = "    " + batchIndent ) -}}
        {#- WHERE CURRENT FLAG -#}
        {%- if table.sourceJoinDetails.where | trim != "" %}{{batchIndent}}    AND {% else %}{{batchIndent}}    WHERE {% endif -%}
        {%- from table.columns as column where column.currentFlag %}{{ table.name }}.{{ column.name }} = 'D'{% br %}{% endfrom %}
        {#- WHERE STAFF ID IS NOT NULL #}
        {%- from table.columns as bk where bk.businessKey -%}
          {{batchIndent}}    AND {{batchIndent}}
          {{- bk.source}} IS NOT NULL{% br %}
        {%- endfrom %}
        {#- WHERE SLOWLY CHANGING ROWS  CHANGED #}
        {{- addType2TrackedWhere ( indent = "    " + batchIndent, whereType = "AND", compareOperator = "<>", compareType = "AND", nullSupport = settings.nullSupport ) -}}
        {#- WHERE UNTRACKED COLUMNS  CHANGED #}
        {{- addType2UntrackedWhere ( indent = "    " + batchIndent, whereType = "OR", compareOperator = "<>", compareType = "OR ", nullSupport = settings.nullSupport ) -}}
        {{- addBatchLoopWhereClause(dssFlag = dssFlag)}}
        {{- addGroupByClause ( indent = "    " + batchIndent ) -}}
            ) ranked{%br%}
          WHERE ranked.rn = 1 {%br%}
        {{batchIndent}}  ) AS src{%br%}
        {{batchIndent}}{{addMergeJoinCondition(alias = "src", indent = batchIndent+"  ")}}
        {{batchIndent}}WHEN MATCHED THEN UPDATE{%br%}
        {{batchIndent}}SET{{- addMergeUpdateColumns(alias = "src", indent = batchIndent+"    ")}}
        {{batchIndent}}WHEN NOT MATCHED THEN INSERT{%br%}
        {{batchIndent}}{{addSetInsertTargetColumns(indent = batchIndent)}}
        {{batchIndent}}){%br%}
        {{batchIndent}}VALUES{%br%}
        {{batchIndent}}({{- addSetInsertColumnsSnowflake(addArtificialKey = true, alias = "src", indent = batchIndent+"  ", addColumnName = false, ignoreDssColumns = true)}}
        {{batchIndent}}){%br%}
        {{batchIndent}};{%br%}
      """

        {{batchIndent}}SnowflakeResult =WslPythonSnowflake.RunSnowflakeRedSQL(sql,str(os.environ.get('WSL_TGT_DSN','')),str(os.environ.get('WSL_TGT_USER','')), str(os.environ.get('WSL_TGT_PWD','')),
        {{batchIndent}}' Failed  merge into table {{table.name}} step '+str(step) , '',step,connection)
        {{batchIndent}}mergeCount = mergeCount + SnowflakeResult[2]
        {{batchIndent}}status=SnowflakeResult[1]{%br%}
        {{batchIndent}}connection=SnowflakeResult[0]{%br%}
        {{batchIndent}}returnMsg = SnowflakeResult[2]{%br%}
        {{batchIndent}}{%br%}
        {{batchIndent}}if status<1:
            {{batchIndent}}scriptResultMessage = str(SnowflakeResult[3])
            {{batchIndent}}write_error(scriptResultMessage)
            {{batchIndent}}raise Exception(scriptResultMessage)
        {%- if settings.batchProcessingField != "" %}
        {%- endif %}
    {%- endif %}{%br%}

    {%- set dimKeypresent = "" %}
    {% from table.columns as column where column.artificial %}
        {% if loop.first %}{%br%}{%- set dimKeypresent = column.name %}{%- endif %}
    {%- endfrom %}
    {%- if dimKeypresent == ""  %}{%br%}
    if status==1:
        #--============================================================================{%br%}
        #-- CONVERT FLAG D TO N{%br%}
        #--============================================================================{%br%}{%br%}
        step = {% counter %}00{%br%}{%br%}
        sql = """
        UPDATE [TABLEOWNER].[{{table.name}}]{%br%}
        SET
        {%-  from table.columns as column where column.dssEndDate %}
        {{ column.name}} = {{settings.changeDetectionEndExpiring}}{%br%}
          {%- endfrom %}
        {%-  from table.columns as column where column.currentFlag %}
             , {{ column.name}} = 'N'{%br%}
        {%- endfrom %}
        WHERE  {%br%}
        {%-  from table.columns as column where column.currentFlag %}
              {{ column.name}} = 'D'{%br%}
        {%- endfrom %}
        ;{%br%}
    """
        SnowflakeResult =WslPythonSnowflake.RunSnowflakeRedSQL(sql,DSN,USER,PWD,'Failed truncating table {{table.name}} step '+str(step) , '',step,connection)
        returnMsg = str(SnowflakeResult[2]){%br%}
        status=SnowflakeResult[1]
        connection=SnowflakeResult[0]
        if status<1:
            returnMsg = str(SnowflakeResult[3])
            scriptResultMessage = str(SnowflakeResult[3])
            write_error(scriptResultMessage)
            raise Exception(scriptResultMessage)
        else:
            returnMsg += str(SnowflakeResult[2])
    {%- endif %}{%br%}

    #--====================================================={%br%}
    #-- All Done report the results{%br%}
    #--====================================================={%br%}{%br%}
    step = {% counter %}00{%br%}{%br%}
    #-- WsWrkTask call to updated row counts in Ws_Wrk_Task_Run/Log{%br%}
    {%- if settings.deleteBeforeInsert and not settings.deleteBeforeInsertTruncate %}
    metaResult=WslPythonCommon.WsWrkTask(0,0,0,mergeCount,deleteCount,0,0){%br%}
    {%- else %}
    metaResult=WslPythonCommon.WsWrkTask(0,0,0,mergeCount,0,0,0){%br%}
    {%- endif %}
    if int(metaResult) < -1:
       status=-2{%br%}
       returnMsg = "Failure executing WsWrkTask. "+ str(insertCount)+" records merged."{%br%}
       scriptResultMessage = "Failure executing WsWrkTask. "+ str(insertCount)+" records merged."{%br%}
       write_error(scriptResultMessage)

    #-- Work out return message{%br%}
    if status==1:
    {%br%}
      returnMsg = "{{table.name}} updated.  "{%br%}
      returnMsg +=str(mergeCount) + " records merged.  " {%br%}
      {%- if dssDeleteTimePresent or dssDeleteFlagPresent %}
      returnMsg += str(logicalDeleteCount)+" records logically deleted.  "{%br%}
      {%- endif %}
      {%- if settings.deleteBeforeInsert and not settings.deleteBeforeInsertTruncate %}
      returnMsg +=str(deleteCount) + " records deleted.  "{%br%}
      {%- endif %}
    scriptResultMessage = returnMsg {%br%}
    write_audit(scriptResultMessage)
except Exception as e: {%- br %}
    connection.commit(){%br%}
    connection.close(){%br%}
    write_error("Script Failed:" + str(e))
    write_error(traceback.format_exc())
    exitCode = 2
    exitMessage = 'Script run failed'
{%- br %}
else: {%- br %}
    exitCode = 0
    exitMessage = 'Script ran successfully'
{%- br %}
finally: {%- br %}
    connection.commit(){%br%}
    connection.close(){%br%}
    exit_script(exitCode, exitMessage)
{%- br %}
