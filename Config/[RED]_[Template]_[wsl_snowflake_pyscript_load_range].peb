interactiveThreadLog = None
def write_thread_audit(message = '', logType = 'audit', statusCode = 'I'):{%br%}
    # statusCodes 'E' = error, 'W' Warning, 'I' information, 'S' Success
    global interactiveThreadLog
    if is_red_interactive():{%br%}
        #message = ' : '.join([logType,statusCode,message])
        interactiveThreadLog = '\n'.join([interactiveThreadLog, message])
    else:{%br%}
        outputJson = json.dumps({"type": logType, "message": message, "statusCode": statusCode})
        print(outputJson, flush=True)
{%br%}
def write_thread_error(message = ''):{%br%}
    write_thread_audit(message, 'audit', 'E')
{%br%}

def thread_print_log(exitCode = 0, message = 'Executed the script'):{%br%}
    if is_red_interactive():{%br%}
        if exitCode != 0:{%br%}
            print(-2, flush=True)
        else:{%br%}
            print(1, flush=True)
        print(message, flush=True)
        print(interactiveThreadLog, flush=True)
    else:{%br%}
        if exitCode != 0:{%br%}
            write_result(message,'E')
        else:{%br%}
            write_result(message,'S')
{%br%}
{%- br %}

#--============================================================================
#-- Define Important Functions
#--============================================================================
def executeSnowflakeQuery(query, uidSF=str(os.environ.get('WSL_TGT_USER','')), pwdSF=str(os.environ.get('WSL_TGT_PWD','')), dsnSF=str(os.environ.get('WSL_TGT_DSN','')), exitOnError=True):
    try:
        if os.environ.get("WSL_TGT_CONSTRING") != "":
            SFConnectionString = os.environ.get('WSL_TGT_CONSTRING','')
        else:
            uid = uidSF
            pwd = pwdSF
            SFConnectionString = "DSN=" + dsnSF
            if uid and not uid.isspace():
                SFConnectionString += ";UID="+uid
            if pwd and not pwd.isspace():
                SFConnectionString += ";PWD="+pwd
        SFConnectionString = WslPythonSnowflake.addapplicationid(SFConnectionString)
        SFConnection = pyodbc.connect(SFConnectionString, autocommit=True)
        SFconn = SFConnection.cursor()
        query_tag = WslPythonCommon.GetExtendedProperty("SF_QUERY_TAG", str(os.environ.get('WSL_LOAD_TABLE',''))).strip()
        if query_tag and query_tag.strip():
            query_sql = f"ALTER SESSION SET QUERY_TAG = '{query_tag}'"
            SFconn.execute(query_sql)
        # Check if the query starts with a SELECT statement
        if query.strip().upper().startswith("SELECT"):
            sfResult = SFconn.execute(query).fetchall()
            numberOfRows = len(sfResult)  # Get the number of rows fetched
        elif query.strip().upper().startswith("COPY"):
            sfResult = SFconn.execute(query).fetchall()
            numberOfRows = SFconn.rowcount
        else:
            # For non-SELECT statements
            SFconn.execute(query)
            numberOfRows = SFconn.rowcount  # Get the number of rows affected
            sfResult = None  # No result set to fetch for non-SELECT queries

        SFconn.close()
        SFConnection.close()
        return sfResult, numberOfRows  # Return both the result set (or None) and the row count
    except Exception as exceptionError:
        if exitOnError:
            write_error("Error in executeSnowflakeQuery: " + str(exceptionError))
            exit_script(2)
        else:
            raise exceptionError

{% if PilotTable != "" %}
def getBatches():
    try:
        batchSQL = f"""SELECT BATCH_NUMBER
        , MIN_VALUE
        , MAX_VALUE
        FROM {tableProperties["RANGE_SCHEMA"]}.{extendedProperty["PILOT_TABLE"]}
        WHERE status IN ('N','R')
        ORDER BY batch_number"""

        batchList, numberOfRows = executeSnowflakeQuery(batchSQL)

        if numberOfRows == 0:
            write_audit("Batch table is empty or all batches are marked as completed", statusCode ="W")
        else:
            return batchList, numberOfRows
    except Exception as exceptionError:
        raise Exception("Error in getBatches: " + str(exceptionError))


def checkDuplicateBatches():
    try:
        duplicateBatchSQL = f"""SELECT BATCH_NUMBER, COUNT(*) AS DUPLICATE_COUNT
        FROM {tableProperties["RANGE_SCHEMA"]}.{extendedProperty["PILOT_TABLE"]}
        WHERE STATUS IN ('N', 'R')
        GROUP BY BATCH_NUMBER
        HAVING COUNT(*) > 1"""

        duplicateBatchList, numberOfRows = executeSnowflakeQuery(duplicateBatchSQL)

        if numberOfRows != 0:
            raise Exception(f"Found '{numberOfRows}' duplicate batches in Range Table")
        else:
            return numberOfRows
    except Exception as exceptionError:
        raise Exception("Error in checkDuplicateBatches: " + str(exceptionError))

