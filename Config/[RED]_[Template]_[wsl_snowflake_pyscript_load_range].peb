tableProperties = {}

# IMP: Below properties are specific for SNOWFLAKE as RED10 only supports RANGE TABLE on SNOWFLAKE for now
# The properties will require changes when RANGE TABLE support is added for PostgreSQL for RED10

# Set Table Properties
tableProperties["RANGE_SCHEMA"] = os.environ.get('WSL_LOAD_SCHEMA','')
tableProperties["RANGE_CURR_DATE"] = "CAST(CURRENT_TIMESTAMP AS TIMESTAMP)"
tableProperties["EXTRACT_SECS"] = "TIMESTAMPDIFF('SECOND',START_EXTRACT_TIMESTAMP,CAST(CURRENT_TIMESTAMP AS TIMESTAMP))"
tableProperties["PUT_SECS"] = "TIMESTAMPDIFF('SECOND',START_PUT_TIMESTAMP,CAST(CURRENT_TIMESTAMP AS TIMESTAMP))"
tableProperties["LOAD_SECS"] = "TIMESTAMPDIFF('SECOND',START_LOAD_TIMESTAMP,CAST(CURRENT_TIMESTAMP AS TIMESTAMP))"
tableProperties["TOTAL_SECS"] = "TIMESTAMPDIFF('SECOND',START_EXTRACT_TIMESTAMP,CAST(CURRENT_TIMESTAMP AS TIMESTAMP))"
tableProperties["rangeTableDsn"] = os.environ.get('WSL_TGT_DSN','')
tableProperties["rangeTableUser"] = os.environ.get('WSL_TGT_USER','')
tableProperties["rangeTablePwd"] = os.environ.get('WSL_TGT_PWD','')


# Set Thread Properties
tableProperties["THREAD_COUNT"] = extendedProperty['THREAD_COUNT']
tableProperties["THREAD_ERRORS"] = extendedProperty["THREAD_ERRORS"]
tableProperties["THREAD_FAIL_ACTION"] = extendedProperty["THREAD_FAIL_ACTION"]

# Set Result Properties per batch
tableProperties["TOTAL_ROWS_LOADED"] = 0
tableProperties["BATCH_RESULT"] = []

{% if PilotTable != "" %}
# IMP: This function will be used only for PARALLEL LOADING of Main Load Table (not for Range Table)
# DO NOT USE THIS FUNCTION FOR RANGE TABLE
def parallelLoad(batch, thread_id):

    global interactiveThreadLog
    interactiveThreadLog= ""

    # Here, batch means a single row from the Range Table which is being processed by a single thread (thread_id)
    # The batch is a tuple with 3 elements: (batch_number, min_value, max_value)
    batch_id = batch[0]
    min_value = batch[1]
    max_value = batch[2]

    # Log Batch and Thread Details
    write_thread_audit("-------------------------------------------------------------")
    write_thread_audit("Processing - Batch: " + str(batch_id) + " | Thread: " + str(thread_id))
    write_thread_audit("-------------------------------------------------------------")

    try:
        batchStatusSQL = f"""SELECT STATUS
        FROM {tableProperties["RANGE_SCHEMA"]}.{extendedProperty["PILOT_TABLE"]}
        WHERE BATCH_NUMBER = {str(batch_id)}"""

        batchStatus, numberOfRows = executeSnowflakeQuery(batchStatusSQL)

        if numberOfRows == 0:
            thread_print_log(2,f"Batch {batch_id} not found in Range Table")
            if is_red_interactive():
                sys.exit(0)
            else:
                sys.exit(2)
#            threadLogger.errorLog(f"Batch {batch_id} not found in Range Table")
        elif batchStatus[0][0] == "P":
            write_thread_audit(f"Batch '{batch_id}' is Paused. Skipping...")
            thread_print_log(2,f"Batch '{batch_id}' is Paused. Skipping...")
#            threadLogger._printLog()
            tableProperties["BATCH_RESULT"].append((batch_id, 0, "PAUSED"))
            return
        elif batchStatus[0][0] == "C":
            write_thread_audit(f"Batch '{batch_id}' is already Completed. Skipping...")
            tableProperties["BATCH_RESULT"].append((batch_id, 0, "ALREADY COMPLETED"))
            thread_print_log(f"Batch '{batch_id}' is already Completed. Skipping...")
            return
        else:
            if batchStatus[0][0] == "N":
                write_thread_audit(f"Now loading batch: {batch_id}")

        # Update Range Table with Thread ID and Start Time
        batchUpdateSql = f"""UPDATE {tableProperties["RANGE_SCHEMA"]}.{extendedProperty["PILOT_TABLE"]}
        SET STATUS = 'R'
        , THREAD_NUMBER = {str(thread_id)}
        , START_EXTRACT_TIMESTAMP = {tableProperties["RANGE_CURR_DATE"]}
        WHERE BATCH_NUMBER = {str(batch_id)}
        """

        batchUpdateResult, numberOfRows = executeSnowflakeQuery(batchUpdateSql)

        fileDat = f"wsl_{str(os.environ.get('WSL_LOAD_TABLE',''))}_{str(os.environ.get('WSL_SEQUENCE',''))}_BATCH_{str(batch_id)}_THREAD_{str(thread_id)}"

        # Initiate Extract
        extractSQL = """
        SELECT {%- from table.columns as column %}
        {%- if not loop.first %}                                      ,{% endif %}
        {%- if column.datatype == "varchar" or column.datatype == "char"  %}{% endif %}
        {%- if column.transform | trim == "" or column.transformType.code == "A" %}
        {%- if column.sourceTable.name is defined and column.sourceColumn.name is defined %} {{ column.sourceTable.name }}.{{ column.sourceColumn.name }}
        {%- elseif column.source is defined and column.transformType.code != "A" %} {{column.source}}
        {%- else %} ' '
        {%- endif %}
        {%- elseif column.transformType.code != "A" %} {{ column.transform }}
        {%- else %} ' '
        {%- endif %}
        {%- if column.datatype == "varchar" or column.datatype == "char"  %}{% endif %}{% br %}
        {%- endfrom %}
        {%- if table.loadInfo.sourceTables != "" %}
        FROM """+os.environ.get('WSL_SRC_SCHEMA','')+""".{{ table.loadInfo.sourceTables }}{%- br -%}
        {%- endif -%}
        {%- from table.loadInfo.whereAndGroupByClauses | trim | lines as whereLine %}                       {{whereLine}}{% br %}{% endfrom -%}
        """

        if min_value != "NULL" and max_value == "NULL":
            extractSQL = extractSQL + {% if table.loadInfo.whereAndGroupByClauses == "" %}" WHERE """{% else %}"AND"{% endif %}+ extendedProperty["BATCH_OVERRIDE"]+""" > """+str(min_value){% br %}
        elif min_value != "NULL":
            extractSQL = extractSQL + {% if table.loadInfo.whereAndGroupByClauses == "" %}" WHERE """{% else %}"AND"{% endif %}+ extendedProperty["BATCH_EXPRESSION"]+""" BETWEEN """+str(min_value)+" AND "+ str(max_value){% br %}
        else:
            extractSQL = extractSQL + {% if table.loadInfo.whereAndGroupByClauses == "" %}" WHERE """{% else %}"AND"{% endif %}+ extendedProperty["BATCH_EXPRESSION"]+""" IS NULL"""{% br %}

        write_thread_audit("================== EXTRACT SQL STATEMENT ==================")
        write_thread_audit(extractSQL)
        write_thread_audit("")

        # Execute Extract
        extract_unicode = False
        if extendedProperty["EXTRACT_CHAR_SET"].find("UTF") != -1:
            extract_unicode = True

        write_thread_audit("BEGIN create of data file from source system: " + str(datetime.now()))

        # Create a directory for the data file
        dirName = f"wsl_{str(os.environ.get('WSL_LOAD_TABLE',''))}_{str(os.environ.get('WSL_SEQUENCE',''))}_DATA_FILES"

        try:
            os.mkdir(os.path.join(os.environ.get('WSL_WORKDIR',''), dirName))
        except FileExistsError:
            pass

        fileDatFullPath = os.path.join(os.environ.get('WSL_WORKDIR',''), dirName, fileDat)
        try:
            rowCount = WslPythonCommon.GetDataToFile(extractSQL,str(os.environ.get('WSL_SRC_DSN','')),str(os.environ.get('WSL_SRC_USER','')),str(os.environ.get('WSL_SRC_PWD','')),fileDatFullPath, extendedProperty['UNLOAD_DELIM'], 0, 0, True, extract_unicode, extendedProperty["UNLOAD_ENCLOSED"], extendedProperty['UNLOAD_ESCAPE'])

            write_thread_audit("END create of data file from source system: " + str(datetime.now()))

        except Exception as exceptionError:
            thread_print_log(2,"Error in GetDataToFile: " + str(exceptionError))
            if is_red_interactive():
                sys.exit(0)
            else:
                sys.exit(2)

        # Update Range Table with Extract Time
        batchUpdateSql = f"""UPDATE {tableProperties["RANGE_SCHEMA"]}.{extendedProperty["PILOT_TABLE"]}
        SET START_PUT_TIMESTAMP = {tableProperties["RANGE_CURR_DATE"]},
        EXTRACT_DURATION_SECONDS = {tableProperties["EXTRACT_SECS"]}
        WHERE BATCH_NUMBER = {str(batch_id)}
        """

        batchUpdateResult, numberOfRows = executeSnowflakeQuery(batchUpdateSql)

        # Initiate Data File Compression (if enabled)
        if extendedProperty["UNLOAD_GZIP"] == "TRUE":
            try:
                write_thread_audit("BEGIN gzip of data file: " + str(datetime.now()))

                if extendedProperty["DEBUG"].upper() == "TRUE":
                    output_file_path = WslPythonCommon.gzip_file(
                        fileDatFullPath+".txt",
                        fileDatFullPath+".gz",
                        False
                    )
                else:
                    output_file_path = WslPythonCommon.gzip_file(
                        fileDatFullPath+".txt",
                        fileDatFullPath+".gz",
                        True
                    )

                write_thread_audit("=============== DATA FILE COMPRESSION ===============")
                write_thread_audit("Original File: " + fileDatFullPath+".txt")
                write_thread_audit("Data File Gzipped To: " + output_file_path)
                if extendedProperty["DEBUG"].upper() == "TRUE":
                    compression_ratio = os.path.getsize(fileDatFullPath+".txt")/os.path.getsize(fileDatFullPath+".gz")
                    write_thread_audit("Compression Ratio: " + "{:.3f}".format(compression_ratio))
                write_thread_audit("=====================================================")

                fileDatFullPath = output_file_path

                write_thread_audit("END gzip of data file: " + str(datetime.now()))
            except Exception as exceptionError:
                write_thread_audit("Error in GzipFile: " + str(exceptionError))
                if is_red_interactive():
                    sys.exit(0)
                else:
                    sys.exit(2)


        # Initiate File Upload to Snowflake
        write_thread_audit("=================== FILE UPLOAD ===================")
        stage_name = "WSL-"+os.environ.get('WSL_LOAD_TABLE','')+"_"+os.environ.get('WSL_SEQUENCE','')+"_BATCH_"+str(batch_id)+"_THREAD_"+str(thread_id)

        # Clear Snowflake Stage
        clearStageSQL = "REMOVE @~/"+stage_name+"/*"
        write_thread_audit("Clearing Snowflake Stage: " + clearStageSQL)
        clearStageResult, numberOfRows = executeSnowflakeQuery(clearStageSQL)

        # Upload File to Snowflake Stage
        write_thread_audit("BEGIN upload of data file to Snowflake stage: " + str(datetime.now()))
        putFileSQL = "PUT file://"+fileDatFullPath+"* @~/"+stage_name+"/"
        write_thread_audit("Uploading File to Snowflake Stage: " + putFileSQL)

        current_retries = 0
        max_retries = extendedProperty["MAX_RETRIES"]
        numberOfRows = 0

        while numberOfRows != 1 and int(current_retries) < int(max_retries):
            current_retries += 1
            write_thread_audit("Current retries: " + str(current_retries) + " of " + str(max_retries))

            retryUpdateSQL = f"""UPDATE {tableProperties["RANGE_SCHEMA"]}.{extendedProperty["PILOT_TABLE"]}
            SET RETRY_COUNT = {str(current_retries)}
            WHERE BATCH_NUMBER = {str(batch_id)}"""

            retryUpdateResult, retryUpdateNumberOfRows = executeSnowflakeQuery(retryUpdateSQL)

            try:
                putFileResult, numberOfRows = executeSnowflakeQuery(putFileSQL, exitOnError=False)
            except Exception as e:
                numberOfRows = 0
                write_thread_audit("Failed to upload file to stage. Retrying...")

        if numberOfRows != 1 and int(current_retries) >= int(max_retries):
            thread_print_log(2,"Data file upload failed. Retry limit exhausted. Aborting thread")
            # Exit Thread
            if is_red_interactive():
                sys.exit(0)
            else:
                sys.exit(2)
            return

        if numberOfRows == 1:
            write_thread_audit("Data file uploaded successfully to stage in retry: " + str(current_retries))

        # Update Range Table with Put Time
        batchUpdateSql = f"""UPDATE {tableProperties["RANGE_SCHEMA"]}.{extendedProperty["PILOT_TABLE"]}
        SET START_LOAD_TIMESTAMP = {tableProperties["RANGE_CURR_DATE"]},
        PUT_DURATION_SECONDS = {tableProperties["PUT_SECS"]}
        WHERE BATCH_NUMBER = {str(batch_id)}
        """

        batchUpdateResult, numberOfRows = executeSnowflakeQuery(batchUpdateSql)

        write_thread_audit("END upload of data file to Snowflake stage: " + str(datetime.now()))

        # Initiate COPY INTO command
        write_thread_audit("=================== COPY INTO ===================")

        PURGE = "TRUE"
        if extendedProperty["PURGE"].upper() == "FALSE":
            PURGE = "FALSE"

        {%- set crLfList = crLfReplaced.split(",") %}{% br %}
        copyStmt = """COPY INTO """+ os.environ.get('WSL_LOAD_FULLNAME','')+"""
        FROM ({%- br %}{% set csvPos = 0 %}
        SELECT {% for col in table.columns %}
                {%- if not loop.first %}           , {% endif %}
                {%- if crLfList contains col.name %}REPLACE(REPLACE({%- endif %}
                {%- if col.transformType.code == "A" %}{{ col.source }}
                {%- else %}
                    {%- set csvPos = csvPos + 1 %}t.${{ csvPos }}
                {%- endif %}
                {%- if crLfList contains col.name %},'~~0A~~',CHAR(10)),'~~0D~~',CHAR(13)){%- endif %}
                {%- br %}
                {%- endfor %}
        FROM @~/"""+stage_name+""" t
        ){% br %}
        PATTERN = '.*'{%- br %}
        FILE_FORMAT = """+extendedProperty["FILE_FORMAT_FULL_NAME"]+"""
        PURGE = """+PURGE{% br %}

        {%- if table.loadInfo.fileLoaderOptions != "" %}    {{ table.loadInfo.fileLoaderOptions }}{%- br %}
        {%- endif %}

        write_thread_audit("================== COPY INTO STATEMENT ==================")
        write_thread_audit(copyStmt)
        write_thread_audit("")

        # Execute COPY INTO command
        write_thread_audit("BEGIN copy into: " + str(datetime.now()))
        copyIntoResult, copyIntoNumberOfRows = executeSnowflakeQuery(copyStmt)

        totalRowsLoaded = 0
        checkFlag = 0

        if copyIntoNumberOfRows > 0:
            write_thread_audit("File                                            "+"Status         "+"Rows Parsed        "+"Rows Loaded  ")
            write_thread_audit("=========================================================================================================")
            for i in range(0, copyIntoNumberOfRows):
                fileName = str(copyIntoResult[i][0]).split("/")[-1]
                copyIntoStatus = str(copyIntoResult[i][1])
                copyRowsParsed = str(copyIntoResult[i][2])
                copyRowsLoaded = str(copyIntoResult[i][3])
                copyErrorSeen = int(copyIntoResult[i][5])

                write_thread_audit(fileName + " "*(48-len(fileName)) + copyIntoStatus + " "*(15-len(copyIntoStatus)) + copyRowsParsed + " "*(20-len(copyRowsParsed)) + copyRowsLoaded)

                if copyErrorSeen == 0:
                    totalRowsLoaded += int(copyRowsLoaded)
                    tableProperties["TOTAL_ROWS_LOADED"] += int(copyRowsLoaded)
                    tableProperties["BATCH_RESULT"].append((batch_id, copyRowsLoaded, "SUCCESS"))
                else:
                    checkFlag = 1
                    tableProperties["BATCH_RESULT"].append((batch_id, copyRowsLoaded, "FAILED"))

        if checkFlag == 0:
            write_thread_audit("Total Rows Loaded: " + str(totalRowsLoaded))
            write_thread_audit("Load Completed Successfully")
            try:
                #-- WsWrkTask call to updated row counts in Ws_Wrk_Task_Run/Log{%- br %}
                metaResult = WslPythonCommon.WsWrkTask(0,0,0,totalRowsLoaded,0,0,0)
            except:
                write_thread_audit("Failed to update task row count")
        else:
            thread_print_log(2,"Load Completed with Errors\nTotal Rows Loaded: " + str(totalRowsLoaded))
            if is_red_interactive():
                sys.exit(0)
            else:
                sys.exit(2)

        write_thread_audit("END copy into: " + str(datetime.now()))

        # Update Range Table with Load Time
        batchUpdateSql = f"""UPDATE {tableProperties["RANGE_SCHEMA"]}.{extendedProperty["PILOT_TABLE"]}
        SET STATUS = 'C',
        END_TIMESTAMP = {tableProperties["RANGE_CURR_DATE"]},
        LOADED_ROWS = {str(totalRowsLoaded)},
        LOAD_DURATION_SECONDS = {tableProperties["LOAD_SECS"]},
        TOTAL_DURATION_SECONDS = {tableProperties["TOTAL_SECS"]},
        ROWS_VALIDATED = CASE WHEN ROW_COUNTER = -1 THEN 'X' WHEN ROW_COUNTER = {str(totalRowsLoaded)} THEN 'Y' ELSE 'N' END
        WHERE BATCH_NUMBER = {str(batch_id)}
        """

        batchUpdateResult, batchUpdateNumberOfRows = executeSnowflakeQuery(batchUpdateSql)

        # Delete Data File
        if extendedProperty["DEBUG"].upper() == "FALSE":
            try:
                os.remove(fileDatFullPath+".txt")
            except Exception as exceptionError:
                write_thread_error("Error in deleting data file: " + str(exceptionError))

            clearStageResult, numberOfRows = executeSnowflakeQuery(clearStageSQL)
        else:
            write_thread_audit("Debug Mode is enabled. Temporary data file not deleted")

        thread_print_log()
    except Exception as exceptionError:
        thread_print_log(2,"Error in parallelLoad: " + str(exceptionError))
        if is_red_interactive():
            sys.exit(0)
        else:
            sys.exit(2)

{% endif %}

{% if PilotTable == "" %}
def loadRangeTable():

    # Initiate Extract
    write_audit("================== EXTRACT SQL STATEMENT ==================")

    # Extract SQL
    extractSQL = """
        SELECT {%- from table.columns as column %}
        {%- if not loop.first %}                                      ,{% endif %}
        {%- if column.datatype == "varchar" or column.datatype == "char"  %}{% endif %}
        {%- if column.transform | trim == "" or column.transformType.code == "A" %}
        {%- if column.sourceTable.name is defined and column.sourceColumn.name is defined %} {{ column.sourceTable.name }}.{{ column.sourceColumn.name }}
        {%- elseif column.source is defined and column.transformType.code != "A" %} {{column.source}}
        {%- else %} ' '
        {%- endif %}
        {%- elseif column.transformType.code != "A" %} {{ column.transform }}
        {%- else %} ' '
        {%- endif %}
        {%- if column.datatype == "varchar" or column.datatype == "char"  %}{% endif %}{% br %}
        {%- endfrom %}
        {%- if table.loadInfo.sourceTables != "" %}
        FROM """+os.environ.get('WSL_SRC_SCHEMA','')+""".{{ table.loadInfo.sourceTables }}{%- br -%}
        {%- endif -%}
        {%- from table.loadInfo.whereAndGroupByClauses | trim | lines as whereLine %}                       {{whereLine}}{% br %}{% endfrom -%}
        """

    # Execute Extract
    extract_unicode = False
    if extendedProperty["EXTRACT_CHAR_SET"].find("UTF") != -1:
        extract_unicode = True

    write_audit("BEGIN create of data file from source system: " + str(datetime.now()))
    write_audit(extractSQL)

    # Create a directory for the data file
    dirName = f"wsl_{str(os.environ.get('WSL_LOAD_TABLE',''))}_{str(os.environ.get('WSL_SEQUENCE',''))}_RANGE_DATA_FILE"

    try:
        os.mkdir(os.path.join(os.environ.get('WSL_WORKDIR',''), dirName))
    except FileExistsError:
        pass

    fileDat = f"wsl_{str(os.environ.get('WSL_LOAD_TABLE',''))}_{str(os.environ.get('WSL_SEQUENCE',''))}_RANGE_DATA_FILE"
    fileDatFullPath = os.path.join(os.environ.get('WSL_WORKDIR',''), dirName, fileDat)

    try:
        rowCount = WslPythonCommon.GetDataToFile(extractSQL,str(os.environ.get('WSL_SRC_DSN','')),str(os.environ.get('WSL_SRC_USER','')),str(os.environ.get('WSL_SRC_PWD','')),fileDatFullPath, extendedProperty['UNLOAD_DELIM'], 0, 0, True, extract_unicode, extendedProperty["UNLOAD_ENCLOSED"], extendedProperty['UNLOAD_ESCAPE'])
        write_audit("END create of data file from source system: " + str(datetime.now()))
    except Exception as exceptionError:
        raise Exception("Error in GetDataToFile: " + str(exceptionError))

    # Initiate Data File Compression (if enabled)
    if extendedProperty["UNLOAD_GZIP"] == "TRUE":
        try:
                write_audit("BEGIN gzip of data file: " + str(datetime.now()))
                if extendedProperty["DEBUG"].upper() == "TRUE":
                    output_file_path = WslPythonCommon.gzip_file(
                        fileDatFullPath+".txt",
                        fileDatFullPath+".gz",
                        False
                    )
                else:
                    output_file_path = WslPythonCommon.gzip_file(
                        fileDatFullPath+".txt",
                        fileDatFullPath+".gz",
                        True
                    )
                write_audit("=============== DATA FILE COMPRESSION ===============")
                write_audit("Original File: " + fileDatFullPath+".txt")
                write_audit("Data File Gzipped To: " + output_file_path)
                if extendedProperty["DEBUG"].upper() == "TRUE":
                    compression_ratio = str(os.path.getsize(fileDatFullPath+".txt")/os.path.getsize(fileDatFullPath+".gz"))
                    write_audit("Compression Ratio: " + "{:.3f}".format(float(compression_ratio)))
                write_audit("=====================================================")

                fileDatFullPath = output_file_path
                write_audit("END gzip of data file: " + str(datetime.now()))
        except Exception as exceptionError:
            raise Exception("Error in GzipFile: " + str(exceptionError))

    # Initiate File Upload to Snowflake
    write_audit("=================== FILE UPLOAD ===================")
    stage_name = "WSL-"+os.environ.get('WSL_LOAD_TABLE','')+"_"+os.environ.get('WSL_SEQUENCE','')+"_RANGE_DATA_FILE"

    # Clear Snowflake Stage
    clearStageSQL = "REMOVE @~/"+stage_name+"/*"
    write_audit("Clearing Snowflake Stage: " + clearStageSQL)
    clearStageResult, numberOfRows = executeSnowflakeQuery(clearStageSQL)

    # Upload File to Snowflake Stage
    write_audit("BEGIN upload of data file to Snowflake stage: " + str(datetime.now()))
    putFileSQL = "PUT file://"+fileDatFullPath+"* @~/"+stage_name+"/"
    write_audit("Uploading File to Snowflake Stage: " + putFileSQL)

    current_retries = 0
    max_retries = extendedProperty["MAX_RETRIES"]
    numberOfRows = 0

    while numberOfRows != 1 and int(current_retries) < int(max_retries):
        current_retries += 1
        write_audit("Current retries: " + str(current_retries) + " of " + str(max_retries))

        try:
            putFileResult, numberOfRows = executeSnowflakeQuery(putFileSQL, exitOnError=False)
        except Exception as e:
            numberOfRows = 0
            write_audit("Failed to upload file to stage. Retrying...")

    if numberOfRows != 1 and int(current_retries) >= int(max_retries):
        raise Exception("Data file upload failed. Retry limit exhausted. Aborting Process")

    if numberOfRows == 1:
        write_audit("Data file uploaded successfully to stage in retry: " + str(current_retries))

    # Initiate COPY INTO command
    write_audit("=================== COPY INTO ===================")

    PURGE = "TRUE"
    if extendedProperty["PURGE"].upper() == "FALSE":
        PURGE = "FALSE"

    {%- set crLfList = crLfReplaced.split(",") %}{% br %}
    copyStmt = """COPY INTO """+ os.environ.get('WSL_LOAD_FULLNAME','')+"""
    FROM ({%- br %}{% set csvPos = 0 %}
    SELECT {% for col in table.columns %}
            {%- if not loop.first %}           , {% endif %}
            {%- if crLfList contains col.name %}REPLACE(REPLACE({%- endif %}
            {%- if col.transformType.code == "A" %}{{ col.source }}
            {%- else %}
                {%- set csvPos = csvPos + 1 %}t.${{ csvPos }}
            {%- endif %}
            {%- if crLfList contains col.name %},'~~0A~~',CHAR(10)),'~~0D~~',CHAR(13)){%- endif %}
            {%- br %}
            {%- endfor %}
    FROM @~/"""+stage_name+""" t
    ){% br %}
    PATTERN = '.*'{%- br %}
    FILE_FORMAT = """+extendedProperty["FILE_FORMAT_FULL_NAME"]+"""
    PURGE = """+PURGE{% br %}

    {%- if table.loadInfo.fileLoaderOptions != "" %}    {{ table.loadInfo.fileLoaderOptions }}{%- br %}
    {%- endif %}

    write_audit(copyStmt)
    write_audit("")

    # Execute COPY INTO command
    write_audit("BEGIN COPY INTO: " + str(datetime.now()))
    copyIntoResult, copyIntoNumberOfRows = executeSnowflakeQuery(copyStmt)

    totalRowsLoaded = 0
    checkFlag = 0

    if copyIntoNumberOfRows > 0:
        write_audit("File                                            "+"Status         "+"Rows Parsed        "+"Rows Loaded  ")
        write_audit("=========================================================================================================")
        for i in range(0, copyIntoNumberOfRows):
            fileName = str(copyIntoResult[i][0]).split("/")[-1]
            copyIntoStatus = str(copyIntoResult[i][1])
            copyRowsParsed = str(copyIntoResult[i][2])
            copyRowsLoaded = str(copyIntoResult[i][3])
            copyErrorSeen = int(copyIntoResult[i][5])

            write_audit(fileName + " "*(48-len(fileName)) + copyIntoStatus + " "*(15-len(copyIntoStatus)) + copyRowsParsed + " "*(20-len(copyRowsParsed)) + copyRowsLoaded)

            if copyErrorSeen == 0:
                totalRowsLoaded += int(copyRowsLoaded)
                tableProperties["TOTAL_ROWS_LOADED"] += int(copyRowsLoaded)
            else:
                checkFlag = 1

    if checkFlag == 0:
        write_audit("Total Rows Loaded: " + str(totalRowsLoaded))
        write_audit("Load Completed Successfully")
        try:
            #-- WsWrkTask call to updated row counts in Ws_Wrk_Task_Run/Log{%- br %}
            metaResult = WslPythonCommon.WsWrkTask(0,0,0,totalRowsLoaded,0,0,0)
        except:
            write_audit("Failed to update task row count")
    else:
        raise Exception("Load Completed with Errors\nTotal Rows Loaded: " + str(totalRowsLoaded))

    write_audit("END COPY INTO: " + str(datetime.now()))

    # Delete Data File
    if extendedProperty["DEBUG"].upper() == "FALSE":
        try:
            os.remove(fileDatFullPath+".txt")
        except Exception as exceptionError:
            raise Exception("Error in deleting data file: " + str(exceptionError))

        clearStageResult, numberOfRows = executeSnowflakeQuery(clearStageSQL)
    else:
        write_audit("Debug Mode is enabled. Temporary data file not deleted")

{% endif %}

try:
    #--============================================================================
    #-- Main Process Starts Here
    #--============================================================================
    {% if PilotTable != "" %}{%- br %}
    duplicateBatches = checkDuplicateBatches()
    batchList, tableProperties["TOTAL_BATCH_COUNT"] = getBatches()

    write_audit("Starting Range Load")
    write_audit("Total Batches to Process: " + str(tableProperties["TOTAL_BATCH_COUNT"]))

#    thread_log_file_prefix = "wsl_"+str(os.environ.get('WSL_LOAD_TABLE',''))+"_"+str(os.environ.get('WSL_SEQUENCE',''))

    try:
        threadManager = WslPythonCommon.ThreadRunnerV2(int(tableProperties["THREAD_COUNT"]), parallelLoad)
    except Exception as exceptionError:
        raise Exception("Error in ThreadRunnerV2: " + str(exceptionError))

    # Create Queue for Parallel Loading
    batchQueue = queue.Queue()

    # Add batches to queue
    for batch in enumerate(batchList):
        batchQueue.put(batch)

    # Start Parallel Loading
    try:
        threadManager.run_threads(batchQueue)
    except Exception as exceptionError:
        raise Exception("Error in run_threads: " + str(exceptionError))

    write_audit("Range Load Completed")

    # Write Detail Result per Batch to Log
    write_audit("=====================================================")
    write_audit("Batch Number    |    Rows Loaded    |    Status")
    write_audit("=====================================================")

    # Sort Batch Result by Batch Number
    tableProperties["BATCH_RESULT"].sort(key=lambda x: x[0])
    for batchResult in tableProperties["BATCH_RESULT"]:
        batch_number = batchResult[0]
        rows_loaded = batchResult[1]
        status = batchResult[2]

        write_audit(str(batch_number) + " "*(15-len(str(batch_number))) + str(rows_loaded) + " "*(20-len(str(rows_loaded))) + status)

    write_audit("=====================================================")

    # Total Rows Loaded
    write_audit("Total Rows Loaded: " + str(tableProperties["TOTAL_ROWS_LOADED"]))
    write_audit("=====================================================")
    {% endif %}

    {% if PilotTable == "" %}{%- br %}
    loadRangeTable()
    {% endif %}{%- br %}
{%- br %}
except Exception as exceptionError:{%- br %}
    write_error("Script Failed:" + str(exceptionError))
    write_error(traceback.format_exc())
    exitCode = 2
    exitMessage = 'Script run failed'

{%- br %}
else: {%- br %}
    exitCode = 0
    exitMessage = 'Script ran successfully'
{%- br %}
finally: {%- br %}
    exit_script(exitCode, exitMessage)
{%- br %}
