{% macro addFromClause ( indent = "    " ) %}
  {%- for joinLine in (settings.sourceJoinDetails.join | trim | lines)%}{{ indent }}{{ joinLine | trim }}{%br%}{%- endfor %}
{% endmacro %}

{% macro addWhereClause ( indent = "    " ) %}
  {%- for whereLine in (settings.sourceJoinDetails.where | trim | lines)%}{{ indent }}{{whereLine | trim}}{%br%}{%- endfor%}
{% endmacro %}

{% macro addGroupByClause ( indent = "    " ) %}
  {%- for groupByLine in (settings.sourceJoinDetails.groupBy | trim | lines)%}{{ indent }}{{groupByLine | trim}}{%br%}{%- endfor %}
{% endmacro %}

{% macro addType2TrackedWhere ( indent = "    ", compareOperator = "=", whereType = "AND", compareType = "OR", dssDeleteTime = dssDeleteTime, dssDeleteFlag = dssDeleteFlag, nullSupport = true ) %}
  {{- indent }}-- tracked columns{% br %}
  {%- from table.columns as column where column.slowlyChanging %}
    {%- if loop.first -%}{{- indent }}{{ whereType }}   (
    {%- else %}{{- indent }}{{ compareType }}
    {%- endif %}
    {%- if nullSupport %}{% if not loop.first %}    {% endif %}COALESCE(CAST({% else %} {% endif -%}
    {{- column.source -}}
    {%- if nullSupport %} AS VARCHAR(8000)),'~') {% else %} {% endif -%}
    {{- compareOperator -}}
    {%- if nullSupport %} COALESCE(CAST({% else %} {% endif %}
    {{- table.name }}.{{ column.name -}}
    {%- if nullSupport %} AS VARCHAR(8000)),'~'){% endif -%}
    {%- br -%}
    {%- if loop.last %}{{- indent }}){%br%}{%- endif %}
  {%- endfrom %}
{% endmacro %}

{% macro addType2UntrackedWhere ( indent = "    ", compareOperator = "=", whereType = "AND", compareType = "OR", dssDeleteTime = dssDeleteTime, dssDeleteFlag = dssDeleteFlag, nullSupport = true ) %}
  {{- indent }}-- untracked columns{% br %}
  {%- from table.columns as column where not ( column.slowlyChanging or column.businessKey or column.dss or column.artificial or ( column.name == dssDeleteTime ) or ( column.name == dssDeleteFlag ) ) %}
    {%- if loop.first -%}{{- indent }}{{ whereType }}   (
    {%- else %}{{- indent }}{{ compareType }}
    {%- endif %}
    {%- if nullSupport %}{% if not loop.first %}    {% endif %}COALESCE(CAST({% else %} {% endif -%}
    {{- column.source -}}
    {%- if nullSupport %} AS VARCHAR(8000)),'~') {% else %} {% endif -%}
    {{- compareOperator -}}
    {%- if nullSupport %} COALESCE(CAST({% else %} {% endif %}
    {{- table.name }}.{{ column.name -}}
    {%- if nullSupport %} AS VARCHAR(8000)),'~'){% endif -%}
    {%- br -%}
    {%- if loop.last %}{{- indent }}){%br%}{%- endif %}
  {%- endfrom %}
{% endmacro %}

{% macro addChangedWhere ( indent = "    ", compareOperator = "<>", whereType = "AND", compareType = "OR", dssDeleteTime = dssDeleteTime, dssDeleteFlag = dssDeleteFlag, nullSupport = true ) %}
  {%- from table.columns as column where not ( column.businessKey or column.dss or column.artificial or ( column.name == dssDeleteTime ) or ( column.name == dssDeleteFlag ) ) %}
    {%- if loop.first -%}{{- indent }}{{ whereType }} (
    {%- else %}{{- indent }}  {{ compareType }}
    {%- endif %}
    {%- if nullSupport %} COALESCE(CAST({% else %} {% endif -%}
    {{- column.source -}}
    {%- if nullSupport -%} AS VARCHAR(8000)),'~') {% else %} {% endif -%}
    {{- compareOperator -}}
    {%- if nullSupport %} COALESCE(CAST({% else %} {% endif %}
    {{- table.name }}.{{ column.name -}}
    {%- if nullSupport %} AS VARCHAR(8000)),'~'){% endif -%}
    {%- br -%}
    {%- if loop.last %}{{- indent }}){%br%}{%- endif %}
  {%- endfrom %}
{% endmacro %}

{% macro addMaxKeyJoin ( indent = "    " ) %}
  {%- from table.columns as artificialKey where artificialKey.artificial -%}
    {%- if loop.first -%}
      {{- indent }}CROSS JOIN ( SELECT MAX({{artificialKey.name}}) AS maxkey FROM [TABLEOWNER].[{{table.name}}]) AS maxkey{% br %}
    {%- endif -%}
  {%- endfrom %}
{% endmacro %}

{# -- This macro adds the select from the target table -- #}
{% macro addMergeTargetColumnsSelect ( indent = "    " ) %}
  {{- indent }}SELECT
  {%- from table.columns as column where column.dataType.toLowerCase.indexOf("identity") == -1 %}
    {%- if not loop.first %}{{- indent }}     , {% else %} {% endif -%}
    {%- if column.artificial -%}
      0 AS MAXKEY{%- br -%}
    {%- elseif column.updateTime -%}
      CAST(CURRENT_TIMESTAMP AS {{ column.fullDataType }}) AS {{ column.name }}{%- br -%}
    {%- else -%}
      {{- table.name}}.{{column.name}}{%- br -%}
    {%- endif -%}
  {%- endfrom %}
{% endmacro %}


{%- macro FullyQualifyObject(tabObject = table) -%}
  {%- if tabObject.database | trim != "" -%}{{tabObject.database}}.{%- endif -%}{% if tabObject.schema | trim != "" -%}{{tabObject.schema}}.{%- endif -%}{{tabObject.name}}
{%- endmacro -%}

{# -- Proc Template Macros -- #}
{# -- -------------------- -- #}
{# -- This macro inserts the procedure comment block -- #}
{% macro addProcedureCommentBlock(indentString = "  ", commentMessage = "Hello", tableName = "") %}
{{- indentString -}}--====================================================={%br%}
{{- indentString -}}-- {{commentMessage}}{{tableName}}{%br%}
{{- indentString -}}--====================================================={%br%}
{% endmacro %}

{% macro addBatchLoopWhereClauseV2(indent = "      ", dssFlag = false) %}
  {%- if settings.sourceJoinDetails.where | trim != "" or dssFlag %}
    {%- set nextWhere = "AND" %}
  {%- else %}
    {%- set nextWhere = "WHERE" %}
  {%- endif %}
  {%- if settings.batchProcessingField != "" %}
    {%- set sourceFound = false %}
    {%- for col in table.columns %}
      {%- if col.sourceColumn is defined and not sourceFound %}
        {%- fetch col.sourceColumn %}
        {%- if col.sourceColumn.name == settings.batchProcessingField %}
          {{- indent}}{{nextWhere}}    {{col.source}} = RECORD.{{settings.batchProcessingField}} {%br%}
          {%- set sourceFound = true %}
        {%- endif %}
      {%- endif %}
    {%- endfor %}
  {%- endif %}
{% endmacro %}

# -- This macro inserts the procedure exception handler-- #}
{% macro addProcedureException() %}
  EXCEPTION{%br%}
      -- Handle statement errors
      WHEN statement_error THEN{%br%}
          RETURN OBJECT_CONSTRUCT('Error type', 'STATEMENT_ERROR',
                                  'SQLCODE', sqlcode,
                                  'SQLERRM', sqlerrm,
                                  'SQLSTATE', sqlstate);

      -- Handle custom exception
      WHEN v_exception THEN{%br%}
          RETURN OBJECT_CONSTRUCT('Error type', 'v_exception',
                                  'SQLCODE', sqlcode,
                                  'SQLERRM', sqlerrm,
                                  'SQLSTATE', sqlstate);

      -- Catch-all for any other error
      WHEN OTHER THEN{%br%}
          RETURN OBJECT_CONSTRUCT('Error type', 'Other error',
                                  'SQLCODE', sqlcode,
                                  'SQLERRM', sqlerrm,
                                  'SQLSTATE', sqlstate);
{% endmacro %}


{# -- This macro inserts the procedure exception handler -- #}
{% macro addReturnMessage(deleteBeforeInsert, deleteBeforeInsertTruncate, addMerge = TRUE, addInsert = FALSE, addUpdate = FALSE) %}
    p_status := 1;{%br%}
    p_return_msg := '{{table.name}} updated. '{%br%}
    {%- if settings.deleteBeforeInsert and not settings.deleteBeforeInsertTruncate %}
      || TRIM(TO_CHAR(v_delete_count)) || ' records deleted. '{%br%}
    {% endif %}
    {%- if addMerge %}
    || TRIM(TO_CHAR(v_merge_count)) || ' records merged. '{%br%}
    {%- endif %}
    {%- if addInsert %}
    || TRIM(TO_CHAR(v_insert_count)) || ' records inserted. '{%br%}
    {%- endif %}
    {%- if addUpdate %}
    || TRIM(TO_CHAR(v_update_count)) || ' records updated. '{%br%}
    {%- endif %}  ;{%br%}{%br%}
   RETURN OBJECT_CONSTRUCT('p_return_msg', p_return_msg, 'p_status', p_status);{%br%}{%br%}
{% endmacro %}


{% macro addProcedureParameters() %}
    p_sequence         INTEGER,{%br%}
    p_job_name         STRING,{%br%}
    p_task_name        STRING,{%br%}
    p_job_id           INTEGER,{%br%}
    p_task_id          INTEGER{%br%}
{% endmacro %}

{# -- This macro inserts the procedure header including parameters and declarations -- #}
{% macro addProcedureHeader(deleteBeforeInsert, deleteBeforeInsertTruncate,dssDeleteTimePresent=false,dssDeleteFlagPresent=false) %}
CREATE OR REPLACE PROCEDURE [SCHEMA.{{settings.procedureName}}].{{settings.procedureName}}{%br%}
({%br%}
{{addProcedureParameters()}}
){%br%}
RETURNS OBJECT {%br%}
LANGUAGE SQL{%br%}
AS{%br%}
{{ addProcedureDeclares(deleteBeforeInsert, deleteBeforeInsertTruncate,dssDeleteTimePresent,dssDeleteFlagPresent) }} {%br%}
{% endmacro %}

{# -- This macro inserts the procedure declarations -- #}
{% macro addProcedureDeclares(deleteBeforeInsert, deleteBeforeInsertTruncate,dssDeleteTimePresent=false,dssDeleteFlagPresent=false) %}
  {{- addProcedureCommentBlock(commentMessage = "Control variables used in most programs")}}
DECLARE
    v_msgtext               STRING;              -- Text for audit_trail{%br%}
    v_sql                   STRING;              -- Text for SQL statements{%br%}
    v_step                  INTEGER := 100;      -- Step number{%br%}
    v_update_count          INTEGER := 0;        -- no of records updated{%br%}
    v_insert_count          INTEGER := 0;        -- no of records inserted{%br%}
    v_merge_count           INTEGER := 0;        -- no of records merged{%br%}
    v_change_count          INTEGER;             -- Used for history start/end dates{%br%}
    {%- if dssDeleteTimePresent and dssDeleteFlagPresent %}{%br%}
    v_source_count          INTEGER DEFAULT 0;   -- Used for Tracking source count for logical deletes{%br%}
    v_logicalDeleteCount    INTEGER DEFAULT 0;   -- Used for logical deletes{%br%}
    {%- endif -%}{%br%}
    {%- if deleteBeforeInsert and not deleteBeforeInsertTruncate %}    v_delete_count          INTEGER := 0;        -- no of records deleted{%br%} {%- endif %}
    v_count                 INTEGER;             -- General Counter{%br%}
  {{- addProcedureCommentBlock(commentMessage = "General Variables")}}
    v_return_status         INTEGER;             -- Update result status{%br%}
    v_row_count             INTEGER;             -- General row count{%br%}
    v_exception            EXCEPTION (-20002, 'Custom exception raised.');{%br%}
    v_status                INTEGER;             -- General status field{%br%}
    p_return_msg            STRING;              -- Text message to print logs{%br%}
    p_status                INTEGER;             -- number to capture execution status{%br%}
    {%- for par in settings.parameters %}
    {%- if loop.first %}
    {{- addProcedureCommentBlock(commentMessage = "Parameter Variables")}}
    v_parameter_comment     STRING; {%br%}
    {%- endif %}
    v_{{par}}               STRING;{%br%}
    {%- endfor %}
{% endmacro %}

{# -- This macro adds the source columns and dss columns -- #}
{% macro addSetInsertColumnsSnowflakeProc(addArtificialKey = false, alias = "", zeroKeyInsert = false, ignoreDssColumns = false, addColumnName = true, keepCreateDate = false, ignoreDssVersion = false, firstChangingVersion = true, lastChangingVersion = true, indent = "       ", includeIdentity = false, includePreviousColumns = false)%}
  {%- from table.columns as column where (includeIdentity or column.fullDataType.toLowerCase.indexOf("integer identity") != 0) and ((not column.artificial) or (column.artificial and addArtificialKey) or (column.artificial and (not addArtificialKey) and column.transform | trim != "")) and ( includePreviousColumns or (table.subType != "P" or ((previousColumn("SF_TYPE_3_COLS",column.name)|trim) == "false")))%}
    {%- if not loop.first %}{{indent}}, {% else %} {% endif %}
    {%- if column.artificial and addArtificialKey -%}
      {{- addSnowflakeArtificialKeyProc( )}}
    {%- elseif column.artificial and not addArtificialKey and column.transform | trim != "" -%}
      {%- for transLine in (column.transform | trim | lines) %}
        {%- if not loop.first %}          {% endif %}{{transLine}}{%- if not loop.last %}{%br%}{% endif %}
      {%- endfor %}
    {%- elseif column.transform | trim != "" %}
      {%- if alias != "" -%}
        {{alias}}.{{column.name}}
      {%- else -%}
        {%- for transLine in (column.transform | trim | lines) %}
          {%- if not loop.first %}          {% endif %}{{transLine}}{%- if not loop.last %}{%br%}{% endif %}
        {%- endfor %}
      {%- endif %}
    {%- elseif column.currentFlag and not ignoreDssColumns -%}
      {% if lastChangingVersion %}'Y'{% else %}'N'{% endif %}
    {%- elseif column.dssStartDate and not ignoreDssColumns -%}
      {% if firstChangingVersion %}{{settings.changeDetectionStartInitial}}{% elseif not lastChangingVersion %}{{table.name}}.{{column.name}}{% else %}{{settings.changeDetectionStartNew}}{% endif %}
    {%- elseif column.dssEndDate and not ignoreDssColumns -%}
      {% if lastChangingVersion %}{{settings.changeDetectionEndCurrent}}{% else %}{{settings.changeDetectionEndExpiring}}{% endif %}
    {%- elseif column.dssVersion and not ignoreDssColumns -%}
      {% if firstChangingVersion %}1{% elseif not lastChangingVersion %}{{table.name}}.{{column.name}}{% else %}{{table.name}}.{{column.name}} + 1{% endif %}
    {%- elseif (column.updateTime or column.createTime) and not ignoreDssColumns -%}
      {%- if column.createTime and keepCreateDate -%}
        {{column.name}}
      {%- else -%}
        CAST(CURRENT_TIMESTAMP AS TIMESTAMP)
      {%- endif%}
    {%- elseif table.subType == "P" and ((previousColumn("SF_TYPE_3_COLS",column.name)|trim) == "true") -%}
      {%- if alias == "" %}
        {%- fetch column.sourceColumn -%}
        {%- set prevColSrc = column.sourceColumn.name -%}
           CASE {{ table.name}}.{{prevColSrc}}{% br %}
             WHEN {{ column.source }}{% br %}
             THEN {{ table.name }}.{{ column.name}}{% br %}
             ELSE {{ table.name}}.{{ prevColSrc }}{% br %}
           END
      {%- else -%}
        {{- getColumnSource(alias = alias)}}
      {%- endif -%}
    {%- else -%}
      {{- getColumnSource(alias = alias)}}
    {%- endif %}
    {%- if addColumnName %} AS {{column.name}}{%- endif %}{%br%}
  {%- endfrom %}
{% endmacro %}


# -- This macro inserts the artificial key insert statement -- #}
{% macro addSnowflakeArtificialKeyProc(column = column, alias = table.name, zeroKeyInsert = false) %}
{%- if zeroKeyInsert -%}
  0
{%- elseif column.transform | trim != "" %}
 {{-column.name}}
{%- else -%}
  ROW_NUMBER() OVER(PARTITION BY NVL(max_key,0) ORDER BY {{getBusinessKeyCol1Name()}}) + NVL(max_key,0)
{%- endif -%}
{% endmacro %}







