def GzipFile({%br%}
        inFile="No input file specified",{%br%}
        outFile=".gz",{%br%}
        removeOriginal=True{%br%}
    ):{%br%}

    with open(inFile, 'rb') as f_in:{%br%}
        with gzip.open(os.path.splitext(inFile)[0]+outFile, 'wb') as f_out:
            shutil.copyfileobj(f_in, f_out){%br%}

    if removeOriginal==True:{%br%}
        os.remove(os.path.splitext(inFile)[0]+".txt"){%br%}

    return((inFile+outFile))

{%  if (table.exportInfo.compressAfterExport  == true)  %}
# File compress function for windows file loads
def ArchiveFiles(srcFile):{%- br %}
    try:
        utilityPath=r"{{table.exportInfo.compressUtility.path}} ".replace("\ ","").strip(){%- br %}
        separator="\\\\"{%- br %}
        utilityPath=utilityPath.split("\\"){%- br %}
        utilityPath=separator.join(utilityPath){%- br %}
        utilityName='{{table.exportInfo.compressUtility.name}}'{%- br %}
        utilityParameters='{{table.exportInfo.compressParameters}}'{%- br %}
        utilityParameters=utilityParameters.replace('$EXPFILE$',srcFile){%- br %}
        {%- set compressUtility = table.exportInfo.compressUtility.name -%}
        {%  if compressUtility == "" %}{%- br %}
        GzipFile(srcFile,'.gz',True){%- br %}
        write_audit("File Compressed using Gzip"){%- br %}
        {%  else  %}{%- br %}
        import subprocess{%- br %}
        outputCmd=subprocess.check_output(os.path.join(utilityPath,utilityName) +" "+ utilityParameters, universal_newlines=True){%- br %}
        write_audit("\n"+outputCmd){%- br %}
        write_audit("\nFile Compressed using command :"+os.path.join(utilityPath,utilityName) +" "+ utilityParameters){%- br %}
        {%- endif %}{%- br %}
    except Exception as inst:
            write_error("Compression Failed "+str(inst.args)){%- br %}
{%- endif %}
{%  if (table.exportInfo.triggerFile.path != "") and ( table.exportInfo.triggerFile.name != "")  %}{%- br %}
# Trigger File creation function for windows file loads
def CreateTriggerFile(): {%- br %}
    trgFileDelim = '{{ table.exportInfo.triggerFile.fieldDelimiter }}'{%- br %}
    if trgFileDelim=="":
        trgFileDelim = '|'

    trgFilePath = r'{{ table.exportInfo.triggerFile.path }} '.replace("\ ","").replace(" ",""){%- br %}
    if trgFilePath =="":
       trgFilePath = os.environ.get('WSL_WORKDIR','')

    trgFileName = '{{ table.exportInfo.triggerFile.name }}'{%- br %}
    trgFileName = WslPythonCommon.ReplaceWslTags(trgFileName){%- br %}
    if trgFileName=="":
        trgFileName = str(os.environ.get('WSL_EXP_NAME',''))+"_"+str(os.environ.get('WSL_SEQUENCE',''))+".trg"

    trgFile = os.path.join(trgFilePath,trgFileName){% br %}
    mExpOptions = '{{ table.exportInfo.options.Replace("'","'''") }}'{%- br %}
    trgSelectStmt = """
    SELECT {%- br %}
    {%-  if (table.exportInfo.triggerParameter1 == "Row Count")%}
      count(*){%- br %}
    {%- elseif (table.exportInfo.triggerParameter1 != "" ) %}
      {{ table.exportInfo.triggerParameter1 }}{%- br %}
    {%- endif %}
    {%-  if (table.exportInfo.triggerParameter2 == "Row Count")%}
    , count(*){%- br %}
    {%- elseif (table.exportInfo.triggerParameter2 != "" ) %}
    , {{ table.exportInfo.triggerParameter2 }}{%- br %}
    {%- endif %}
    {%-  if (table.exportInfo.triggerParameter3 == "Row Count")%}
    , count(*){%- br %}
    {%- elseif (table.exportInfo.triggerParameter3 != "" ) %}
    , {{ table.exportInfo.triggerParameter3 }}{%- br %}
    {%- endif %}
    FROM """+str(os.environ.get('WSL_EXP_FULLNAME',''))+" "+str(os.environ.get('WSL_EXP_TABLE','')){%- br %}
{%- br %}

    try:
        if os.environ.get('WSL_SRC_CONSTRING','') != "":{% br %}
            SFConnectionString = os.environ.get('WSL_SRC_CONSTRING',''){% br %}	
        else:
            uid=str(os.environ.get('WSL_SRC_USER','')) {% br %}
            pwd=str(os.environ.get('WSL_SRC_PWD','')) {% br %}
            SFConnectionString = "DSN="+str(os.environ.get('WSL_SRC_DSN','')){% br %}
            if uid and not uid.isspace(): {% br %}
              SFConnectionString += ";UID="+uid {% br %}
            if pwd and not pwd.isspace(): {% br %}
              SFConnectionString += ";PWD="+pwd {% br %}
        SFConnectionString = WslPythonSnowflake.addapplicationid(SFConnectionString)
        SFConnection = pyodbc.connect(SFConnectionString, autocommit=True){% br %}
    except Exception as exceptionError: {% br %}
        write_error("Connection error has occurred: : " + repr(exceptionError)){% br %}
        raise Exception("Connection error has occurred: : " + reprite_detail)

    deleteRes = "remove @~/"+trgFileName+";"{% br %}
    try:
             SFCursor = SFConnection.cursor()
             query_tag = WslPythonCommon.GetExtendedProperty("SF_QUERY_TAG", str(os.environ.get('WSL_EXP_TABLE',''))).strip()
             if query_tag and query_tag.strip():
                query_sql = f"ALTER SESSION SET QUERY_TAG = '{query_tag}'"
                SFCursor.execute(query_sql)
             SFCursor.execute(deleteRes)
             SFCursor.close()
    except Exception as exceptionError:
              write_error("An error has occurred: " + repr(exceptionError)){% br %}
    copyStmt = """
      COPY INTO @~/"""+trgFileName+"""
      FROM ( """+ trgSelectStmt + f""")FILE_FORMAT = (TYPE = 'CSV' FIELD_DELIMITER = '{trgFileDelim}' COMPRESSION = NONE) single=true;"""
    try:
         SFCursor = SFConnection.cursor()
         maskedTrgExport=SFCursor.execute(copyStmt).fetchall()
         SFCursor.close()
    except Exception as exceptionError:
            write_error("An error has occurred: " + repr(exceptionError)){% br %}
            raise Exception("An error has occurred: " + repr(exceptionError)){% br %}
    {%- br %}
    write_audit("\nTrigger File:    " + trgFileName)
      {%- br %}
    if maskedTrgExport[0][0] != 0:{%- br %}
            rowsTrgExported = maskedTrgExport[0][0]{%- br %}
    else: {%- br %}
            write_error("Export failed"){%- br %}
            raise Exception("Export failed"){%- br %}
    snowsqlGet = "GET @~/"+trgFileName+" file://"+trgFilePath+";"{%- br %}
    write_audit("\nGET:    " + snowsqlGet){%- br %}
    try:
         SFCursor = SFConnection.cursor()
         getRes=SFCursor.execute(snowsqlGet).fetchall()
         SFCursor.close()
    except Exception as exceptionError:
            write_error("An error has occurred: " + repr(exceptionError)){%- br %}
            raise Exception("An error has occurred: " + repr(exceptionError)){%- br %}
    getFile = getRes[0][0]{%- br %}
    getStatus = getRes[0][2]{%- br %}
    getMessage = getRes[0][3]{%- br %}
    if getStatus == "DOWNLOADED":{%- br %}
          deleteRes = "remove @~/"+trgFileName+";"{%- br %}
          try:
             SFCursor = SFConnection.cursor()
             query_tag = WslPythonCommon.GetExtendedProperty("SF_QUERY_TAG", str(os.environ.get('WSL_EXP_TABLE',''))).strip()
             if query_tag and query_tag.strip():
                query_sql = f"ALTER SESSION SET QUERY_TAG = '{query_tag}'"
                SFCursor.execute(query_sql)
             SFCursor.execute(deleteRes)
             SFCursor.close()
          except Exception as exceptionError:
              write_error("An error has occurred: " + repr(exceptionError)){%- br %}
              raise Exception("An error has occurred: " + repr(exceptionError)){%- br %}
          if getMessage!="": {%- br %}
              write_audit("Message returned from GET call: "+getMessage){%- br %}
          write_audit("Trigger File "+trgFile+" created"){%- br %}
    else:{%- br %}
          if getMessage !="":{%- br %}
              write_audit("\nMessage returned from GET call: " +getMessage){%- br %}
          write_error("Status returned from GET call: "+ getStatus + "\n" + "Trigger File Creation Failed"){%- br %}
          raise Exception("Status returned from GET call: "+ getStatus + "\n" + "Trigger File Creation Failed"){%- br %}
{%- br %}
{%- endif %}
def ExportData(runMode):{%br%}
{% block "GetExtendedPropertyAll" %}{%br%}
    os.environ["DEBUG"]          = WslPythonCommon.GetExtendedProperty("SF_DEBUG_MODE",str(os.environ.get('WSL_EXP_NAME',''))){%br%}
    os.environ["ACCESS_KEY"]     = WslPythonCommon.GetExtendedProperty("SF_ACCESS_KEY",str(os.environ.get('WSL_EXP_TABLE',''))){%br%}
    os.environ["SECRET_KEY"]     = WslPythonCommon.GetExtendedProperty("SF_SECRET_KEY",str(os.environ.get('WSL_EXP_TABLE',''))){%br%}
    os.environ["SEND_FILES_ZIPPED"]  = WslPythonCommon.GetExtendedProperty("SF_SEND_FILES_ZIPPED",str(os.environ.get('WSL_EXP_TABLE',''))){%br%}
    os.environ["SNOWSQL_ACCOUNT"]= WslPythonCommon.GetExtendedProperty("SF_SNOWSQL_ACCOUNT",str(os.environ.get('WSL_EXP_TABLE',''))){%br%}
    os.environ["SNOWSQL_DATABASE"]  = WslPythonCommon.GetExtendedProperty("SF_SNOWSQL_DATABASE",str(os.environ.get('WSL_EXP_TABLE',''))){%br%}
    os.environ["SNOWSQL_SCHEMA"] = WslPythonCommon.GetExtendedProperty("SF_SNOWSQL_SCHEMA",str(os.environ.get('WSL_EXP_TABLE',''))){%br%}
    os.environ["SNOWSQL_WAREHOUSE"] = WslPythonCommon.GetExtendedProperty("SF_SNOWSQL_WAREHOUSE",str(os.environ.get('WSL_EXP_TABLE',''))){%br%}
    os.environ["SNOWSQL_USER"] = os.environ.get('WSL_SRC_USER',''){%br%}
    os.environ["SNOWSQL_PWD"]  = os.environ.get('WSL_SRC_PWD',''){%br%}
{%- br %}
{% endblock %}


    write_detail("=================== EXPORT OPTIONS ==================="){%br%}
    write_detail("Specified Export Table:        " + str(os.environ.get('WSL_EXP_TABLE',''))){%br%}
    write_detail("Specified Work Dir:          " + str(os.environ.get('WSL_WORKDIR',''))){%br%}
    write_detail("Specified Sequence:          " + str(os.environ.get('WSL_SEQUENCE',''))){%br%}
    write_detail("Specified Metadata ODBC DSN: " + str(os.environ.get('WSL_META_DSN',''))){%br%}
    write_detail("Specified Metadata Username: " + str(os.environ.get('WSL_META_USER',''))){%br%}
    write_detail("Specified Metadata Password: " + ('*'*len(str(os.environ.get('WSL_META_PWD',''))))){%br%}
    write_detail("")
    if runMode == 'S3':{%br%}
        write_detail("=================== CONNECTION OPTIONS ==================="){%br%}
        write_detail("Access Key:                  " +  ('*'*len(str(os.environ.get('ACCESS_KEY',''))))){%br%}
        write_detail("Secret Key:                  " +  ('*'*len(str(os.environ.get('SECRET_KEY',''))))){%br%}
        write_detail("")
    write_detail("=================== MODES ==================="){%br%}
    write_detail("Specified Debug Mode:        " + str(os.environ.get('DEBUG',''))){%br%}
    write_detail("Specified Run Mode:          " + runMode){%br%}
    write_detail("Unicode Extract:             " + str(os.environ.get('UNICODE_SUPPORT',''))){%br%}
    write_detail(""){%br%}

    if runMode == 'Database':{%br%}
        write_detail("=================== SOURCE TABLE INFO ==================="){%br%}
        write_detail("Source Where:               " +  '{{ table.exportInfo.whereClause }}'){%br%}
        write_detail(""){%br%}
        write_detail("=================== SOURCE DB INFO ==================="){%br%}
        write_detail("ODBC Source DSN:             " + str(os.environ.get('WSL_SRC_DSN',''))){%br%}
        write_detail("ODBC Source Username:        " + str(os.environ.get('WSL_SRC_USER',''))){%br%}
        write_detail("ODBC Source Password:        " + ('*'*len(str(os.environ.get('WSL_SRC_PWD',''))))){%br%}
        write_detail("")
    {%- br %}
    write_audit("================= EXTRACT SQL =====================\n"){%br%}
    {%- set empty = "" %}
    extractSql = """
     SELECT
      {%- from table.columns as column where (column.sourceColumn is defined or column.transform | trim != "") %}
        {%- if not loop.first %}    , {% else %} {% endif %}
        {%- if column.transform | trim != "" %}
          {{- column.source }}
        {%- else %}
          {%- if column.sourceTable is defined %}
            {%- fetch column.sourceTable %}
            {{- column.sourceTable.name }}.
          {%- endif %}
        {%- if column.sourceColumn is defined %}
            {{- column.sourceColumn.name }} {%- if (table.exportInfo.headerRow.name == 'Business names') and (column.sourceColumn is defined) %} AS "{{ column.displayName }}" {%- endif %}
        {%- endif %}
      {%- endif %}
        {%- br %}
      {%- endfrom %}
    FROM """+str(os.environ.get('WSL_EXP_FULLNAME',''))+" "+str(os.environ.get('WSL_EXP_TABLE',''))+"""
     {%- from table.exportInfo.whereClause | lines as whereLine %}
    {{ whereLine }}{% br %}
    {%- endfrom %}
"""{%- br %}
   {%- br %}
    write_audit(extractSql)
    try:
        if os.environ.get('WSL_SRC_CONSTRING','') != "":{% br %}
            SFConnectionString = os.environ.get('WSL_SRC_CONSTRING',''){% br %}	
        else:
            uid=str(os.environ.get('WSL_SRC_USER','')) {% br %}
            pwd=str(os.environ.get('WSL_SRC_PWD','')) {% br %}
            SFConnectionString = "DSN="+str(os.environ.get('WSL_SRC_DSN','')){% br %}
            if uid and not uid.isspace(): {% br %}
              SFConnectionString += ";UID="+uid {% br %}
            if pwd and not pwd.isspace(): {% br %}
              SFConnectionString += ";PWD="+pwd {% br %}
        SFConnectionString = WslPythonSnowflake.addapplicationid(SFConnectionString)
        SFConnection = pyodbc.connect(SFConnectionString, autocommit=True){% br %}
    except Exception as exceptionError: {% br %}
        write_error("Connection error has occurred: " + repr(exceptionError)){% br %}
        raise exceptionError

    write_detail("BEGIN create of data file from source system: "+str(datetime.now())+'\n'){% br %}
    unicode = False{% br %}
    if str(os.environ.get('UNICODE_SUPPORT',''))== "TRUE":{% br %}
       unicode = True{% br %}
    if runMode == "Windows":
       path = r"{{ table.exportInfo.file.path }} ".replace("\ ","").replace(" ",""){%- br %}
       path = WslPythonCommon.ReplaceWslTags(path){%- br %}
       file = '{{ table.exportInfo.file.name }}'{%- br %}
       file = WslPythonCommon.ReplaceWslTags(file){%- br %}
       delimitedBy= "'{{ table.exportInfo.file.fieldDelimiter }}'"{%- br %}
       if delimitedBy=="":
            delimitedBy = '|'
       enclosedBy='{{ table.exportInfo.file.fieldEnclosure.Replace("'","''") }}'{%- br %}
       headerRow= "{{table.exportInfo.headerRow.name}}"{%- br %}
       if headerRow == 'None':
          headerRow = 'false'
       else:
          headerRow = 'true'
    {%- br %}
    else:{% br %}
      path=(str(os.environ.get('WSL_SERVER',''))+" ").replace("\ ","").replace(" ",""){%- br %}{% br %}
      file = '{{ table.exportInfo.file.name }}'{%- br %}
      file = WslPythonCommon.ReplaceWslTags(file){%- br %}
      fileDat=os.path.join(path,file)
    if runMode != "S3":{%- br %}
      write_audit("\n================= SNOWSQL =================\n"){% br %}
      deleteRes = "remove @~/"+file+";"{% br %}
      try:
             SFCursor = SFConnection.cursor()
             query_tag = WslPythonCommon.GetExtendedProperty("SF_QUERY_TAG", str(os.environ.get('WSL_EXP_TABLE',''))).strip()
             if query_tag and query_tag.strip():
                query_sql = f"ALTER SESSION SET QUERY_TAG = '{query_tag}'"
                SFCursor.execute(query_sql)
             SFCursor.execute(deleteRes)
             SFCursor.close()
      except Exception as exceptionError:
              write_error("An error has occurred: " + repr(exceptionError)){% br %}
              raise exceptionError
      copyStmt = """
      COPY INTO @~/"""+file+"""
      FROM ( """+ extractSql +""")FILE_FORMAT = (TYPE = 'CSV' COMPRESSION = NONE
      FIELD_DELIMITER = """+delimitedBy+""" field_optionally_enclosed_by= '{{ table.exportInfo.file.fieldEnclosure.Replace("'","''") }}')single=true HEADER = """+headerRow+"""; {{ table.exportInfo.options }}"""
      try:
         SFCursor = SFConnection.cursor()
         maskedExport=SFCursor.execute(copyStmt).fetchall()
         SFCursor.close()
      except Exception as exceptionError:
            write_audit("An error has occurred: " + repr( exceptionError)){%- br %}
            raise exceptionError

      {%- br %}
      write_audit("Export:    " + str(maskedExport[0][0]))
      {%- br %}
      if maskedExport[0][0] != 0:{%- br %}
            rowsExported = maskedExport[0][0]{%- br %}
      else: {%- br %}
            write_audit("Export failed"){%- br %}
            raise Exception("Export failed")
      snowsqlGet = "GET @~/"+file+" file://"+path+";"{%- br %}
      write_audit("\nGET:    " + snowsqlGet){%- br %}

      try:
         SFCursor = SFConnection.cursor()
         getRes=SFCursor.execute(snowsqlGet).fetchall()
         SFCursor.close()
      except Exception as exceptionError:
            write_audit("An error has occurred: " + repr(exceptionError)){% br %}
            raise exceptionError
      getFile = getRes[0][0]{%- br %}
      getStatus = getRes[0][2]{%- br %}
      getMessage = getRes[0][3]{%- br %}
      if getStatus == "DOWNLOADED":{%- br %}
            deleteRes = "remove @~/"+file+";"{%- br %}
            try:
             SFCursor = SFConnection.cursor()
             query_tag = WslPythonCommon.GetExtendedProperty("SF_QUERY_TAG", str(os.environ.get('WSL_EXP_TABLE',''))).strip()
             if query_tag and query_tag.strip():
                query_sql = f"ALTER SESSION SET QUERY_TAG = '{query_tag}'"
                SFCursor.execute(query_sql)
             SFCursor.execute(deleteRes)
             SFCursor.close()
            except Exception as exceptionError:
              write_audit("An error has occurred: " + repr(exceptionError)){%- br %}
            write_audit("File "+file+" downloaded as "+os.path.join(path,getFile)+"\n"){%- br %}
            if getMessage!="": {%- br %}
                write_audit("Message returned from GET call: "+getMessage){%- br %}
            write_audit(str(rowsExported)+" rows exported"){%- br %}
            write_audit("Export successful. "+str(rowsExported)+" rows exported"){%- br %}
      else:{%- br %}
            write_audit("\nStatus returned from GET call:"+ getStatus){%- br %}
            if getMessage !="":{%- br %}
                write_audit("\nMessage returned from GET call: " +getMessage){%- br %}
            write_error("Export failed"){%- br %}
            raise Exception("Export failed"){%- br %}
        {%- br %}
    else: {%- br %}
        write_audit("\n================= SNOWSQL ================="){%- br %}
        delimitedBy= "'{{ table.exportInfo.file.fieldDelimiter }}'"{%- br %}
        if delimitedBy=="":
            delimitedBy = '|'
        headerRow= "{{table.exportInfo.headerRow.name}}"{%- br %}
        if headerRow == 'None':
            headerRow = 'false'
        else:
            headerRow = 'true'
        copyStmt = """
        COPY INTO @~/"""+fileDat+"""
        FROM ( """+ extractSql +""") CREDENTIALS = (AWS_KEY_ID='"""+str(os.environ.get('ACCESS_KEY',''))+""" AWS_SECRET_KEY='"""+str(os.environ.get('SECRET_KEY',''))+"""
        FILE_FORMAT = (TYPE = 'CSV' COMPRESSION = NONE
        FIELD_DELIMITER = """+delimitedBy+""" field_optionally_enclosed_by= '{{ table.exportInfo.file.fieldEnclosure.Replace("'","''") }}')single=true HEADER = """+headerRow+"""; {{ table.exportInfo.options }}"""
        snowsqlExport = copyStmt{%- br %}
        try:
         SFCursor = SFConnection.cursor()
         query_tag = WslPythonCommon.GetExtendedProperty("SF_QUERY_TAG", str(os.environ.get('WSL_EXP_TABLE',''))).strip()
         if query_tag and query_tag.strip():
            query_sql = f"ALTER SESSION SET QUERY_TAG = '{query_tag}'"
            SFCursor.execute(query_sql)
         maskedExport=SFCursor.execute(snowsqlExport).fetchall()
         SFCursor.close()
        except Exception as exceptionError:
            write_error("An error has occurred: : " + repr( exceptionError)){%- br %}
            raise exceptionError
        if str(os.environ.get('ACCESS_KEY',''))!="": {%- br %}
            snowsqlExport = snowsqlExport.replace(str(os.environ.get('ACCESS_KEY','')),'*' * len(str(os.environ.get('ACCESS_KEY','')))){%- br %}
        if str(os.environ.get('SECRET_KEY',''))!="": {%- br %}
            snowsqlExport = snowsqlExport.replace(str(os.environ.get('SECRET_KEY','')),'*' * len(str(os.environ.get('SECRET_KEY','')))){%- br %}
        rowsExported=maskedExport[0][0]{%- br %}
        if maskedExport[0][0] != 0:{%- br %}
            rowsExported = maskedExport[0][0]{%- br %}
            write_audit("\nExport:    " + snowsqlExport){%- br %}
            write_audit("\n"+str(rowsExported)+" rows exported"){%- br %}
            write_audit("Export successful. "+str(rowsExported)+" rows exported"){%- br %}
        else:{%- br %}
            write_audit("\nStatus returned from GET call:"+ getStatus){%- br %}
            if getMessage !="":{%- br %}
                write_audit("\nMessage returned from GET call: " +getMessage){%- br %}
            write_error("Export failed"){%- br %}
            raise Exception("Export failed")
    return(os.path.join(path,file)){%- br %}
try:  {%- br %}
    if os.environ.get('WSL_SERVER','') ==None: {%- br %}
        runMode = "Windows"
    {%- br %}
    else: {%- br %}
        if os.environ.get('WSL_SERVER','').find("s3://") == -1: {%- br %}
           runMode = "Windows"{%- br %}
        {%- br %}
        else:{%- br %}
           runMode = "S3"{%- br %}
    {%- br %}
    auditSrcFile=ExportData(runMode){%- br %}
    {%-  if (table.exportInfo.triggerFile.path != "") and ( table.exportInfo.triggerFile.name != "")  %}
    CreateTriggerFile(){%- br %}
    {%- endif %}
        {%  if (table.exportInfo.compressAfterExport  == true) %}{%- br %}
    write_audit(auditSrcFile)
    ArchiveFiles(auditSrcFile){%- br %}
    {%- endif %}{%- br %}
    {%- br %}
except Exception as e: {%- br %}
    write_error("Export Script Failed:" + str(e))
    write_error(traceback.format_exc())
    exitCode = 2
    exitMessage = 'Script run failed'
{%- br %}
else: {%- br %}
    exitCode = 0
    exitMessage = 'Script ran successfully'
{%- br %}
finally: {%- br %}
    exit_script(exitCode, exitMessage)
{%- br %}
