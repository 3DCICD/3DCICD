Import-module -Name WslPowershellCommon -DisableNameChecking{%br%}
Import-module -Name WslPowershellSnowflake -DisableNameChecking{%br%}
Hide-Window{%br%}

{%- set hasNonDssAfterLoads = false %}
{%- from table.columns as col where col.transformType.code == "A" and not col.dss %}
    {%- set hasNonDssAfterLoads = true -%}
{% endfrom %}

{% if (table.loadInfo.sourceConnectionType.name == "Configured Source Connection") and (table.loadInfo.sourceFile.path contains "GoogleDriveFiles")  %}
