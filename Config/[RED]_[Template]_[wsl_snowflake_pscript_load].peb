    # Function to download files from Google Drive will be called from WslPowershellTemplate{% br -%}
    Import-module -Name WslPowershellTemplate -DisableNameChecking{% br %}
  {%- endif -%}
{% endif %}

{# -- This macro returns an encapuslation character to be used based on the value provided by user -- #}
{% macro encapsulateString ( encString = "", encChars = "" ) %}
  {%- if (encChars | trim | length) > 0 -%}
    {%- set startChar = encChars | first  -%}
    {%- set endChar = encChars | last  -%}
    {%- if (startChar == encString | first) and ( endChar == encString | last ) -%}
      {{ encString }}
    {%- else -%}
      {{ startChar + encString + endChar }}
    {%- endif -%}
  {%- else -%}
    {{ encString }}
  {%- endif -%}
{% endmacro %}

function WriteAudit($message, $type="audit", $statusCode="I") {
    $outputJson = ConvertTo-Json @{message = $message; type = $type; statusCode = $statusCode} -Compress
    if(Test-IsInteractive){
      $logStream.WriteLine($outputJson)
    }
    else {
      [Console]::WriteLine($message)
    }
}

