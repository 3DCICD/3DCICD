{% if (table.loadInfo.sourceSchema != "") and (table.loadInfo.sourceTables != "") %}
# Source Schema    :    {{table.loadInfo.sourceSchema}}{%- br %}
# Source Table     :    {{table.loadInfo.sourceTables}}{%- br %}
{% endif %}
{% endif %}
