                    $logStream.WriteLine("Renaming is not supported for multi file loads"){%- br %}
                }{%- br %}
                {%- br %}
                $dir = Replace-WslTags(${ArchivePath}){%- br %}
                foreach($file in $files) { {%- br %}
                    try { {%- br %}
                        if( ! (Test-Path -Path $dir)) { {%- br %}
