                write_audit("Source rowcount "+str(loadTableProperties['rowCount'][1])+". "+str(rowsLoaded)+" rows loaded."){%- br %}
            else:
                write_error("Source and Target rowcount does not match. Source rowcount "+str(loadTableProperties['rowCount'][1])+". Target rowcount "+str(rowsLoaded)+".")
                raise Exception("Source and Target rowcount does not match. Source rowcount "+str(loadTableProperties['rowCount'][1])+". Target rowcount "+str(rowsLoaded)+".")
            {%- else %}{%- br %}
            write_audit("Load successful. "+str(rowsLoaded)+" rows loaded"){%- br %}
            {%- endif %}{%- br %}
