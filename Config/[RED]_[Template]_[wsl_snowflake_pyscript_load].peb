    'DEBUG': WslPythonCommon.GetExtendedProperty("SF_DEBUG_MODE",str(os.environ.get('WSL_LOAD_TABLE',''))).upper().strip(),
    'PURGE': WslPythonCommon.GetExtendedProperty("SF_PURGE",str(os.environ.get('WSL_LOAD_TABLE',''))),
