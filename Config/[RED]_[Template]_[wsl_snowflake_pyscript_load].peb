{% if RunMode == "S3" %}{%- br %}
# ========================================================
# = Amazon S3 Load Function
# ========================================================
def loadDataFromS3():
    # == Check If File Exists ============================================
    s3BucketName = loadTableProperties['s3BucketName']
    {%- if fileType == 'xlsx' %}{%- br %}
    sourceFilePath = loadTableProperties['sourceFilePath'] + "/" + loadTableProperties['sourceFileName']
    {%- else %}{% br %}
    sourceFilePath = loadTableProperties['sourceFilePath'] + "/" + loadTableProperties['sourceFileName']
    {%- endif %}{% br %}
    isSFileAvaliable = checkIfFileExistsOnS3(sourceFilePath)
    if isSFileAvaliable != True:
        write_error("File "+ sourceFilePath +" was not found. ")

    # == Wait For File To Arrive ============================================
    waitForSeconds = {{ table.loadInfo.waitSeconds }}{% br %}
    timeToWait = waitForSeconds
    timeout_start = time.time()
    while time.time() < timeout_start + timeToWait:
        time.sleep(1)
        isSFileAvaliable = checkIfFileExistsOnS3(sourceFilePath)
        if isSFileAvaliable == True:
            break
    isSFileAvaliable = checkIfFileExistsOnS3(sourceFilePath) {% br %}

    {% if table.loadInfo.triggerFile.name | trim != "" %}{% br %}
    # == Check If Trigger File Exists ============================================
    triggerFile = '{{ table.loadInfo.triggerFile.name }}' {% br %}
    triggerFilePath = '{{ table.loadInfo.triggerFile.path }} '.strip(){% br %}
    trgBucketName = loadTableProperties['s3BucketName'] + '/'
    {% br %}
    if triggerFilePath[-1] == "/": {% br %}
        triggerFilePath = triggerFilePath[0:-1] {% br %}
    {% br %}
    triggerFilePath = triggerFilePath + "/" + triggerFile{% br %}
    isTFileAvaliable = checkIfFileExistsOnS3(triggerFilePath)
    # == Wait For Trigger File To Arrive ============================================
    waitForSeconds = {{ table.loadInfo.waitSeconds }}{% br %}
    timeToWait = waitForSeconds
    timeout_start = time.time()
    while time.time() < timeout_start + timeToWait:
        time.sleep(1)
        isTFileAvaliable = checkIfFileExistsOnS3(triggerFilePath)
        if isTFileAvaliable == True:
            break
    isTFileAvaliable = checkIfFileExistsOnS3(triggerFilePath)

    # == Alert If Trigger Or Source File Found/Not Found ============================================{%- br %}
    fileName = '{{ table.loadInfo.triggerFile.name }}'
    if isTFileAvaliable==False: {%- br %}
    {%- if table.loadInfo.waitAction is defined %}{%- br %}
        {%- if table.loadInfo.waitAction.name == "Warning" %}{%- br %}
        print("-1"){%- br %}
        {%- elseif table.loadInfo.waitAction.name == "Error" %}
        print("-2"){%- br %}
        {%- elseif table.loadInfo.waitAction.name == "Fatal Error" %}
        print("-3"){%- br %}
        {%- elseif table.loadInfo.waitAction.name == "Success" %}
        print("1") {%- br %}
        {%- endif %}
    {%- else %}{%- br %}
    print("-1")
    {%- endif %}{%- br %}
        status_code = {"Success": "S", "Warning": "W", "Error": "E", "Fatal Error": "E"}.get(loadTableProperties['waitAction'], "E")
        exitCode = {"Success": 0, "Warning": -1, "Error": 2, "Fatal Error": -3}.get(loadTableProperties['waitAction'], 2)
        exitMessage = "File "+ fileName +" was not found after waiting for "+str(waitForSeconds)+" seconds."
        write_audit(exitMessage, "audit", status_code)
        if loadTableProperties['waitAction'] in ["Warning", "Success"]:
            sys.exit()
        raise Exception(exitMessage)
    {%- endif %}{% br %}

    fileName = sourceFilePath
    if isSFileAvaliable==False: {%- br %}
    {%- if table.loadInfo.waitAction is defined %}{%- br %}
        {%- if table.loadInfo.waitAction.name == "Warning" %}{%- br %}
        print("-1"){%- br %}
        {%- elseif table.loadInfo.waitAction.name == "Error" %}
        print("-2"){%- br %}
        {%- elseif table.loadInfo.waitAction.name == "Fatal Error" %}
        print("-3"){%- br %}
        {%- elseif table.loadInfo.waitAction.name == "Success" %}
        print("1") {%- br %}
        {%- endif %}
    {%- else %}{%- br %}
    print("-1")
    {%- endif %}{%- br %}
        status_code = {"Success": "S", "Warning": "W", "Error": "E", "Fatal Error": "E"}.get(loadTableProperties['waitAction'], "E")
        exitCode = {"Success": 0, "Warning": -1, "Error": 2, "Fatal Error": -3}.get(loadTableProperties['waitAction'], 2)
        exitMessage = "File "+ sourceFilePath +" was not found after waiting for "+str(waitForSeconds)+" seconds."
        write_audit(exitMessage, "audit", status_code)
        if loadTableProperties['waitAction'] in ["Warning", "Success"]:
            sys.exit()
        raise Exception(exitMessage)

    {% if (table.loadInfo.archiveFile.path != "") or (table.loadInfo.triggerFile.name != "") %}{% br %}
    # == Archive Source File ============================================
    {% if (table.loadInfo.archiveFile.path|trim != "")%}{% br %}
    s3SourcePath = '{{ table.loadInfo.sourceFile.path }} '.strip(){% br %}
    s3SourceFileName = '{{ table.loadInfo.sourceFile.name }}'{% br %}
    arcSourceFilePath = '{{table.loadInfo.archiveFile.path}} '.strip(){% br %}
    arcSourceFileName = '{{table.loadInfo.archiveFile.name}}'{% br %}
    {% br %}
    if s3SourcePath[-1] == "/":
        s3SourcePath = s3SourcePath[0:-1]

    if arcSourceFilePath[-1] == "/":
        arcSourceFilePath = arcSourceFilePath[0:-1]

    s3SourcePath = s3SourcePath + "/" + s3SourceFileName
    arcSourceFilePath = arcSourceFilePath + "/" + arcSourceFileName
    {%- endif %}{% br %}

    {% if (table.loadInfo.triggerFile.name != "") and (table.loadInfo.triggerArchiveFile.path != "")%}{% br %}
    # == Archive Trigger File ============================================
    s3TriggerPath = '{{ table.loadInfo.triggerFile.path }} '.strip(){% br %}
    s3TriggerFileName = '{{ table.loadInfo.triggerFile.name }}'{% br %}
    arcTriggerPath = '{{table.loadInfo.triggerArchiveFile.path}} '.strip(){% br %}
    arcTriggerFileName = '{{table.loadInfo.triggerArchiveFile.name}}'{% br %}

    if s3TriggerPath[-1] == "/":
        s3TriggerPath = s3TriggerPath[0:-1]

    if arcTriggerPath[-1] == "/":
        arcTriggerPath = arcTriggerPath[0:-1]

    s3TriggerPath = s3TriggerPath + "/" + s3TriggerFileName
    arcTriggerPath = arcTriggerPath + "/" + arcTriggerFileName
    {%- endif %}{% br %}
    {%- endif %}{% br %}

    {% block "GetExtendedProperty_s3prefix" %}{%br%}
    s3prefix = WslPythonCommon.GetExtendedProperty("SF_S3_BUCKET_PREFIX",str(os.environ.get('WSL_LOAD_TABLE',''))){%- br %}
    {% endblock %}

   # == Load Amazon S3 From Windows Connection ============================================
    if s3prefix.startswith("s3://"):
        s3PrefixPath = s3prefix.replace("/ ","").strip() + sourcefilename
        prefixResult = loadAllFiles()

    # == Load Amazon S3 From Browse Script ============================================
    else:
        # == Get File Format And Load Data Using Copy Command ============================================
        {%- if fileType == 'xlsx' %}{%- br %}
        WslPythonCommon.downloadFileFromAmazonS3(loadTableProperties['awsAccessKey'],loadTableProperties['awsSecretKey'],loadTableProperties['s3RegionName'],loadTableProperties['s3BucketName'],
        loadTableProperties['sourceFilePath'],loadTableProperties['sourceFileName'], os.environ.get('WSL_WORKDIR','')){%- br %}
        ExcelToCsv (os.environ.get('WSL_WORKDIR',''),loadTableProperties){%- br %}
        putSQL = "PUT file://" +os.path.join(os.environ.get('WSL_WORKDIR',''),loadTableProperties['sourceFileNameCsv'])+" @~/WSL-"+str(os.environ.get('WSL_SEQUENCE',''))+"-"+str(os.environ.get('WSL_TASK_KEY',''))+"/ ;"
        try:{%- br %}
                executeSnowflakeQuery(putSQL)
        except Exception as exceptionError:{%- br %}
                write_error("An error has occurred:PUT Command Failed " + repr( exceptionError))
                raise exceptionError

        s3Result = loadAllFiles(" @~/WSL-"+str(os.environ.get('WSL_SEQUENCE',''))+"-"+str(os.environ.get('WSL_TASK_KEY',''))+"/"+" t")
              {%- else %}{%- br %}
        s3Result = loadAllFiles()
          {%- endif %}{% br %}
        {% if (table.loadInfo.archiveFile.path != "")%}{% br %}
        # == Check if Source File Archive Successful ============================================{% br %}
        if s3Result == 1:
            if checkIfFileExistsOnS3(sourceFilePath) == True:
                arcSourceFilePath = WslPythonCommon.ReplaceWslTags(arcSourceFilePath)
                arcSResult = archiveFileAfterLoadS3(s3SourcePath, arcSourceFilePath)
                if(arcSResult):
                    write_audit("File archive successful"){%- br %}
                    write_audit(s3SourcePath + " file archived"){%- br %}
                else:
                    write_audit("File Archive Successful, Failed to Move source file"){%- br %}
            else:
                write_error("Source File Archive Failed"){%- br %}
        {%- endif %}{% br %}

        {% if  (table.loadInfo.triggerFile.name != "") and (table.loadInfo.triggerArchiveFile.path != "") %}{% br %}
        # == Check if Trigger File Archive Successful ============================================
        if checkIfFileExistsOnS3(triggerFilePath) == True:
            arcTriggerPath = WslPythonCommon.ReplaceWslTags(arcTriggerPath)
            arcTResult = archiveFileAfterLoadS3(s3TriggerPath, arcTriggerPath)
            if(arcTResult):
                write_audit("File trigger archive successful"){%- br %}
                write_audit(s3TriggerPath + " file archived"){%- br %}
            else:
                write_error("File Archive Successful, Failed to Move trigger file"){%- br %}
        else:
            write_error("Trigger File Archive Failed"){%- br %}
        {%- endif %}{% br %}
{%- endif %}

{% if RunMode == "AZ" %}{%- br %}
def loadDataFromAzure():
        {%- if fileType == 'xlsx' %}{%- br %}
        WslPythonCommon.downloadFileFromAzureDataLake(loadTableProperties['azureStorageAccountName'],loadTableProperties['azureStorageAccountAccessKey'],loadTableProperties['azureStorageFileSystem'],'',loadTableProperties['sourceFileName'],os.environ.get('WSL_WORKDIR','')){%- br %}
        ExcelToCsv (os.environ.get('WSL_WORKDIR',''),loadTableProperties){%- br %}
        putSQL = "PUT file://" +os.path.join(os.environ.get('WSL_WORKDIR',''),loadTableProperties['sourceFileNameCsv'])+" @~/WSL-"+str(os.environ.get('WSL_SEQUENCE',''))+"-"+str(os.environ.get('WSL_TASK_KEY',''))+"/ ;"
        try:{%- br %}
                executeSnowflakeQuery(putSQL)
        except Exception as exceptionError:{%- br %}
                write_error("An error has occurred:PUT Failed " + repr( exceptionError))
                raise exceptionError
        loadAllFiles(" @~/WSL-"+str(os.environ.get('WSL_SEQUENCE',''))+"-"+str(os.environ.get('WSL_TASK_KEY',''))+"/"+" t")
              {%- else %}{%- br %}
         loadAllFiles()
                {%- endif %}
{%- endif %}

{% if RunMode == "GCS" %}{%- br %}
def loadDataFromGoogleCloud():
    loadTableProperties['gcsFilePath'] = f"{loadTableProperties['gcsFileDetails']}/{loadTableProperties['sourceFileName']}"
    {% if getExtendedProperty( propertyName = "GCS_STORAGE_INTEGRATION" ) | trim != ""-%}{%- br %}
    # == Get Staged File List ============================================
    gcsStageList = executeSnowflakeQuery(f"list @{str(extendedProperty['GCS_STAGE_AREA_NAME'])}")
    gcsFileList = [i[0] for i in gcsStageList]
    if loadTableProperties['gcsFilePath'] in gcsFileList:
        loadAllFiles()
    {% else %}
    {%- if fileType == 'xlsx' %}{%- br %}
    WslPythonCommon.downloadFileFromGoogleCloudV2(loadTableProperties['sourceFilePath'],loadTableProperties['sourceFileName'],os.environ.get('WSL_WORKDIR','')){%- br %}
    ExcelToCsv (os.environ.get('WSL_WORKDIR',''),loadTableProperties){%- br %}
    putSQL = "PUT file://" +os.path.join(os.environ.get('WSL_WORKDIR',''),loadTableProperties['sourceFileNameCsv'])+" @~/WSL-"+str(os.environ.get('WSL_SEQUENCE',''))+"-"+str(os.environ.get('WSL_TASK_KEY',''))+"/ ;"
    try:{%- br %}
            executeSnowflakeQuery(putSQL)
    except Exception as exceptionError:{%- br %}
            write_error("An error has occurred:PUT Failed " + repr( exceptionError))
            raise exceptionError
    loadAllFiles(" @~/WSL-"+str(os.environ.get('WSL_SEQUENCE',''))+"-"+str(os.environ.get('WSL_TASK_KEY',''))+"/"+" t")
          {%- else %}{%- br %}
    loadAllFiles()
    {%- endif %}{% br %}
    {%- endif %}
{%- endif %}



{% if (RunMode == "Windows") or (RunMode == "GD") or (RunMode == "REST") %}{%- br %}
# ========================================================
# = Windows Pattern Based Check File Exist
# ========================================================
# Check if file exists in directory based on file pattern


def checkFileExistsInDirectory(filePattern, directoryPath):

    # Get all files from directory
    files = os.listdir(directoryPath)
    filesFound = []

    # Check if file exists
    for file in files:
        if re.match(filePattern, file):
            filesFound.append(file)
        else:
            if fnmatch.fnmatch(file, filePattern):
                filesFound.append(file)

    if len(filesFound) == 0:
        return False
    else:
        return filesFound

def loadDataFromWindows(sourceFileName, sourceFilePath):
    newName=""
    if str(extendedProperty['EXTERNAL_STAGE']) =="":
        sourceFilePath = sourceFilePath.strip(){%- br %}
        if sourceFilePath.count("\ ".strip()) == 1:
            sourceFilePath =sourceFilePath.replace("\ ","").strip(){%- br %}
        loadFile = os.path.join(sourceFilePath,sourceFileName){%- br %}
        {%- if table.loadInfo.triggerFile.name|trim != "" %}
        triggerFile = os.path.join( r'{{ table.loadInfo.triggerFile.path }} '.replace("\ ","").strip(), '{{ table.loadInfo.triggerFile.name }}'){% br %}
        {%- endif %}
        {% br %}
        {%- if table.loadInfo.wait %}
        # Wait Timer Check
        # If a wait time specified then loop looking for the file
        # or trigger file to arrive until the wait time expires.
        {% br %}
        {%- if table.loadInfo.triggerFile.name|trim != "" %}
        waitForFileName = triggerFile{% br %}
        {%- else %}
        waitForFileName = loadFile{% br %}
        {%- endif %}
        waitForSeconds = {{ table.loadInfo.waitSeconds }}{% br %}
        timeToWait = waitForSeconds
        timeCounter =0{% br %}
        while not os.path.exists(waitForFileName):
            time.sleep(1)
            timeCounter += 1
            if timeCounter > timeToWait:
                break
        # Finished our wait loop. See if we have the file
        {% br %}
        {%- endif %}
        # File Check
        {% if table.loadInfo.triggerFile.name|trim != "" %}{% br %}
        fileCheck = triggerFile{% br %}
        {%- else -%}
        fileCheck = loadFile{% br %}
        {%- endif -%}{% br %}
        dataFiles = []{% br %}

        #Check if file exits in directory based on file name
        for f in glob.iglob(os.path.join(sourceFilePath,sourceFileName)):{% br %}
            dataFiles.append(f){% br %}

        #Check if file exist in directory based on file pattern
        if len(dataFiles) == 0:
            filesFound = checkFileExistsInDirectory(sourceFileName, sourceFilePath)
            if filesFound != False:
                dataFiles = filesFound
            else:
                dataFiles = []
        {% if table.loadInfo.triggerFile.name|trim != "" %}{% br %}
        if os.path.exists(triggerFile)==False:{%- br %}
            {%- if table.loadInfo.waitAction is defined %}
              {%- if table.loadInfo.waitAction.name == "Warning" %}
              print("-1"){%- br %}
              {%- elseif table.loadInfo.waitAction.name == "Error" %}
              print("-2"){%- br %}
              {%- elseif table.loadInfo.waitAction.name == "Fatal Error" %}
              print("-3"){%- br %}
              {%- elseif table.loadInfo.waitAction.name == "Success" %}
              print("1") {%- br %}
              {%- endif %}
            {%- else %}
              print("-1")
            {%- endif %}
              status_code = {"Success": "S", "Warning": "W", "Error": "E", "Fatal Error": "E"}.get(loadTableProperties['waitAction'], "E")
              exitCode = {"Success": 0, "Warning": -1, "Error": 2, "Fatal Error": -3}.get(loadTableProperties['waitAction'], 2)
              exitMessage = "File "+ triggerFile +" was not found after waiting for "+str({{ table.loadInfo.waitSeconds }})+" seconds."
              write_audit(exitMessage, "audit", status_code)
              if loadTableProperties['waitAction'] in ["Warning", "Success"]:
                  sys.exit()
              raise Exception(exitMessage)
        {%- endif -%}
        {%- br %}

        if len(dataFiles)==0:{%- br %}
            {%- if table.loadInfo.waitAction is defined %}
              {%- if table.loadInfo.waitAction.name == "Warning" %}
              print("-1"){%- br %}
              {%- elseif table.loadInfo.waitAction.name == "Error" %}
              print("-2"){%- br %}
              {%- elseif table.loadInfo.waitAction.name == "Fatal Error" %}
              print("-3"){%- br %}
              {%- elseif table.loadInfo.waitAction.name == "Success" %}
              print("1"){%- br %}
              {%- endif %}
            {%- else %}
              print("-1")
            {%- endif %}
              status_code = {"Success": "S", "Warning": "W", "Error": "E", "Fatal Error": "E"}.get(loadTableProperties['waitAction'], "E")
              exitCode = {"Success": 0, "Warning": -1, "Error": 2, "Fatal Error": -3}.get(loadTableProperties['waitAction'], 2)
              exitMessage = "File "+ loadFile +" was not found after waiting for "+str({{ table.loadInfo.waitSeconds }})+" seconds."
              write_audit(exitMessage, "audit", status_code)
              if loadTableProperties['waitAction'] in ["Warning", "Success"]:
                  sys.exit()
              raise Exception(exitMessage)

        sourceFiles=[]{% br %}
        sourceFiles.extend(dataFiles){% br %}
        rowCount = 0 {%- br %}
        dataFilesCopy = dataFiles
        originalDat = sourceFileName

        cleanedDat = originalDat.replace("*",""){% br %}
        {%- if not ['json','parquet','avro','xml','csv','Excel','xlsx','orc'] contains fileType -%}{% br %}
        dataFiles = []
        for sourceFile in dataFilesCopy:
                rowCount = 0
                try:
                  if extendedProperty['UNICODE_SUPPORT']=="TRUE":
                   with open(sourceFile, 'r', encoding='utf-8') as f:
                    for line in f:
                      rowCount += 1
                  else:
                   with open(sourceFile, 'r') as f:
                    for line in f:
                      rowCount += 1
                  if loadTableProperties['fieldHeading']=="true":
                      rowCount =rowCount-1
                  cleanedDat = originalDat.replace("*","")
                  if int(extendedProperty['FILE_COUNT']) > 1:
                      sourceFilePath = loadTableProperties['WSL_WORKDIR']
                      if rowCount > int(extendedProperty['SPLIT_THRESHOLD']):
                          fileToSplit = sourceFile
                          i=0
                          while i < int(extendedProperty['FILE_COUNT']):
                              threeDigits = str(i)
                              newName = sourceFile.replace(cleanedDat,cleanedDat + "_" + os.environ.get('WSL_SEQUENCE','') + "-" + os.environ.get('WSL_TASK_KEY','') + "_p" + threeDigits)
                              splitPath =os.path.join(loadTableProperties['WSL_WORKDIR'],newName)
                              dataFiles.append(splitPath)
                              swl.append(sw)
                              write_audit("Source file "+newName)
                              i=i+1
                          swNum = 0
                          if loadTableProperties['fieldHeading'] == "true":
                              headerLine = fileToSplit.readline()
                              for sw in swl:
                                sw.writelines(headerLine)
                          while True:
                              line = fileToSplit.readline().strip()
                              if line=="":
                                 break
                              if swNum >=extendedProperty['FILE_COUNT']:
                                  swNum = 0
                              swl[swNum].writelines(line);
                              swNum=swNum+1
                      else:
                          newName = sourceFile.replace(cleanedDat,cleanedDat + "_" + os.environ.get('WSL_SEQUENCE','')+ "-" + os.environ.get('WSL_TASK_KEY','') + "_p000")
                          notSplitPath = os.path.join(oadTableProperties['WSL_WORKDIR'],newName)
                          sourceFile=notSplitPath
                          dataFiles.append(notSplitPath)
                          write_detail("Source file "+sourceFile+" Part 000: "+notSplitPath)
                      sourceFileName = cleanedDat + "_" + os.environ.get('WSL_SEQUENCE','') + "-" + os.environ.get('WSL_TASK_KEY','') + "*"
                  else:
                    dataFiles.append(sourceFile)
                except Exception as exceptionError:{%- br %}
                   write_error("File "+ fileCheck +" was not found. ")
                   raise exceptionError
            {%- endif %} {%- br %}

        loadTableProperties['dataFileList'] =  dataFiles
        loadTableProperties['cleanedDataFile'] = cleanedDat
        loadTableProperties['sourceFiles'] = sourceFiles or []
    {%- br %}
    else: {%- br %}
        sourceFilePath = sourcePrefix{%- br %}
        if sourceFilePath.endswith('\\')==False:{%- br %}
            sourceFilePath =sourceFilePath+ '\\'{%- br %}
        loadTableProperties['dataFileList'] =  []{%- br %}

    loadTableProperties['sourceFileName'] = sourceFileName
    loadTableProperties['sourceFilePath'] = sourceFilePath

{%- endif %}



{% if (RunMode == "Database") or (RunMode == "Windows") or (RunMode == "GD") or (RunMode == "REST")%}{%- br %}
def loadDataUsingLocalFile(sourceFilePath, sourceFileName,dataFileList):
    dataFiles = dataFileList
    fileFormat = getFileFormat()
    {%- if fileType != 'xlsx' %}{% br %}
    if extendedProperty['EXTERNAL_STAGE'] == "":
        x=0{% br %}
        while x< len(dataFiles):{% br %}
            originalName = dataFiles[x]{% br %}
            if extendedProperty['SEND_FILES_ZIPPED'] == "TRUE":{% br %}
               {%- if (RunMode == "Windows" or RunMode == "REST") %}{% br %}
               noPath=os.path.basename(dataFiles[x]){% br %}
               if int(extendedProperty['FILE_COUNT']) < 2:
                  noPath = noPath.replace(loadTableProperties['cleanedDataFile'],loadTableProperties['cleanedDataFile'] + "_" + os.environ.get('WSL_SEQUENCE','') + "-" + os.environ.get('WSL_TASK_KEY','')){% br %}
               dataFiles[x]=WslPythonCommon.GzipFile(dataFiles[x],os.path.join(loadTableProperties['WSL_WORKDIR'],noPath),False,"{{fileType}}"){% br %}
               sourceFilePath=loadTableProperties['WSL_WORKDIR']{% br %}
               {%- else %}
               dataFiles[x]=WslPythonCommon.GzipFile(dataFiles[x],'.gz',True,"{{fileType}}"){% br %}
               {%- endif %}{% br %}
                {%- if (RunMode == "Windows" or RunMode == "REST") %}{% br %}
               loadTableProperties['sourceFilePath'] = sourceFilePath{% br %}
               write_audit("File "+originalName+" GZipped to " + noPath+" prior to upload"){% br %}
               {%- else %}
               write_audit("File "+ originalName +" GZipped to "+ dataFiles[x] +" prior to upload") {% br %}
               {%- endif %}
            x=x+1 {% br %}


    {%- if (RunMode == "Windows" ) or (RunMode == "GD") or (RunMode == "REST") %}
    #====Only For Windows====== {% br %}
    if int(os.environ.get('FILE_COUNT',0)) < 2:
        if extendedProperty['SEND_FILES_ZIPPED'] == "TRUE": {% br %}
            sourceFileName = loadTableProperties['cleanedDataFile'] + "_" + os.environ.get('WSL_SEQUENCE','') + "-" + os.environ.get('WSL_TASK_KEY','') + "*"
            loadTableProperties['sourceFileName'] = sourceFileName
        {%- br %}
    #====Only For Windows====== {% br %}
    {%- endif %}
        {%- endif %}{% br %}
    write_audit("================= LOAD ================="){% br %}

    if extendedProperty['EXTERNAL_STAGE'] =="": {% br %}
        externalStageName = "@~/WSL-"+str(os.environ.get('WSL_SEQUENCE',''))+"-"+str(os.environ.get('WSL_TASK_KEY',''))+"/"+" t" {% br %}
    else: {% br %}
        if sourceFileName.strip() == "":
            externalStageName="@"+ extendedProperty['EXTERNAL_STAGE'] +"/"+" t" {% br %}
        else:
            externalStageName="@"+ extendedProperty['EXTERNAL_STAGE'] +"/"+sourceFileName/+" t" {% br %}

    if (runMode != "S3" and runMode != "AZ" and runMode != "GCS") or extendedProperty['EXTERNAL_STAGE'] !="":{% br %}
        if runMode != "S3" and runMode != "AZ" and runMode != "GCS" and extendedProperty['EXTERNAL_STAGE'] =="":{% br %}
            #CLEAN UP SNOWFLAKE STAGE FILES

            removeSQL = "remove @~/WSL-"+str(os.environ.get('WSL_SEQUENCE',''))+"-"+str(os.environ.get('WSL_TASK_KEY',''))+"*"+";"{% br %}
            try:
                executeSnowflakeQuery(removeSQL)
            except Exception as exceptionError:
                write_error("Failed to clean up file from snowflake stage"){%- br %}
            {% br %}
            {%- if fileType != 'xlsx' %}
            if extendedProperty['SEND_FILES_ZIPPED'] == "TRUE":{% br %}
                putSQL = r"PUT 'file://" +os.path.join(sourceFilePath,sourceFileName).replace(os.sep, '/'){%- if ((RunMode != "Windows") and (RunMode != "REST") ) %}.replace("."+sourceFileName.split(".")[-1],"")+r"*.gz'"{%- else %} +r".gz'"{%- endif %}+" @~/WSL-"+str(os.environ.get('WSL_SEQUENCE',''))+"-"+str(os.environ.get('WSL_TASK_KEY',''))+"/ ;"{% br %}
            else:{% br %}
                putSQL = r"PUT 'file://" +os.path.join(sourceFilePath,sourceFileName).replace(os.sep, '/'){%- if ((RunMode != "Windows") and (RunMode != "REST") )  %}.replace("."+sourceFileName.split(".")[-1],"")+r"*'"{%- else %}+r"'"{%- endif %}+" @~/WSL-"+str(os.environ.get('WSL_SEQUENCE',''))+"-"+str(os.environ.get('WSL_TASK_KEY','')){% if (RunMode == "Windows") or (RunMode == "REST") %}+"/ AUTO_COMPRESS=FALSE"{%- endif %}+";"{% br %}
            {%- else %}
            ExcelToCsv (sourceFilePath,loadTableProperties){% br %}
            if extendedProperty['SEND_FILES_ZIPPED'] == "TRUE":{% br %}
               WslPythonCommon.GzipFile(os.path.join(os.environ.get('WSL_WORKDIR',''),loadTableProperties['sourceFileNameCsv']),'.gz',True,"{{fileType}}"){% br %}
               putSQL = "PUT 'file://" +os.path.join(os.environ.get('WSL_WORKDIR',''),loadTableProperties['sourceFileNameCsv'].split(".")[0]).replace(os.sep, '/')+r"*.gz'"+" @~/WSL-"+str(os.environ.get('WSL_SEQUENCE',''))+"-"+str(os.environ.get('WSL_TASK_KEY',''))+"/ ;"{% br %}
            else:{% br %}
              putSQL = "PUT file://" +os.path.join(os.environ.get('WSL_WORKDIR',''),loadTableProperties['sourceFileNameCsv']).replace(os.sep, '/')+" @~/WSL-"+str(os.environ.get('WSL_SEQUENCE',''))+"-"+str(os.environ.get('WSL_TASK_KEY','')){% if RunMode == "Windows" or RunMode == "REST" %}+"/ AUTO_COMPRESS=FALSE"{%- endif %}+";"{% br %}
           {%- endif %}
            try:
                executeSnowflakeQuery(putSQL)
            except Exception as exceptionError:
                write_error("File "+ fileCheck +" was not found. ")
                raise exceptionError

            write_detail("BEGIN PUT of files matching" +sourceFilePath+sourceFileName+" : "+str(datetime.now())+''){% br %}
            write_audit("PUT:"){% br %}
            write_audit(putSQL){% br %}
            write_audit(""){% br %}

            write_detail("END PUT of files matching " +sourceFileName+" : "+str(datetime.now())+''){% br %}

            alterTimeZone()
            loadAllFiles(externalStageName){%- br %}
        else:{% br %}
        {%- set noindent = "" %}
            alterTimeZone()
            loadAllFiles(externalStageName){%- br %}
        {%- if (table.loadInfo.archiveFile.path != "") or (table.loadInfo.archiveFile.name != "") and (table.loadInfo.sourceConnectionType.name == "Windows") or (table.loadInfo.sourceConnectionType.name == "REST")%}
        if loadTableProperties['sourceFiles'] == []:
            write_audit("Source file empty or not found. Archive Failed" +''){% br %}
        else:
            archiveFileAfterLoadWindows(loadTableProperties['sourceFiles'],runMode){%- br %}
        {%- endif %}
        {%- if ((table.loadInfo.triggerArchiveFile.path != "") or (table.loadInfo.triggerArchiveFile.name != "")) and (RunMode == "Windows" or RunMode == "GD" or RunMode == "REST") %}
        windowsArchiveTrigger([os.path.join('{{ table.loadInfo.triggerFile.path }} '.replace("\ ","").strip(),'{{ table.loadInfo.triggerFile.name }}')]){%- br %}
        {%- endif %}
{%- endif %}

{% if RunMode == "GD" %}{%- br %}
def loadDataFromGoogleDrive():
    WslPythonTemplate.GoogleDriveLoad("{{table.loadInfo.uiConfigLoadProperties.fileID}}", r'$WSL_SRCCFG_googleDriveCredentialsFilePath$'){% br %}
    loadDataFromWindows(loadTableProperties['sourceFileName'], loadTableProperties['sourceFilePath']) {%- br %}
