               {%- endif -%}
         {%- set flattenObjectBrackets = "[]"-%}
                 {%- set flattenObjectBracketsWithDot = "[]."-%}
               {%- if  colName contains flattenObjectBrackets -%}
               {%- set flattenObject = colName.split("\[\].") | first | replace({"[":""}) -%}
         {{flattenObject}}
               {%- set flattenReplace = flattenObject -%}
               value:"{{colName  | replace({flattenObject:"",flattenObjectBrackets:"",flattenObjectBracketsWithDot:""}) }}"{%br%}

               {%- elseif col.transform != '' -%}
               CAST(NULL AS {{col.dataType}}){%br%}
               {%- elseif fileType == 'csv' -%}
               {{col.name}}{%br%}
               {%- elseif fileType == 'xml' %}
               {%- set columnNameLast = colName.split("\.") | last -%}
