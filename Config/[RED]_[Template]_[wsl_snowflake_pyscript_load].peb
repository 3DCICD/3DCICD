# ========================================================
# = Create Load Properties Object For Source Connection
# ========================================================
loadTableProperties = {}

# -- Header --------------------------------------------
if "{{ table.loadInfo.sourceFile.headerLine }}" == "true":
    loadTableProperties['fieldHeading'] = 1
elif "{{ table.loadInfo.sourceFile.headerLine }}" == "false":
    loadTableProperties['fieldHeading'] = 0


{% block "SourceFilePath" %}{%br%}
# -- Source Path --------------------------------------------
loadTableProperties['sourceFilePath'] = r"{{ table.loadInfo.sourceFile.path }} ".strip()
{% if RunMode != "Database" %}
if loadTableProperties['sourceFilePath'][-1] == "/":
    loadTableProperties['sourceFilePath'] = loadTableProperties['sourceFilePath'][:-1]
{%- endif %}
{% endblock %}

# -- Field Enclosure --------------------------------------------
loadTableProperties['sourceFileFieldEnclosure'] = '{{table.loadInfo.sourceFile.fieldEnclosure}}'
if loadTableProperties['sourceFileFieldEnclosure'].strip() == "":
    loadTableProperties['sourceFileFieldEnclosure'] = '"'

# -- Record Delimiter --------------------------------------------
loadTableProperties['sourceFileRecordDelimiter'] = """{{table.loadInfo.sourceFile.recordDelimiter}}"""
if loadTableProperties['sourceFileRecordDelimiter'].strip() =="":
    loadTableProperties['sourceFileRecordDelimiter'] ="\\n"

# -- Field Delimiter --------------------------------------------
loadTableProperties['sourceFileFieldDelimiter'] = '{{table.loadInfo.sourceFile.fieldDelimiter}}'

# -- File Name --------------------------------------------
{%- if fileType == 'xlsx' %}
{%br%}
loadTableProperties['sourceFileName'] = r'{{ table.loadInfo.sourceFile.name }}'.split(".")[0]+"."+r'{{ table.loadInfo.sourceFile.name }}'.split(".")[2]
loadTableProperties['sourceFileSheetName'] = r'{{ table.loadInfo.sourceFile.name }}'.split(".")[1]
loadTableProperties['sourceFileNameCsv'] = r'{{ table.loadInfo.sourceFile.name }}'.split(".")[0]+".csv"
{%- else -%}
{%br%}
loadTableProperties['sourceFileName'] = r'{{ table.loadInfo.sourceFile.name }}'
{%- endif %}

# -- File Type(Parser) --------------------------------------------
loadTableProperties['fileType'] = r'{{fileType}}'

{%- if (table.loadInfo.wait == true) %}{%br%}
# -- Wait Time --------------------------------------------
loadTableProperties['waitTime'] = {{table.loadInfo.waitSeconds}}{%br%}
{%- else -%}
{%br%}
loadTableProperties['waitTime'] = 1{%br%}
{%- endif %}

{%- if (table.loadInfo.waitAction.name != "") %}{%br%}
# -- Wait Time --------------------------------------------
loadTableProperties['waitAction'] = "{{table.loadInfo.waitAction.name}}"{%br%}
{%- else -%}
{%br%}
loadTableProperties['waitAction'] = "Error"{%br%}
{%- endif %}

# Assign key-value pair to load table property object
loadTableProperties['targetTableName'] = str(os.environ.get('WSL_LOAD_FULLNAME',''))
loadTableProperties['WSL_WORKDIR'] = os.environ.get('WSL_WORKDIR','')
loadTableProperties['auditLog'] = str(os.environ.get('WSL_LOAD_TABLE',''))+"_"+str(os.environ.get('WSL_SEQUENCE',''))+".txt"

{% if (RunMode == "S3") %}
# -- Load Properties For Amazon S3  --------------------------------------------
loadTableProperties['awsAccessKey']=str(os.environ.get('ACCESS_KEY',''))
if loadTableProperties['awsAccessKey'].strip() =="":
    loadTableProperties['awsAccessKey']=str('$WSL_SRCCFG_s3AccessKey$')

loadTableProperties['awsSecretKey']=str(os.environ.get('SECRET_KEY',''))
if loadTableProperties['awsSecretKey'].strip() =="":
   loadTableProperties['awsSecretKey']=str(os.environ.get('WSL_SRCCFG_s3SecretKey'))

loadTableProperties['s3FileDetails'] = loadTableProperties['sourceFilePath'].replace("/ ","").strip()+"/" + loadTableProperties['sourceFileName']
loadTableProperties['s3RegionName'] = str('$WSL_SRCCFG_s3Region$')
loadTableProperties['s3BucketName'] = loadTableProperties['sourceFilePath'].replace("s3://","").split("/")[0]

if loadTableProperties['sourceFilePath'][-1] == "/":
    loadTableProperties['sourceFilePath'] = loadTableProperties['sourceFilePath'][0:-1]

{% elseif (RunMode == "Windows") and (getExtendedProperty( propertyName = "SF_S3_BUCKET_PREFIX" ) != "") %}
# -- Load Properties For S3 Prefix --------------------------------------------
loadTableProperties['awsAccessKey']=str(r"{{ getExtendedProperty( propertyName = "SF_ACCESS_KEY") }}")
loadTableProperties['awsSecretKey']=str(r"{{ getExtendedProperty( propertyName = "SF_SECRET_KEY") }}")
loadTableProperties['s3FileDetails'] = str(r"{{ getExtendedProperty( propertyName = "SF_S3_BUCKET_PREFIX") }}").replace("/ ","").strip() + loadTableProperties['sourceFileName']

{% elseif (RunMode == "AZ") %}
# -- Load Properties For Azure --------------------------------------------
azureSasToken = str(os.environ.get('AZ_SAS_TOKEN',''))
if azureSasToken.strip() =="":
    azureSasToken = str(os.environ.get('WSL_SRCCFG_azureSASToken'))
azureFileDetails = r"{{ table.loadInfo.sourceFile.path }}".strip().replace("https","azure").replace("dfs.core.windows.net","blob.core.windows.net").replace("/ ","").strip()+"/"+loadTableProperties['sourceFileName']
loadTableProperties['azureStorageAccountAccessKey'] = str(os.environ.get('WSL_SRCCFG_azureStorageAccountAccessKey'))
loadTableProperties['azureSasToken'] = azureSasToken
loadTableProperties['azureFileDetails'] = azureFileDetails
loadTableProperties['azureStorageAccountName']=str(os.environ.get('WSL_SRCCFG_azureStorageAccountName'))
loadTableProperties['azureStorageFileSystem']=str(r"{{ table.loadInfo.sourceFile.path }}".split("net")[1]) #str(os.environ.get('WSL_SRCCFG_azureStorageFileSystem'))
loadTableProperties['azureStorageFileSystemDirectory']=str(os.environ.get('WSL_SRCCFG_azureStorageFileSystemDirectory'))

{% elseif (RunMode == "GCS") %}
# -- Load Properties For Google Cloud Storage --------------------------------------------
loadTableProperties['gcsFileDetails'] = loadTableProperties['sourceFilePath'].replace("gs://", "gcs://")

{% elseif (RunMode == "REST") %}
# -- Load Properties REST API --------------------------------------------
loadTableProperties['restApiUrl'] = r"{{ restUrl }}"
loadTableProperties['restApiUserId'] = "$WSL_SRCCFG_APIUserId$".strip()
loadTableProperties['restApiPass'] = os.environ.get("WSL_SRCCFG_ApiPassword")
loadTableProperties['restApiHeader'] =  os.environ.get("WSL_SRCCFG_HeaderKey")
loadTableProperties['restApiRequestType'] = "$WSL_SRCCFG_APIMethod$".strip()
loadTableProperties['restApiPayload'] = os.environ.get("WSL_SRCCFG_Payload")
loadTableProperties['restResultType'] = "$WSL_SRCCFG_ResultType$".strip()

{%- endif %}{%br%}

{% if ((table.loadInfo.archiveFile.path != "") or (table.loadInfo.archiveFile.name != "")) and (RunMode == "Windows" or RunMode == "GD" or RunMode == "REST")%}
# ========================================================
# = Windows Archive Function After Load
# ========================================================
def archiveFileAfterLoadWindows(files, runMode): {%- br %}
    ArchivePath = r'{{ table.loadInfo.archiveFile.path }} '.replace("\ ","").strip(){%- br %}
    ArchiveName = '{{ table.loadInfo.archiveFile.name }}'{%- br %}
{%- br %}
    if runMode == "Windows" or runMode == "GD" or runMode == "REST":{%- br %}
        if ArchivePath =="":{%- br %}
            ArchivePath = os.path.dirname(files[0]){%- br %}
        if len(files) > 1:{%- br %}
            if( ArchivePath !=""):{%- br %}
                if(ArchiveName !=""):{%- br %}
                   write_audit("Files will be moved but not renamed"){%- br %}
                   write_audit("Renaming is not supported for multi file loads"){%- br %}
            dir = WslPythonCommon.ReplaceWslTags(ArchivePath){%- br %}
            if not os.path.exists(dir):
                   os.makedirs(dir)
            for file in files:{%- br %}
                    try:{%- br %}
                        ret=shutil.move(file,ArchivePath){%- br %}
                        write_audit(file+" moved to "+dir+""){%- br %}
                    except:{%- br %}
                        write_error("Failed to move " + file + " to " + ArchivePath+""){%- br %}
        else:{%- br %}
            try:{%- br %}
                dir = WslPythonCommon.ReplaceWslTags(ArchivePath){%- br %}
                if not os.path.exists(dir):
                       os.makedirs(dir)
                fil = WslPythonCommon.ReplaceWslTags(ArchiveName){%- br %}
                path = os.path.join(dir, fil){%- br %}
                ret=shutil.move(files[0],path){%- br %}
                write_audit("Source file moved to " + path+""){%- br %}
            except:{%- br %}
                write_error("Failed to move " + files[0] + " to " + path+""){%- br %}
{%- br %}
{%- endif %}


{% if ((table.loadInfo.triggerArchiveFile.path != "") or (table.loadInfo.triggerArchiveFile.name != "")) and (RunMode == "Windows" or RunMode == "GD" or RunMode == "REST") %}
# ========================================================
# = Windows Archive Function For Trigger Files
# ========================================================
def windowsArchiveTrigger( {%- br %}
        files{%- br %}
       {%- br %}
    ):{%- br %}
    ArchivePath = r'{{ table.loadInfo.triggerArchiveFile.path }} '.replace("\ ","").strip(){%- br %}
    ArchiveName = '{{ table.loadInfo.triggerArchiveFile.name }}'{%- br %}
{%- br %}
    if runMode == "Windows" or runMode == "Database" or runMode == "GD" or runMode == "REST": {%- br %}
        if ArchivePath =="":{%- br %}
            ArchivePath = os.path.dirname(files[0]){%- br %}
        if len(files) > 1:{%- br %}
            if( ArchivePath !=""):{%- br %}
                if(ArchiveName !=""):{%- br %}
                   write_audit("Files will be moved but not renamed"){%- br %}
                   write_audit("Renaming is not supported for multi file loads"){%- br %}
            dir = WslPythonCommon.ReplaceWslTags(ArchivePath){%- br %}
            if not os.path.exists(dir):
                os.makedirs(dir)
            for file in files:{%- br %}
                    try:{%- br %}
                        ret=shutil.move(file,ArchivePath){%- br %}
                        write_audit(file+" moved to "+dir+""){%- br %}
                    except:{%- br %}
                        write_error("Failed to move " + file + " to " + ArchivePath+"")
        else:{%- br %}
            try:{%- br %}
                dir = WslPythonCommon.ReplaceWslTags(ArchivePath){%- br %}
                if not os.path.exists(dir):
                       os.makedirs(dir)
                fil = WslPythonCommon.ReplaceWslTags(ArchiveName){%- br %}
                path = os.path.join(dir, fil){%- br %}
                ret=shutil.move(files[0],path){%- br %}
                write_audit("Trigger file moved to " + path+""){%- br %}
            except:{%- br %}
                write_error("Failed to move " + files[0] + " to " + path+""){%- br %}
{%- br %}
{%- endif %}

{% if RunMode == "REST" %}
# ========================================================
# = Download REST API Result File
# ========================================================
restURL = loadTableProperties['restApiUrl']
userId = loadTableProperties['restApiUserId']
password = loadTableProperties['restApiPass']
headers = loadTableProperties['restApiHeader']
requestType = loadTableProperties['restApiRequestType']
payload = loadTableProperties['restApiPayload']
resultType = loadTableProperties['restResultType']

{%- br %}
# Check if headers and payload are empty {%- br %}
if headers != None and headers != "": {%- br %}
    headers = json.loads(str(headers).replace("\'", "\"")) {%- br %}
else: {%- br %}
    headers = None {%- br %}

if payload != None and payload != "": {%- br %}
    payload = json.loads(str(payload).replace("\'", "\"")) {%- br %}
else: {%- br %}
    payload = None {%- br %}

if resultType == "": {%- br %}
    resultType = "GET" {%- br %}


# Create restAPI {%- br %}
restAPI = WslApiFileBrowser.Auth() {%- br %}

# Create user custom auth {%- br %}
userCustomRESTAuth = WslSampleAuthScript.UserAuth(restURL, userId, password, headers, requestType, payload) {%- br %}

# Run entry point function of the user custom auth {%- br %}
userCustomSession, userCustomHeader = userCustomRESTAuth.entryMethod() {%- br %}

if userCustomHeader != headers: {%- br %}
    headers = userCustomHeader {%- br %}

# If session generated by user custom auth is "Default", then execute our own auth function {%- br %}
if userCustomSession == "Default": {%- br %}
    if userId and password: {%- br %}
        restAPI.basicAuthSession(userId, password) {%- br %}
        apiFileDownloadedPath = restAPI.basicAuthRequest(restAPI.session, requestType, restURL, resultType, headers, payload) {%- br %}
    else: {%- br %}
        apiFileDownloadedPath = restAPI.openRequest(requestType, restURL, resultType, headers) {%- br %}
else: {%- br %}
    apiFileDownloadedPath = restAPI.userSessionCommonRequest(userCustomSession, requestType, restURL, headers, payload, resultType) {%- br %}


# Error Handling
if "API_ERROR:" in apiFileDownloadedPath:
    write_error("Error in fetching API data")
    raise Exception("Error in fetching API data")

if str(resultType) == "JSON": {%- br %}
    loadTableProperties['sourceFileName'] = "api.json" {%- br %}
else:
    loadTableProperties['sourceFileName'] = "api.xml" {%- br %}

loadTableProperties['sourceFilePath'] = loadTableProperties['WSL_WORKDIR'] {%- br %}

{%- br %}
{%- endif %}

{% if RunMode == "S3" %}
{%- br %}
# ========================================================
# = Check If File Exists In Amazon S3 And Get File Status
# ========================================================
def checkIfFileExistsOnS3(filePath): {% br %}
    s3_client = boto3.client(
        's3',
        aws_access_key_id = loadTableProperties['awsAccessKey'],
        aws_secret_access_key = loadTableProperties['awsSecretKey'],
        region_name = loadTableProperties['s3RegionName']
    ){% br %}

    try:
        # Check if the object exists on S3
        s3_client.head_object(Bucket=filePath.split('/')[2], Key=filePath.split('/', 3)[-1])
        return True
    except botocore.exceptions.ClientError as e:
        # If the object does not exist, return False
        if e.response['Error']['Code'] == "404":
            return False
        else:
            # Otherwise, print the error and return False
            error_code = e.response['Error']['Code']
            error_message = e.response['Error']['Message']
            write_error(f"Error: {error_code}, {error_message}")
            return False
{% br %}
{%- endif %}

{% if (table.loadInfo.archiveFile.path != "") or (table.loadInfo.triggerFile.name != "") and (RunMode == "S3") %}
{% br %}
# ========================================================
# = Amazon S3 Archive Function After Load
# ========================================================
def archiveFileAfterLoadS3(sourcePath, targetPath):
    s3 = boto3.resource(
        's3',
        aws_access_key_id = loadTableProperties['awsAccessKey'],
        aws_secret_access_key = loadTableProperties['awsSecretKey'],
        region_name = loadTableProperties['s3RegionName']
    )

    copy_source = {
     'Bucket': sourcePath.split('/')[2],
     'Key': sourcePath.split('/', 3)[-1]
    }

    try:
        archiveResult = s3.meta.client.copy(copy_source, targetPath.split('/')[2], targetPath.split('/', 3)[-1])
    except Exception as e:
        write_error(f"Error copying file '{sourcePath}': {e}")
        return False

    # If the copy was successful, delete the file from the source bucket
    try:
        s3.Object(sourcePath.split('/')[2], sourcePath.split('/', 3)[-1]).delete()
    except Exception as e:
        write_error(f"Error deleting file '{sourcePath}' from source bucket: {e}")
        return False

    return True
{%- endif %}


# ========================================================
# = Snowflake Connection Function
# ========================================================

def executeSnowflakeQuery(query, uidSF = str(os.environ.get('WSL_TGT_USER','')), pwdSF = str(os.environ.get('WSL_TGT_PWD','')), dsnSF = str(os.environ.get('WSL_TGT_DSN','')), serverSF= str(os.environ.get('WSL_TGT_SERVER',''))):
    try:
        uid = uidSF
        pwd = pwdSF
        if os.environ.get('WSL_TGT_CONSTRING','') != "":
          SFConnectionString = os.environ.get('WSL_TGT_CONSTRING','')
        else:
          SFConnectionString = "DSN=" + dsnSF
          if uid and not uid.isspace():
            SFConnectionString += ";UID="+uid
          if pwd and not pwd.isspace():
            SFConnectionString += ";PWD="+pwd

        SFConnectionString = WslPythonSnowflake.addapplicationid(SFConnectionString)
        SFConnection = pyodbc.connect(SFConnectionString, autocommit=True)
        SFconn = SFConnection.cursor(){%- br %}
        query_tag = WslPythonCommon.GetExtendedProperty("SF_QUERY_TAG", str(os.environ.get('WSL_LOAD_TABLE',''))).strip()
        if query_tag and query_tag.strip():
            query_sql = f"ALTER SESSION SET QUERY_TAG = '{query_tag}'"
            SFconn.execute(query_sql)
        sfResult = SFconn.execute(query).fetchall(){%- br %}
        SFconn.close(){%- br %}


    except Exception as exceptionError:
        write_error("Connection error has occurred: : " + repr(exceptionError))
        raise exceptionError
    return sfResult

# ========================================================
# = Alter Timezone Common Function
# ========================================================

def alterTimeZone():
    # == Alter TimeZone ============================================
    if extendedProperty['TIMEZONE'] !="":{%- br %}
        tzStmt = "ALTER SESSION SET TIMEZONE ="+"'"+str(extendedProperty['TIMEZONE']) +"'"+ ";`r`n"{%- br %}
        write_audit("SET TIMEZONE:"){%- br %}
        write_audit(tzStmt){%- br %}
        executeSnowflakeQuery(tzStmt)

# ========================================================
# = File Format Common Function
# ========================================================
def getFileFormat():
    {% if (RunMode == "Windows" and getExtendedProperty( propertyName = "SF_S3_BUCKET_PREFIX" ) != "" and (table.loadInfo.sourceConnectionType.name != "Configured Source Connection")) or (RunMode == "Database") or (RunMode == "GD") %}{%- br %}
    # Work out full file format name{%- br %}
    FILE_FORMAT_FULL=WslPythonCommon.GetFileFormatFullName(str(extendedProperty['FILE_FORMAT']))
    os.environ["fileFormatFullName"] = ""
    if FILE_FORMAT_FULL != "":
         os.environ["fileFormatFullName"] = FILE_FORMAT_FULL+"."+str(extendedProperty['FILE_FORMAT'])
    else:
     os.environ["fileFormatFullName"] = str(extendedProperty['FILE_FORMAT'])
    fileFormat =  os.environ["fileFormatFullName"]
    {% elseif  ['json','parquet','avro','xml','orc'] contains fileType -%}{%- br %}
    fileFormat = f"""(
            TYPE = {{fileType}}
             {% if (fileType == "json") -%}{%- br %}
            STRIP_OUTER_ARRAY = true
                        {%- endif %} {%- br %}
            )"""
    {% else %}{%- br %}
    fileFormat = f"""(
            TYPE = CSV
            FIELD_DELIMITER = "{loadTableProperties['sourceFileFieldDelimiter']}"
            SKIP_HEADER = {loadTableProperties['fieldHeading']}
            RECORD_DELIMITER = "{loadTableProperties['sourceFileRecordDelimiter']}"
            FIELD_OPTIONALLY_ENCLOSED_BY = '{loadTableProperties['sourceFileFieldEnclosure']}'
            NULL_IF = ('""', 'NULL', '')
            ERROR_ON_COLUMN_COUNT_MISMATCH = FALSE )"""
    {%- endif %} {%- br %}
    return fileFormat

{% if RunMode == "Database" %}{%- br %}
# ========================================================
# = Download Data File Function
# ========================================================
def downloadDataToFile(targetTableName,fileDownloadPath):
    if len(str(targetTableName))>140:{%br%}
        targetTableName = targetTableName[:140]{%br%}
    downloadedFileName = "wsl"+str(targetTableName)+str(os.environ.get('WSL_SEQUENCE','')){%br%}
    write_audit("================= EXTRACT SQL ====================="){%br%}
    {%- set empty = "" %}
    {%- if table.loadInfo.selectDistinctValues == true %}
      {%- set distinct = true %}
    {% else %}
      {%- set distinct = false %}
    {%- endif %}
    {%- br %}
    {%- if table.loadInfo.overrideLoadSQL | trim != "" %}
    extractSql = """
    {{table.loadInfo.overrideLoadSQL}}{%- br %}
"""{%- br %}
    {% elseif table.loadInfo.useOverrideSourceColumns == true %}
    extractSql = """
    SELECT {%- if distinct%} DISTINCT{%- else %}{%- endif %}
    {{table.loadInfo.overrideSourceColumns}}{%- br %}
    {%- if table.loadInfo.sourceTables != "" -%}FROM """+str(os.environ.get('WSL_SRC_SCHEMA',''))+""".{{ table.loadInfo.sourceTables }} {%- br %}{% endif %}
    {%- from table.loadInfo.whereAndGroupByClauses | lines as whereLine %}
     {{ whereLine }}{% br %}
    {%- endfrom %}
"""{%- br %}
    {% else %}
    {%- set srcEncChars = getExtendedProperty( propertyName = "SOURCE_ENCAPSULATION_CHARACTERS" ) -%}{%- br %}
    extractSql = """
    SELECT {%- if distinct%} DISTINCT{%- else %}{%- endif %}
      {%- from table.columns as column where (column.sourceTable is defined or column.sourceColumn is defined or column.transformType.code == "D") %}
        {%- if not loop.first %}    , {% else %} {% endif %}
        {%- if column.transformType.code != "A" and column.transformType.code != "" %}
          {{- column.source }}
        {%- else %}
          {%- if column.sourceTable is defined %}
            {%- fetch column.sourceTable %}
            {{- encapsulateString(column.sourceTable.name, srcEncChars) }}.
          {%- endif %}
          {%- if column.sourceColumn is defined %}
            {{- encapsulateString(column.sourceColumn.name, srcEncChars) }}
          {%- endif %}
        {%- endif %}
        {%- br %}
      {%- endfrom %}
    {%- if table.loadInfo.sourceTables != "" -%}FROM """+str(os.environ.get('WSL_SRC_SCHEMA',''))+""".{{- encapsulateString(table.loadInfo.sourceTables, srcEncChars) }} {%- br %}{% endif %}
    {%- from table.loadInfo.whereAndGroupByClauses | lines as whereLine %}
     {{ whereLine }}{% br %}
    {%- endfrom %}
"""{%- br %}
    {%- endif %} {%- br %}

    write_detail("BEGIN create of data file from source system: "+str(datetime.now())+''){% br %}

    write_audit(extractSql)

    #CLEAN UP FILES LOCAL SYSTEM
    try:
        for f in glob.glob(os.path.join(fileDownloadPath,downloadedFileName).replace(os.sep, '/')+"*"):
            os.remove(f)
    except Exception as exceptionError:{%- br %}
        write_error("File Clean up local if exists : Failed to find"){%- br %}

    rowCount = WslPythonCommon.GetDataToFile(extractSql,str(os.environ.get('WSL_SRC_DSN','')),str(os.environ.get('WSL_SRC_USER','')),str(os.environ.get('WSL_SRC_PWD','')),os.path.join(fileDownloadPath,downloadedFileName),str(extendedProperty['UNLOAD_DELIM']), fileCount, splitThresholdCount, True, unicode, str(extendedProperty['UNLOAD_ENC']), str(extendedProperty['UNLOAD_ESC'])){% br %}
    if rowCount[0] == -2:
        err = "Failure occurred while generating data files"
        newvar =  WslPythonCommon.WsWrkAudit ('E', "An error has occurred: " + err,'','')
        write_error("An error has occurred while generating data files : ")
        raise Exception("An error has occurred while generating data files : ")
    elif rowCount[0] == 1 and  rowCount[1]< 1:
        write_audit("Source query returned 0 rows"+'')

    write_detail("END create of data file from source system: "+str(datetime.now())+''){% br %}

    #For multiple input files add file name to list
    dataFiles = []{% br %}
    for f in glob.iglob(os.path.join(fileDownloadPath,downloadedFileName)+'*.txt'): {% br %}
        dataFiles.append(f){% br %}

    #Set values in load table properties
    loadTableProperties['dataFileList'] =  dataFiles
    loadTableProperties['sourceFileName'] = downloadedFileName+'.txt'
    loadTableProperties['rowCount'] = rowCount
    loadTableProperties['sourceFilePath'] = fileDownloadPath
{%- endif %}

{% if (RunMode == "Windows") and (getExtendedProperty( propertyName = "SF_S3_BUCKET_PREFIX" ) != "") %}{%- br %}
# ========================================================
# = Load source prefix data from files to Snowflake
# ========================================================
def loadSourcePrefixFiles():
{% block "GetExtendedProperty_s3prefix" %}{%- br %}
    s3prefix = WslPythonCommon.GetExtendedProperty("SF_S3_BUCKET_PREFIX",str(os.environ.get('WSL_LOAD_TABLE',''))){%- br %}
{% endblock %}{%- br %}
    if s3prefix.startswith("s3://"):
      copyStatement = """
      COPY INTO {{table.schema}}.{{table.name}}
      FROM """+f"""{%- br %}
      '{loadTableProperties['s3FileDetails']}'
      CREDENTIALS = (AWS_KEY_ID = '{loadTableProperties['awsAccessKey']}'
      AWS_SECRET_KEY = '{loadTableProperties['awsSecretKey']}')
      FILE_FORMAT = {getFileFormat()}
"""
    maskedLoad = copyStatement{%- br %}
    if loadTableProperties['awsAccessKey']!="":{%- br %}
        maskedLoad = maskedLoad.replace(loadTableProperties['awsAccessKey'],'*'* len(loadTableProperties['awsAccessKey'])){%- br %}

    if loadTableProperties['awsAccessKey'] !="":{%- br %}
        maskedLoad = maskedLoad.replace(loadTableProperties['awsSecretKey'],'*'* len(loadTableProperties['awsSecretKey'])){%- br %}

    write_audit("COPY:"){%- br %}
    write_audit(maskedLoad){%- br %}
    write_audit(""){%- br %}
    if str(os.environ.get('DEBUG','')).upper().strip() == "TRUE":{%- br %}
        write_detail("BEGIN COPY INTO" +"'"+ str(os.environ.get('WSL_LOAD_FULLNAME','')) +"'" +" : "+str(datetime.now())+''){%- br %}
    loadResult = executeSnowflakeQuery(copyStatement)
    if str(os.environ.get('DEBUG','')).upper().strip() == "TRUE":{%- br %}
        write_detail("END COPY INTO "+"'"+ str(os.environ.get('WSL_LOAD_FULLNAME','')) +"'" +" : "+str(datetime.now())+''){%- br %}
    checkStatus=0{%- br %}
    rowsLoaded=0{%- br %}
    checkFlag=0{%- br %}
    write_audit("File                                            " + "Status         " + "Rows Parsed        "+"Rows Loaded  "){%- br %}
    write_audit("------------------------------------------------" + "---------------" + "-------------------"+"-------------------  "){%- br %}
    while len(loadResult)> checkStatus:{%- br %}
        if loadResult[checkStatus][5] == 0:{%- br %}
            rowsLoaded = rowsLoaded + loadResult[checkStatus][3] {%- br %}
        else: {%- br %}
            checkFlag=1 {%- br %}
        write_audit(str(loadResult[checkStatus][0])+"       "+str(loadResult[checkStatus][1])+"       "+str(loadResult[checkStatus][2])+"       "+str(loadResult[checkStatus][3])+"       "){%- br %}
        checkStatus = checkStatus+1  {%- br %}
    if checkFlag==0:  {%- br %}
        write_audit(str(rowsLoaded) +" rows loaded."){%- br %}
        try:{%- br %}
        #-- WsWrkTask call to updated row counts in Ws_Wrk_Task_Run/Log
            metaResult=WslPythonCommon.WsWrkTask(0,0,0,rowsLoaded,0,0,0){%- br %}
        except:{%- br %}
            write_audit("Failed to update task row count"){%- br %}
        write_audit("Load successful. "+str(rowsLoaded)+" rows loaded",logType="audit")
    else:{%- br %}
        write_error("Load failed")
        raise Exception("Load failed")
{%- endif %}

# ========================================================
# = Load data from files to Snowflake
# ========================================================
def loadAllFiles(externalStageName=""):
       {%- if (['json','parquet','avro','xml','orc'] contains fileType )or (['S3','AZ','GCS'] contains RunMode and not ['xlsx'] contains fileType)-%}{%br%}
