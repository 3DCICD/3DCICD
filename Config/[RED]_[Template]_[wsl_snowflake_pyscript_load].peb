               {% if sortedArray | length == 1 %}
               , lateral FLATTEN(src: "$") {{sortedArray[0]}}{%- br %}
                {% endif %}
               {%- from range(0, sortedArray | length - 1) as i %}
               {% if sortedArray[i] contains "_" %}
               {% if i == sortedArray | length - 1 %}
               {% else %}
               , lateral FLATTEN({{sortedArray[i]}}.value: "$") {{sortedArray[i+1]}}{%- br %}
               {% endif %}
                {% else %}
               {% if i == sortedArray | length - 1 %}
               {% else %}
                {%- br %}
                , lateral FLATTEN(src: "$") {{sortedArray[i+1]}}{%- br %}
                {% endif %}
                {% endif %}
               {%- br %}
               {% endfrom  %}
               WHERE{%- br %}
               {% if 1 == sortedArray | length%}
               GET({{sortedArray[0]}}.value, '@') = '{{sortedArray[0].split("\_") | last}}'{%- br %}
               {% endif %}
               {%- from range(1, sortedArray | length - 1) as i %}
               {% if i != 1 %}
               AND{%- br %}
               {% endif %}
               GET({{sortedArray[i]}}.value, '@') = '{{sortedArray[i].split("\_") | last}}'{%- br %}
               {% endfrom  %}
               {%- elseif flattenObject != "" %}
               , LATERAL FLATTEN( INPUT => src:{{flattenObject}}) {%- br %}
               {%- endif -%}
            {%- if table.loadInfo.sourceConnectionType.name != "Configured Source Connection" and table.loadInfo.fileLoaderOptions != "" %}
            {{ table.loadInfo.fileLoaderOptions }}{%- br %}
            {%- endif %};
"""{%- br %}
{%- endif %}
        maskedLoad = copyStatement{%- br %}

