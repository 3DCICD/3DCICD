                        if loadTableProperties['sourceFileName'][-1]=="*":
                            x=0{%- br %}
                            while x< len(glob.glob(os.path.join(loadTableProperties['sourceFilePath'],loadTableProperties['sourceFileName']))):{%- br %}
                                if os.path.isfile(str(glob.glob(os.path.join(loadTableProperties['sourceFilePath'],loadTableProperties['sourceFileName']))[x])) == True:
                                    os.remove(glob.glob(os.path.join(loadTableProperties['sourceFilePath'],loadTableProperties['sourceFileName']))[x]){%- br %}
                                x=x+1{%- br %}
                    else:{%- br %}
                        if os.path.isfile(str(os.remove(os.path.join(loadTableProperties['sourceFilePath'],loadTableProperties['sourceFileName'])))) == True:
                            os.remove(os.path.join(loadTableProperties['sourceFilePath'],loadTableProperties['sourceFileName'])){%- br %}
            {%- endif %}{%- br %}
             {%- endif %}

