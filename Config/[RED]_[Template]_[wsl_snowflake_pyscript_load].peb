                      if os.path.isfile(str(dataFiles[x]).split(".")[0]+".gz") == True:{%- br %}
                        os.remove(str(dataFiles[x]).split(".")[0]+".gz"){%- br %}
                    else:{%- br %}
                       if os.path.isfile(str(dataFiles[x])) == True:{%- br %}
                        os.remove(str(dataFiles[x])){%- br %}
                    x=x+1{%- br %}
                if os.path.isfile(os.path.join(loadTableProperties['sourceFilePath'],loadTableProperties['sourceFileName']).replace(os.sep, '/')+".txt")==True:
                    os.remove(os.path.join(loadTableProperties['sourceFilePath'],loadTableProperties['sourceFileName']).replace(os.sep, '/')+".txt")
                {%- else %}{%- br %}
