               {%- if column.defaultValue != "" %} DEFAULT {{column.defaultValue}}{%- endif -%}
               {%- if not column.nullAllowed %} NOT NULL {%- endif -%}
               {%- br %}
               {%- if loop.last -%}){%- endif -%}
               {%- endfor -%}
               {%- else -%}
               src variant)
               {%- endif -%};
"""
        createTempCopyStatement = """
               COPY INTO {{table.schema}}.{{table.name}}_TMP
               FROM """+f"""
                             {% if RunMode == "S3" %}{%- br %}
                              '{loadTableProperties['s3FileDetails']}'
               CREDENTIALS = (AWS_KEY_ID = '{loadTableProperties['awsAccessKey']}'
               AWS_SECRET_KEY = '{loadTableProperties['awsSecretKey']}')
                             FILE_FORMAT = {getFileFormat()}
                             {% elseif RunMode == "AZ" %}{%- br %}
               '{azureFileDetails}'
               CREDENTIALS = (AZURE_SAS_TOKEN ='{loadTableProperties['azureSasToken']}')
               FILE_FORMAT = {getFileFormat()}
                             {% elseif RunMode == "GCS" %}{%- br %}
                             '{loadTableProperties['gcsFilePath'] }'
               {% if getExtendedProperty( propertyName = "GCS_STORAGE_INTEGRATION" ) | trim != ""-%}
                             STORAGE_INTEGRATION = '{str(extendedProperty['GCS_STORAGE_INTEGRATION'])}'
               {%- endif %}{%br%}
                             FILE_FORMAT = {getFileFormat()}
               {%- else %}
               '{externalStageName.replace("/ t" ,"")}'
               {%- if fileType == 'csv' %}{%br%}
               FILE_FORMAT = {getFileFormat()}
               {%- else %}{%br%}
               FILE_FORMAT = (TYPE = '{{fileType}}'  {% if fileType == 'json' -%}STRIP_OUTER_ARRAY = true{%- endif -%} ){% endif %} {%- br %}
               {% if filePattern == 'true' -%}
               PATTERN = '{{ table.loadInfo.sourceFile.name }}'
               {%- endif %}{%br%}
               {%- if table.loadInfo.fileLoaderOptions != "" %}
               {{ table.loadInfo.fileLoaderOptions }}{%- br %}
                    {%- endif %}
                                           {%- endif %}{%- br %}
               {%- if (RunMode == "S3" or RunMode == "AZ" or RunMode == "GCS" or RunMode == "REST") and table.loadInfo.fileLoaderOptions != "" %}
               {{ table.loadInfo.fileLoaderOptions }}{%- br %}
                                           {%- endif %}
"""
{% if (fileType == "json") -%}{%- br %}
        copyStatement = """
               INSERT INTO {{table.schema}}.{{table.name}} {% br %}
               (
               {%- for col in table.columns %}
                             {%- if col.transformType.code != "A" %}
               {%- if not loop.first %}
               ,
               {%- endif -%}
               {{ col.name }}{%- br %}
                             {%- endif %}
               {%- endfor %}
               ){%- br %}

{# -- Build the alias map --#}
{%- set aliasMap = {} -%}
{%- for item in getArrayExpansionAliasMapFromSourceColumns() | lines -%}
    {%- map aliasMap put item.substring(int(0),int(item.indexOf(":"))) = item.substring(int(1 + item.indexOf(":"))) -%}
{%- endfor -%}
{%br%}
               SELECT DISTINCT{%br%}
{# -- Build the select clause colmns using the map --#}
{%- from table.columns as column where (column.sourceColumn is defined) -%}
  {%- set srcPath = column.sourceColumn.name -%}
    {%- set flattenObjectBrackets = "[]"-%}
  {%- set basePath = getBasePathFromColumnSource(srcPath) -%}
  {%- set aliasKey = getMapKeyFromValueMatch(testMap = aliasMap, testValue = basePath ) -%}
    {%- if not loop.first %}
               ,
  {%- endif -%}
  {%- if column.transform != "" %}
     {{column.transform}}{%br%}
    {%- else -%}
  {%- if aliasKey | length > 0 -%}
  {%- set finalSourceColumn = aliasKey+ ".value:"+ getChildPathFromColumnSource(srcPath)| replace({flattenObjectBrackets:""})-%}
  {{ finalSourceColumn | replace({":.":":"}) }}{%br%}
  {%- else -%}
     src:{{ getChildPathFromColumnSource(srcPath)| replace({flattenObjectBrackets:""})  }}{%br%}
    {%- endif -%}
    {%- endif -%}
{%- endfrom -%}
{%br%}
               FROM
               {{table.schema}}.{{table.name}}_TMP

{# -- Build the join clause colmns using the map --#}
{%- set sortedAliasKeys = objectToLines(aliasMap.keySet()) | lines | sort -%}
{%- for alias in sortedAliasKeys -%}
  {%- set srcPath = aliasMap[alias] -%}
    {%- set flattenObjectBrackets = "[]"-%}
  {%- set basePath = getBasePathFromColumnSource(srcPath) -%}
  {%- set aliasKey = getMapKeyFromValueMatch(testMap = aliasMap, testValue = basePath ) -%}
  {%- if aliasKey | length > 0 %}
  {%- set lateralFlattenStetment = aliasKey +".value:" + getChildPathFromColumnSource(srcPath)| replace({flattenObjectBrackets:""})%}
               ,LATERAL FLATTEN( INPUT => {{ lateralFlattenStetment | replace({":.":":"}) }}  , outer => true){{ getMapKeyFromValueMatch(testMap = aliasMap, testValue = srcPath ) }}{%br%}
  {%- else %}
               ,LATERAL FLATTEN( INPUT => src:{{ getChildPathFromColumnSource(srcPath) | replace({flattenObjectBrackets:""})}} , outer => true){{ getMapKeyFromValueMatch(testMap = aliasMap, testValue = srcPath ) }}{%br%}
    {%- endif -%}
{%- endfor -%}
"""{%br%}

{% elseif (fileType == "xml") %}
        copyStatement = """
               INSERT INTO {{table.schema}}.{{table.name}} {% br %}
               (
               {%- for col in table.columns %}
                             {%- if col.transformType.code != "A" %}
               {%- if not loop.first %}
               ,
               {%- endif -%}
               {{ col.name }}{%- br %}
                             {%- endif %}
               {%- endfor %}
               ){%- br %}

{# -- The following demostrates how to use the above macros --#}

{# -- Build the alias map --#}
{%- set aliasMap = {} -%}
{%- for item in getArrayExpansionAliasMapFromSourceColumnsXML() | lines -%}
    {%- map aliasMap put item.substring(int(0),int(item.indexOf(":"))) = item.substring(int(1 + item.indexOf(":"))) -%}
{%- endfor -%}
{%br%}
               SELECT DISTINCT
{# -- Build the select clause colmns using the map --#}
{%- from table.columns as column where (column.sourceColumn is defined) -%}
  {%- set firstName = column.sourceColumn.name.split("\.") | first -%}
  {%- set srcPath = column.sourceColumn.name | replace({ firstName + "." : "" }) -%}
  {%- set basePath = getBasePathFromColumnSource(srcPath, arraySplitRegEx = "\.", arrayIndicator = ".") -%}
    {%- if not loop.first -%}
        ,
    {%- endif -%}
  {%- set aliasKey = getMapKeyFromValueMatch(testMap = aliasMap, testValue = basePath ) -%}
  {%- if aliasKey | length > 0 %}
  {%- set lastValue = getChildPathFromColumnSource(srcPath, arraySplitRegEx = "\.", arrayIndicator = ".") -%}
  {%- if lastValue.toString contains "@" -%}
  GET("{{ aliasKey }}".value,'{{ getChildPathFromColumnSource(srcPath, arraySplitRegEx = "\.", arrayIndicator = ".") }}'){%br%}
  {%- else %}
   XMLGET( "{{ aliasKey }}".value,'{{ getChildPathFromColumnSource(srcPath, arraySplitRegEx = "\.", arrayIndicator = ".") }}'):"$"{%br%}
  {%- endif -%}
  {%- else %}
  {%- if lastValue.toString contains "@" -%}
   GET(SRC,'{{ getChildPathFromColumnSource(srcPath, arraySplitRegEx = "\.", arrayIndicator = ".") }}'){%br%}
  {%- else %}
   XMLGET( SRC, '{{ getChildPathFromColumnSource(srcPath, arraySplitRegEx = "\.", arrayIndicator = ".") }}'):"$" {%br%}
  {%- endif -%}
    {%- endif -%}
{%- endfrom -%}
               FROM
{%br%}{%br%}
    {{ table.schema }}.{{ table.name }}_TMP AS SRC{%br%}
{# -- Build the join clause colmns using the map --#}
{%- set sortedAliasKeys = objectToLines(aliasMap.keySet()) | lines | sort -%}
{%- for alias in sortedAliasKeys -%}
  {%- set srcPath = aliasMap[alias] -%}
  {%- set basePath = getBasePathFromColumnSource(srcPath, arraySplitRegEx = "\.", arrayIndicator = ".") -%}
  {%- set aliasKey = getMapKeyFromValueMatch(testMap = aliasMap, testValue = basePath ) -%}
  {%- if aliasKey | length > 0 %}
    ,LATERAL FLATTEN("{{ aliasKey }}".value: "$") "{{ getMapKeyFromValueMatch(testMap = aliasMap, testValue = srcPath ) }}"{%br%}
  {%- else %}
    ,LATERAL FLATTEN(src: "$") "{{ getMapKeyFromValueMatch(testMap = aliasMap, testValue = srcPath ) }}"{%br%}
  {%- endif -%}
{%- endfor -%}
WHERE
{# -- Print the alias map --#}
{%- for item in aliasMap -%}
GET("{{item.key}}".value, '@') = '{{replaceEnd(item.value, ".", "").split("\.") | last }}'{%br%}
    {%- if not loop.last -%}
AND{%br%}
    {%- endif -%}
{%- endfor -%}
"""


{% else %}
        copyStatement = """
               INSERT INTO {{table.schema}}.{{table.name}} {% br %}
               ( {{ noindent }}
               {%- for col in table.columns %}
