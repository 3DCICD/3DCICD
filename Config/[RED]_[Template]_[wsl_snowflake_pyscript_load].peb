     PURGE = "TRUE"{%- br %}
     if extendedProperty['PURGE']!="": {%- br %}
        PURGE = extendedProperty['PURGE']{%- br %}

    else:
        PURGE = "FALSE"{%- br %}
        if extendedProperty['PURGE']!="": {%- br %}
            PURGE = extendedProperty['PURGE']{%- br %}

    unicode = False{% br %}
    if str(extendedProperty['UNICODE_SUPPORT'])== "TRUE":{% br %}
        unicode = True{% br %}
    if extendedProperty['FILE_COUNT']=="" or int(extendedProperty['FILE_COUNT'])==0:{% br %}
        extendedProperty['FILE_COUNT'] = 1
        fileCount=1{% br %}
    else:{% br %}
        fileCount = int(extendedProperty['FILE_COUNT']){% br %}

    if extendedProperty['SPLIT_THRESHOLD']=="" or int(extendedProperty['SPLIT_THRESHOLD'])==0 :{% br %}
        extendedProperty['SPLIT_THRESHOLD'] = 100000
        splitThresholdCount=100000{% br %}
    else:{% br %}
        splitThresholdCount = int(extendedProperty['FILE_COUNT']){% br %}


    if str(extendedProperty['DEBUG'])== "TRUE":{%br%}
        write_audit("=================== LOAD OPTIONS ==================="){%br%}
        write_audit("Specified Load Table:        " + str(os.environ.get('WSL_LOAD_TABLE',''))+''){%br%}
        write_audit("Specified Work Dir:          " + str(loadTableProperties['WSL_WORKDIR'])+''){%br%}
        write_audit("Specified Sequence:          " + str(os.environ.get('WSL_SEQUENCE',''))+''){%br%}
        write_audit("Specified Metadata ODBC DSN: " + str(os.environ.get('WSL_META_DSN',''))+''){%br%}
        write_audit("Specified Metadata Username: " + str(os.environ.get('WSL_META_USER',''))+''){%br%}
        write_audit("Specified Metadata Password: " + ('*'*len(str(os.environ.get('WSL_META_PWD',''))))+''){%br%}
        write_audit("")

        if runMode == 'S3':{%br%}
            write_audit("=================== CONNECTION OPTIONS ==================="+''){%br%}
            write_audit("Access Key:                  " +  ('*'*len(str(loadTableProperties['awsAccessKey'])))+''){%br%}
            write_audit("Secret Key:                  " +  ('*'*len(loadTableProperties['awsSecretKey']))+''){%br%}
            write_audit(""){%br%}

        elif runMode == "AZ" :{%br%}
            write_audit("=================== CONNECTION OPTIONS ==================="+''){%br%}
            write_audit("SAS Token:                          " +  ('*'*len(str(loadTableProperties['azureSasToken'])))+''){%br%}
            write_audit("Encryption Method:                  " +  str(extendedProperty['AZ_ENCRYPTION_TYPE'])+''){%br%}
            write_audit("Encryption Key:                     " +  ('*'*len(str(extendedProperty['AZ_ENCRYPTION_KEY']))+'')){%br%}
            write_audit(""){%br%}

        elif runMode == "GCS":{%br%}
            write_audit("=================== CONNECTION OPTIONS ==================="+''){%br%}
            write_audit("GCS STORAGE INTEGRATION:                  " +  str(extendedProperty['GCS_STORAGE_INTEGRATION'])+''){%br%}
            write_audit("GCS STAGE AREA NAME:                     " +  str(extendedProperty['GCS_STAGE_AREA_NAME'])+''){%br%}
            write_audit(""){%br%}
        write_audit("=================== MODES ==================="+''){%br%}
        write_audit("Specified Debug Mode:        " + str(extendedProperty['DEBUG'])+''){%br%}
        write_audit("Specified Run Mode:          " + runMode+''){%br%}
        write_audit("Unicode Extract:             " + str(extendedProperty['UNICODE_SUPPORT'])+''){%br%}
        write_audit(""){%br%}

        if runMode == 'Database':{%br%}
            write_audit("=================== SOURCE TABLE INFO ==================="+''){%br%}
            write_audit("Source Schema:               " + str(os.environ.get('WSL_SRC_SCHEMA',''))+''){%br%}
            write_audit("Source Tables:               " + '{{ table.loadInfo.sourceTables }}'+''){%br%}
            write_audit("Source Where:                " + ""+''){%br%}
            write_audit(""+''){%br%}
            write_audit("=================== SOURCE DB INFO ==================="+''){%br%}
            write_audit("ODBC Source DSN:             " + str(os.environ.get('WSL_SRC_DSN',''))+''){%br%}
            write_audit("ODBC Source Username:        " + str(os.environ.get('WSL_SRC_USER',''))+''){%br%}
            write_audit("ODBC Source Password:        " + ('*'*len(str(os.environ.get('WSL_SRC_PWD',''))))+''){%br%}
            write_audit(""){%br%}
        else:
           write_audit("=================== SOURCE FILE INFO ==================="+''){%br%}
           write_audit("Source File Header Line               " +"{{ table.loadInfo.sourceFile.headerLine }}"+''){%br%}
           write_audit("Source File Path                      " +loadTableProperties['sourceFilePath'] +''){%br%}
           write_audit("Source Field Enclosure                " +loadTableProperties['sourceFileFieldEnclosure']+''){%br%}
           write_audit("Source Record Delimiter               " +loadTableProperties['sourceFileRecordDelimiter']+''){%br%}
           write_audit("Source Field  Delimiter               " +loadTableProperties['sourceFileFieldDelimiter'] +''){%br%}
           write_audit("Source File Name                      " +loadTableProperties['sourceFileName'] +''){%br%}
           write_audit("Source File Loader Options            " +"{{ table.loadInfo.fileLoaderOptions }}"+''){%br%}
		   {%- if fileType == 'xlsx' %}
		   {%br%}
           write_audit("Source Sheet Name                     " +loadTableProperties['sourceFileSheetName'] +''){%br%}
           write_audit("Source CSV File Name                  " +loadTableProperties['sourceFileNameCsv'] +''){%br%}
		   {%- endif %}
        write_audit("=================== EXTENDED PROPERTIES ==================="+''){%br%}
        write_audit("SF_FILE_FORMAT:           " + str(extendedProperty['FILE_FORMAT'])+''){%br%}
        write_audit("SF_SEND_FILES_ZIPPED:     " + str(extendedProperty['SEND_FILES_ZIPPED'])+''){%br%}
        write_audit("SF_UNLOAD_DELIMITER:      " + str(extendedProperty['UNLOAD_DELIM'])+''){%br%}
        write_audit("SF_UNLOAD_ENCLOSED_BY:    " + str(extendedProperty['UNLOAD_ENC'])+''){%br%}
        write_audit("SF_UNLOAD_ESCAPE_CHAR:    " + str(extendedProperty['UNLOAD_ESC'])+''){%br%}
        write_audit("SF_SPLIT_THRESHOLD:       " + str(extendedProperty['SPLIT_THRESHOLD'])+''){%br%}
        write_audit("SF_SPLIT_COUNT:           " + str(extendedProperty['FILE_COUNT']) +''){%br%}
        write_audit("SF_TIMEZONE:              " + str(extendedProperty['TIMEZONE'])+''){%br%}
        write_audit("SF_FILE_TYPE:             " + str(extendedProperty['FILE_TYPE'])+''){%br%}
        write_audit("SF_EXTERNAL_STAGE:        " + str(extendedProperty['EXTERNAL_STAGE'])+''){%br%}
        write_audit("SF_AZURE_SAS_TOKEN:       " + str(extendedProperty['AZ_SAS_TOKEN'])+''){%br%}
        write_audit("SF_AZURE_ENCRYPTION_TYPE: " + str(extendedProperty['AZ_ENCRYPTION_TYPE'])+''){%br%}
        write_audit("SF_AZURE_ENCRYPTION_KEY:  " + str(extendedProperty['AZ_ENCRYPTION_KEY'])+''){%br%}
        write_audit(""){%br%}
        wsl_tgt_connstring = str(os.environ.get('WSL_TGT_CONSTRING',''))
        wsl_meta_connstring = str(os.environ.get('WSL_META_CONSTRING',''))
        wsl_src_connstring = str(os.environ.get('WSL_SRC_CONSTRING',''))
        if wsl_tgt_connstring != "":
          write_audit("Target connected with Advanced connect Method")
        if wsl_meta_connstring != "":
          write_audit("Metadata connected with Advanced connect Method")
        if wsl_src_connstring != "":
          write_audit("Source connected with Advanced connect Method")
except Exception as exceptionError:{%br%}
    raise exceptionError{%br%}


try:
    {%- if RunMode == "Database" %}{%- br %}
    #Load data from Database/ODBC
    downloadDataToFile(os.environ.get('WSL_LOAD_TABLE',''),loadTableProperties['WSL_WORKDIR']) {%- br %}
    loadDataUsingLocalFile(loadTableProperties['sourceFilePath'],loadTableProperties['sourceFileName'],loadTableProperties['dataFileList'])
    {%- elseif (RunMode == "Windows") or (RunMode == "REST") %}{%- br %}
    sourcePrefix = "" {%- br %}
    #Load data from Windows/Local File
    {%- if RunMode != "REST" %}{%- br %}
    {% block "GetExtendedProperty_sourcePrefix" %}{%br%}
    sourcePrefix = WslPythonCommon.GetExtendedProperty("SF_S3_BUCKET_PREFIX",str(os.environ.get('WSL_LOAD_TABLE',''))){%- br %}
    {% endblock %}{%- br %}
    {%- endif %} {%- br %}
    if sourcePrefix.strip() == "":
      sourcePrefix = r"{{ table.loadInfo.sourceFile.path }} ".replace("/ ","").strip(){%- br %}
    if sourcePrefix.startswith("s3://"):{%- br %}
      loadSourcePrefixFiles(){%- br %}
    else:
      loadDataFromWindows(loadTableProperties['sourceFileName'], loadTableProperties['sourceFilePath']) {%- br %}
      loadDataUsingLocalFile(loadTableProperties['sourceFilePath'],loadTableProperties['sourceFileName'],loadTableProperties['dataFileList'])


    {%- elseif RunMode == "S3" %}{%- br %}
    #Load data from Amazon S3
    loadDataFromS3()

    {%- elseif RunMode == "AZ" %}{%- br %}
    #Load data from Azure
    loadDataFromAzure()

    {%- elseif RunMode == "GCS" %}{%- br %}
    #Load data from Google Cloud Storage
    loadDataFromGoogleCloud()

    {%- else %} {%- br %}
    #Load data from Google Drive
    loadDataFromGoogleDrive()
    {%- endif %} {%- br %}

except SystemExit:
    exitCode = 0
    exitMessage = f"Script exited successfully as per the waitAction setting ('{loadTableProperties['waitAction']}')."
    raise
except Exception as exceptionError:{%- br %}
    write_error("Script Failed:" + str(exceptionError))
    write_error(traceback.format_exc())
    exitCode = 2
    exitMessage = 'Script run failed'

{%- br %}
else: {%- br %}
    exitCode = 0
    exitMessage = 'Script ran successfully'
{%- br %}
finally: {%- br %}
    exit_script(exitCode, exitMessage)
{%- br %}
