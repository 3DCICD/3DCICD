    'FILE_FORMAT': WslPythonCommon.GetExtendedProperty("SF_FILE_FORMAT",str(os.environ.get('WSL_LOAD_TABLE',''))),
    'UNICODE_SUPPORT': WslPythonCommon.GetExtendedProperty("SF_UNICODE_SUPPORT",str(os.environ.get('WSL_LOAD_TABLE',''))).upper().strip(),
