{# -- This macro takes an object list like source column names and outputs them as lines, useful for conversion to comparable lists -- #}
{%- macro objectToLines( objList = [] ) -%}
  {%- for item in objList -%}
  {{ item }}{%br%}
  {%- endfor -%}
{%- endmacro -%}

{# -- This macro returns a newline separated list in map form conatining a unique set of "Alias Name : Path" paris derived from the source column path, for use with building xml and json load statements -- #}
{%- macro getArrayExpansionAliasMapFromSourceColumns(columns = table.columns, arraySplitRegEx = "\[\]", arrayIndicator = "[]") %}
  {%- set srcArrayNodes = [] -%}
  {%- from columns as col where (col.sourceColumn is defined) -%}
    {%- set aMyStrParts = col.sourceColumn.name.split(arraySplitRegEx) -%}
    {%- from aMyStrParts as part where part is not empty -%}
      {%- if not loop.first -%}
        {% set basePath = basePath + part + arrayIndicator -%}
      {%- else -%}
        {% set basePath = part + arrayIndicator -%}
      {%- endif -%}
      {%- if not loop.last -%}
        {%- if not srcArrayNodes contains basePath -%}
          {%- list srcArrayNodes add basePath -%}
        {%- endif -%}
            {%- endif -%}
    {%- endfrom -%}
  {%- endfrom -%}
  {%- for item in srcArrayNodes | sort -%}
    {%- set paddedIndex = ("00" + (loop.index + 1).toString).substring(int((loop.index + 1).toString.length)) -%}
    A{{ paddedIndex }}:{{ item }}{%br%}
  {%- endfor -%}
{% endmacro -%}


{# -- This macro returns a newline separated list in map form conatining a unique set of "Alias Name : Path" paris derived from the source column path, for use with building xml and json load statements -- #}
{%- macro getArrayExpansionAliasMapFromSourceColumnsXML(columns = table.columns, arraySplitRegEx = "\.", arrayIndicator = ".") %}
  {%- set srcCols = [] -%}
  {%- set newSrcColumns = [] -%}
  {%- for column in table.columns %}
  {%- if column.transformType.code != "A" %}
    {%- set sColName = column.sourceColumn.name -%}
    {%- set firstName = sColName.split("\.") | first -%}
    {%- set newCol = sColName | replace({ firstName + "." : "" }) -%}
    {%- list newSrcColumns add newCol -%}
  {%- endif -%}
  {%- endfor -%}
  {%- get srcCols from columns as column where (column.sourceColumn is defined) -%}
  {%- set srcArrayNodes = [] -%}
  {%- from newSrcColumns as col -%}
    {%- set aMyStrParts = col.split(arraySplitRegEx) -%}
    {%- from aMyStrParts as part where part is not empty -%}
      {%- if not loop.first -%}
        {% set basePath = basePath + part + arrayIndicator -%}
      {%- else -%}
        {% set basePath = part + arrayIndicator -%}
      {%- endif -%}
      {%- if not loop.last -%}
        {%- if not srcArrayNodes contains basePath -%}
          {%- list srcArrayNodes add basePath -%}
        {%- endif -%}
            {%- endif -%}
    {%- endfrom -%}
  {%- endfrom -%}
  {%- for item in srcArrayNodes | sort -%}
    {%- set paddedIndex = ("000" + (loop.index + 1).toString).substring(int((loop.index + 1).toString.length)) -%}
    A{{ paddedIndex }}:{{ item }}{%br%}
  {%- endfor -%}
{% endmacro -%}

{# -- This macro returns a the base path for a json style 'file parser' path string -- #}
{%- macro getBasePathFromColumnSource(srcPath = "unknown", arraySplitRegEx = "\[\]", arrayIndicator = "[]") %}
  {%- set aMyStrParts = srcPath.split(arraySplitRegEx) -%}
  {%- set  partKey = "" -%}
  {%- from aMyStrParts as part where part is not empty -%}
    {%- if (not loop.first) and (not loop.last) -%}
      {% set partKey = partKey + part + arrayIndicator -%}
    {%- elseif not loop.last -%}
      {% set partKey = part + arrayIndicator -%}
    {%- endif -%}
  {%- endfrom -%}
  {{ partKey }}
{%- endmacro -%}

{# -- This macro returns a the child path for a json style 'file parser' path string -- #}
{%- macro getChildPathFromColumnSource(srcPath = "unknown", arraySplitRegEx = "\[\]", arrayIndicator = "[]") %}
  {%- set aMyStrParts = srcPath.split(arraySplitRegEx) -%}
  {%- set  partKey = aMyStrParts | last -%}
  {%- if srcPath.lastIndexOf(codepoint(93)) > 0 and srcPath.lastIndexOf(codepoint(93)) == srcPath.length - 1 -%}
    {{ partKey + arrayIndicator }}
  {%- else -%}
    {{ partKey }}
  {%- endif -%}
{% endmacro -%}

{# -- This macro returns a map key for a matched value string inside a map, if there is no match the returned string is empty -- #}
{%- macro getMapKeyFromValueMatch( testMap = {}, testValue = "" ) %}
  {%- set mapKey = "" -%}
  {%- for item in testMap -%}
    {%- if testValue.toString equals item.value  -%}
      {%- set mapKey = item.key -%}
    {%- endif -%}
  {%- endfor -%}
  {{ mapKey }}
{%- endmacro -%}

{# -- This macro returns an encapuslation character to be used based on the value provided by user -- #}
{% macro encapsulateString ( encString = "", encChars = "" ) %}
  {%- if (encChars | trim | length) > 0 -%}
    {%- set startChar = encChars | first  -%}
    {%- set endChar = encChars | last  -%}
    {%- if (startChar == encString | first) and ( endChar == encString | last ) -%}
      {{ encString }}
    {%- else -%}
      {{ startChar + encString + endChar }}
    {%- endif -%}
  {%- else -%}
    {{ encString }}
  {%- endif -%}
{% endmacro %}
