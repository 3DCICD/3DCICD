{%- if fileType == 'xlsx' %}
{%- br %}
# ========================================================
# = Convert Excel Sheet To Csv File
# ========================================================
def ExcelToCsv (sourceFilePath,loadTableProperties,csvFilePath=os.environ.get('WSL_WORKDIR','')):
 import pandas as pd
 columns    = """
[{%- for col in table.columns %}
{%- if not loop.first %}
, {{ noindent }}
{%- endif %}
{{- noindent }}'{{ col.name }}'{%- br %}
{%- endfor %}]
"""
 extraColumns = []
 csvFile = os.path.join(csvFilePath,loadTableProperties['sourceFileNameCsv'])
 read_file = pd.read_excel(os.path.join(sourceFilePath,loadTableProperties['sourceFileName']), sheet_name=loadTableProperties['sourceFileSheetName'],header=0,skiprows=0)
 csv_data= read_file.iloc[:, 0:len(columns)]
 if len(read_file.columns) < len(columns):
    for i in range(len(columns)-len(read_file.columns)):
        extraColumns.append('DSS_COL_'+str(i))
    csv_data = csv_data.reindex(columns = csv_data.columns.tolist() + extraColumns)
 csv_data.to_csv (csvFile, index = None, header=columns,sep='|')
{%br%}
{%- endif %}

