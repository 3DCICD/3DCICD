    'UNLOAD_ESC': WslPythonCommon.GetExtendedProperty("SF_UNLOAD_ESCAPE_CHAR",str(os.environ.get('WSL_LOAD_TABLE',''))),
    'SPLIT_THRESHOLD': WslPythonCommon.GetExtendedProperty("SF_SPLIT_THRESHOLD",str(os.environ.get('WSL_LOAD_TABLE',''))).strip(),
    'FILE_COUNT': WslPythonCommon.GetExtendedProperty("SF_SPLIT_COUNT",str(os.environ.get('WSL_LOAD_TABLE',''))).strip(),
    'TIMEZONE': WslPythonCommon.GetExtendedProperty("SF_TIMEZONE",str(os.environ.get('WSL_LOAD_TABLE',''))),
    'FILE_TYPE': WslPythonCommon.GetExtendedProperty("SF_FILE_TYPE",str(os.environ.get('WSL_LOAD_TABLE',''))),
    'EXTERNAL_STAGE': WslPythonCommon.GetExtendedProperty("SF_EXTERNAL_STAGE",str(os.environ.get('WSL_LOAD_TABLE',''))),
    'AZ_SAS_TOKEN': WslPythonCommon.GetExtendedProperty("SF_AZURE_SAS_TOKEN",str(os.environ.get('WSL_LOAD_TABLE',''))),
    'AZ_ENCRYPTION_TYPE': WslPythonCommon.GetExtendedProperty("SF_AZURE_ENCRYPTION_TYPE",str(os.environ.get('WSL_LOAD_TABLE',''))),
    'AZ_ENCRYPTION_KEY': WslPythonCommon.GetExtendedProperty("SF_AZURE_ENCRYPTION_KEY",str(os.environ.get('WSL_LOAD_TABLE',''))),
    'GCS_STORAGE_INTEGRATION': WslPythonCommon.GetExtendedProperty("SF_GCS_STORAGE_INTEGRATION",str(os.environ.get('WSL_LOAD_TABLE',''))),
    'GCS_STAGE_AREA_NAME': WslPythonCommon.GetExtendedProperty("SF_GCS_STAGE_AREA_NAME",str(os.environ.get('WSL_LOAD_TABLE','')))
    } {%- br %}
    {%- br %}
    if extendedProperty['UNICODE_SUPPORT']!="TRUE":{%br%}
        extendedProperty['UNICODE_SUPPORT'] = "FALSE"{%br%}
    if extendedProperty['SEND_FILES_ZIPPED']!="TRUE":{%br%}
        extendedProperty["SEND_FILES_ZIPPED"] = "FALSE"{%br%}

    if extendedProperty['UNLOAD_DELIM']=="":{%br%}
        extendedProperty['UNLOAD_DELIM'] = "|"{%br%}

    if extendedProperty['UNLOAD_ENC']=="":{%br%}
