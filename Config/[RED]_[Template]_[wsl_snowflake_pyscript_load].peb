               {%- endif -%}
               {%- list xmlArray add tempColName -%}
               {%- else -%}
               src:{{colName| replace({flattenObject:"",flattenObjectBrackets:"",flattenObjectBracketsWithDot:""})}}{%br%}
               {%- endif -%}
               {%- endfor %}
               FROM
               {{table.schema}}.{{table.name}}_TMP{%- br %}
               {%- if fileType == 'xml' %}
               {% for item in xmlArray %}
