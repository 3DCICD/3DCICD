def alterTimeZone():
    # == Alter TimeZone ============================================
    if extendedProperty['TIMEZONE'] !="":
        tzStmt = "ALTER SESSION SET TIMEZONE ="+"'"+str(extendedProperty['TIMEZONE']) +"'"+ ";`r`n"
        write_audit("SET TIMEZONE:")
        write_audit(tzStmt)
        executeSnowflakeQuery(tzStmt)

# ========================================================
# = File Format Common Function
# ========================================================
def getFileFormat():
    
    # Work out full file format name
    FILE_FORMAT_FULL=WslPythonCommon.GetFileFormatFullName(str(extendedProperty['FILE_FORMAT']))
    os.environ["fileFormatFullName"] = ""
    if FILE_FORMAT_FULL != "":
         os.environ["fileFormatFullName"] = FILE_FORMAT_FULL+"."+str(extendedProperty['FILE_FORMAT'])
    else:
     os.environ["fileFormatFullName"] = str(extendedProperty['FILE_FORMAT'])
    fileFormat =  os.environ["fileFormatFullName"]
    
    return fileFormat


# ========================================================
# = Download Data File Function
# ========================================================
def downloadDataToFile(targetTableName,fileDownloadPath):
    if len(str(targetTableName))>140:
        targetTableName = targetTableName[:140]
    downloadedFileName = "wsl"+str(targetTableName)+str(os.environ.get('WSL_SEQUENCE',''))
    write_audit("================= EXTRACT SQL =====================")


    extractSql = """
    SELECT LOAD_PRODUCT.PRODUCT_ID
    , LOAD_PRODUCT.PRODUCT_CODE
    , LOAD_PRODUCT.PRODUCT_NAME
    , LOAD_PRODUCT.PRODUCT_DESCRIPTION
    , LOAD_PRODUCT.BARCODE_VALUE
    , LOAD_PRODUCT.VENDOR_ID
    , LOAD_PRODUCT.PRODUCT_GROUP_CODE
    , LOAD_PRODUCT.PRODUCT_SUB_GROUP_CODE
    , LOAD_PRODUCT.PRODUCT_LINE_CODE
    , LOAD_PRODUCT.DIMENSION_UOM
    , LOAD_PRODUCT.DIMENSION_1
    , LOAD_PRODUCT.DIMENSION_2
    , LOAD_PRODUCT.DIMENSION_3
    , LOAD_PRODUCT.VOLUME_UOM
    , LOAD_PRODUCT.VOLUME
    , LOAD_PRODUCT.WEIGHT_UOM
    , LOAD_PRODUCT.WEIGHT
    , LOAD_PRODUCT.AUTO_REORDER_FLAG
    , LOAD_PRODUCT.AUTO_REORDER_AMOUNT
    , LOAD_PRODUCT.CREATING_EMPLOYEE_ID
    , LOAD_PRODUCT.CREATED_DATETIME
    , LOAD_PRODUCT.LAST_CHANGE_EMPLOYEE_ID
    , LOAD_PRODUCT.LAST_CHANGE_DATETIME
    , LOAD_PRODUCT.DSS_RECORD_SOURCE
    , LOAD_PRODUCT.DSS_LOAD_DATE
FROM """+str(os.environ.get('WSL_SRC_SCHEMA',''))+""".LOAD_PRODUCT
"""


    write_detail("BEGIN create of data file from source system: "+str(datetime.now())+'')

    write_audit(extractSql)

    #CLEAN UP FILES LOCAL SYSTEM
    try:
        for f in glob.glob(os.path.join(fileDownloadPath,downloadedFileName).replace(os.sep, '/')+"*"):
            os.remove(f)
    except Exception as exceptionError:
        write_error("File Clean up local if exists : Failed to find")

    rowCount = WslPythonCommon.GetDataToFile(extractSql,str(os.environ.get('WSL_SRC_DSN','')),str(os.environ.get('WSL_SRC_USER','')),str(os.environ.get('WSL_SRC_PWD','')),os.path.join(fileDownloadPath,downloadedFileName),str(extendedProperty['UNLOAD_DELIM']), fileCount, splitThresholdCount, True, unicode, str(extendedProperty['UNLOAD_ENC']), str(extendedProperty['UNLOAD_ESC']))
    if rowCount[0] == -2:
        err = "Failure occurred while generating data files"
        newvar =  WslPythonCommon.WsWrkAudit ('E', "An error has occurred: " + err,'','')
        write_error("An error has occurred while generating data files : ")
        raise Exception("An error has occurred while generating data files : ")
    elif rowCount[0] == 1 and  rowCount[1]< 1:
        write_audit("Source query returned 0 rows"+'')

    write_detail("END create of data file from source system: "+str(datetime.now())+'')

    #For multiple input files add file name to list
    dataFiles = []
    for f in glob.iglob(os.path.join(fileDownloadPath,downloadedFileName)+'*.txt'): 
        dataFiles.append(f)

    #Set values in load table properties
    loadTableProperties['dataFileList'] =  dataFiles
    loadTableProperties['sourceFileName'] = downloadedFileName+'.txt'
    loadTableProperties['rowCount'] = rowCount
    loadTableProperties['sourceFilePath'] = fileDownloadPath

