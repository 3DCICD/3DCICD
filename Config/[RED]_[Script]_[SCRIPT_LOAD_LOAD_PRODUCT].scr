            write_audit("=================== CONNECTION OPTIONS ==================="+'')
            write_audit("Access Key:                  " +  ('*'*len(str(loadTableProperties['awsAccessKey'])))+'')
            write_audit("Secret Key:                  " +  ('*'*len(loadTableProperties['awsSecretKey']))+'')
            write_audit("")

        elif runMode == "AZ" :
            write_audit("=================== CONNECTION OPTIONS ==================="+'')
            write_audit("SAS Token:                          " +  ('*'*len(str(loadTableProperties['azureSasToken'])))+'')
            write_audit("Encryption Method:                  " +  str(extendedProperty['AZ_ENCRYPTION_TYPE'])+'')
            write_audit("Encryption Key:                     " +  ('*'*len(str(extendedProperty['AZ_ENCRYPTION_KEY']))+''))
            write_audit("")

        elif runMode == "GCS":
            write_audit("=================== CONNECTION OPTIONS ==================="+'')
            write_audit("GCS STORAGE INTEGRATION:                  " +  str(extendedProperty['GCS_STORAGE_INTEGRATION'])+'')
            write_audit("GCS STAGE AREA NAME:                     " +  str(extendedProperty['GCS_STAGE_AREA_NAME'])+'')
            write_audit("")
        write_audit("=================== MODES ==================="+'')
        write_audit("Specified Debug Mode:        " + str(extendedProperty['DEBUG'])+'')
        write_audit("Specified Run Mode:          " + runMode+'')
        write_audit("Unicode Extract:             " + str(extendedProperty['UNICODE_SUPPORT'])+'')
        write_audit("")

        if runMode == 'Database':
            write_audit("=================== SOURCE TABLE INFO ==================="+'')
            write_audit("Source Schema:               " + str(os.environ.get('WSL_SRC_SCHEMA',''))+'')
            write_audit("Source Tables:               " + 'LOAD_PRODUCT'+'')
            write_audit("Source Where:                " + ""+'')
            write_audit(""+'')
            write_audit("=================== SOURCE DB INFO ==================="+'')
            write_audit("ODBC Source DSN:             " + str(os.environ.get('WSL_SRC_DSN',''))+'')
            write_audit("ODBC Source Username:        " + str(os.environ.get('WSL_SRC_USER',''))+'')
            write_audit("ODBC Source Password:        " + ('*'*len(str(os.environ.get('WSL_SRC_PWD',''))))+'')
            write_audit("")
        else:
           write_audit("=================== SOURCE FILE INFO ==================="+'')
           write_audit("Source File Header Line               " +"false"+'')
           write_audit("Source File Path                      " +loadTableProperties['sourceFilePath'] +'')
           write_audit("Source Field Enclosure                " +loadTableProperties['sourceFileFieldEnclosure']+'')
           write_audit("Source Record Delimiter               " +loadTableProperties['sourceFileRecordDelimiter']+'')
           write_audit("Source Field  Delimiter               " +loadTableProperties['sourceFileFieldDelimiter'] +'')
           write_audit("Source File Name                      " +loadTableProperties['sourceFileName'] +'')
           write_audit("Source File Loader Options            " +""+'')
        write_audit("=================== EXTENDED PROPERTIES ==================="+'')
        write_audit("SF_FILE_FORMAT:           " + str(extendedProperty['FILE_FORMAT'])+'')
        write_audit("SF_SEND_FILES_ZIPPED:     " + str(extendedProperty['SEND_FILES_ZIPPED'])+'')
        write_audit("SF_UNLOAD_DELIMITER:      " + str(extendedProperty['UNLOAD_DELIM'])+'')
        write_audit("SF_UNLOAD_ENCLOSED_BY:    " + str(extendedProperty['UNLOAD_ENC'])+'')
        write_audit("SF_UNLOAD_ESCAPE_CHAR:    " + str(extendedProperty['UNLOAD_ESC'])+'')
        write_audit("SF_SPLIT_THRESHOLD:       " + str(extendedProperty['SPLIT_THRESHOLD'])+'')
        write_audit("SF_SPLIT_COUNT:           " + str(extendedProperty['FILE_COUNT']) +'')
        write_audit("SF_TIMEZONE:              " + str(extendedProperty['TIMEZONE'])+'')
        write_audit("SF_FILE_TYPE:             " + str(extendedProperty['FILE_TYPE'])+'')
        write_audit("SF_EXTERNAL_STAGE:        " + str(extendedProperty['EXTERNAL_STAGE'])+'')
        write_audit("SF_AZURE_SAS_TOKEN:       " + str(extendedProperty['AZ_SAS_TOKEN'])+'')
        write_audit("SF_AZURE_ENCRYPTION_TYPE: " + str(extendedProperty['AZ_ENCRYPTION_TYPE'])+'')
        write_audit("SF_AZURE_ENCRYPTION_KEY:  " + str(extendedProperty['AZ_ENCRYPTION_KEY'])+'')
        write_audit("")
        wsl_tgt_connstring = str(os.environ.get('WSL_TGT_CONSTRING',''))
        wsl_meta_connstring = str(os.environ.get('WSL_META_CONSTRING',''))
        wsl_src_connstring = str(os.environ.get('WSL_SRC_CONSTRING',''))
        if wsl_tgt_connstring != "":
          write_audit("Target connected with Advanced connect Method")
        if wsl_meta_connstring != "":
          write_audit("Metadata connected with Advanced connect Method")
        if wsl_src_connstring != "":
          write_audit("Source connected with Advanced connect Method")
except Exception as exceptionError:
    raise exceptionError


try:
    #Load data from Database/ODBC
    downloadDataToFile(os.environ.get('WSL_LOAD_TABLE',''),loadTableProperties['WSL_WORKDIR'])
    loadDataUsingLocalFile(loadTableProperties['sourceFilePath'],loadTableProperties['sourceFileName'],loadTableProperties['dataFileList'])

except SystemExit:
    exitCode = 0
    exitMessage = f"Script exited successfully as per the waitAction setting ('{loadTableProperties['waitAction']}')."
    raise
except Exception as exceptionError:
    write_error("Script Failed:" + str(exceptionError))
    write_error(traceback.format_exc())
    exitCode = 2
    exitMessage = 'Script run failed'
else:
    exitCode = 0
    exitMessage = 'Script ran successfully'
finally:
    exit_script(exitCode, exitMessage)
