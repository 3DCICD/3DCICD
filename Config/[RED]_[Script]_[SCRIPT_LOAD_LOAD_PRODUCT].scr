def loadAllFiles(externalStageName=""):
        if extendedProperty['FILE_TYPE'] == "CSV" or loadTableProperties['fileType'] in ('xlsx','csv'):
            copyStatement ="""
            COPY INTO """+loadTableProperties['targetTableName']+"""
            (PRODUCT_ID
            , PRODUCT_CODE
            , PRODUCT_NAME
            , PRODUCT_DESCRIPTION
            , BARCODE_VALUE
            , VENDOR_ID
            , PRODUCT_GROUP_CODE
            , PRODUCT_SUB_GROUP_CODE
            , PRODUCT_LINE_CODE
            , DIMENSION_UOM
            , DIMENSION_1
            , DIMENSION_2
            , DIMENSION_3
            , VOLUME_UOM
            , VOLUME
            , WEIGHT_UOM
            , WEIGHT
            , AUTO_REORDER_FLAG
            , AUTO_REORDER_AMOUNT
            , CREATING_EMPLOYEE_ID
            , CREATED_DATETIME
            , LAST_CHANGE_EMPLOYEE_ID
            , LAST_CHANGE_DATETIME
            , DSS_RECORD_SOURCE
            , DSS_LOAD_DATE
            )
            FROM (
              SELECT t.$1
                       , t.$2
                       , t.$3
                       , t.$4
                       , t.$5
                       , t.$6
                       , t.$7
                       , t.$8
                       , t.$9
                       , t.$10
                       , t.$11
                       , t.$12
                       , t.$13
                       , t.$14
                       , t.$15
                       , t.$16
                       , t.$17
                       , t.$18
                       , t.$19
                       , t.$20
                       , t.$21
                       , t.$22
                       , t.$23
                       , t.$24
                       , t.$25
              FROM """+externalStageName+"""
            )
                        FILE_FORMAT =            """+ getFileFormat()+"""    PURGE = """+PURGE
        else:
            copyStatement = """
            COPY INTO """+loadTableProperties['targetTableName']+"""
            FROM"""+ " @~/WSL"+str(os.environ.get('WSL_SEQUENCE',''))+"-"+str(os.environ.get('WSL_TASK_KEY',''))+"/"+"""
            FILE_FORMAT = """+ getFileFormat() +"""
            PURGE = """+PURGE

        maskedLoad = copyStatement

        write_audit("COPY:")
        write_audit(maskedLoad)

        write_detail("BEGIN COPY INTO" +"'"+ loadTableProperties['targetTableName'] +"'" +" : "+str(datetime.now())+'')

        try:
            loadResult = executeSnowflakeQuery(copyStatement)
        except Exception as exceptionError:
            
            if extendedProperty['DEBUG'] != "TRUE":
                removeSQL = "remove @~/WSL-"+str(os.environ.get('WSL_SEQUENCE',''))+"-"+str(os.environ.get('WSL_TASK_KEY',''))+"*"+";"
                try:
                    executeSnowflakeQuery(removeSQL)
                    #CLEAN UP FILES LOCAL SYSTEM
                    for f in glob.glob(os.path.join(loadTableProperties['sourceFilePath'],loadTableProperties['sourceFileName']).replace(os.sep, '/')+"*"):
                        os.remove(f)
                    write_audit("File Clean up completed from local and snowflake stage ")
                except Exception as exceptionErrorRm:
                    write_audit("File Clean up local and snowflake stage " + repr( exceptionErrorRm))
            write_error("An error has occurred: : " + repr( exceptionError))
            raise Exception("An error has occurred: : " + repr( exceptionError))

        write_detail("END COPY INTO "+"'"+ str(os.environ.get('WSL_LOAD_FULLNAME','')) +"'" +" : "+str(datetime.now())+'')
        checkStatus=0
        rowsLoaded=0
        checkFlag=0
        write_audit("File                                            " + "Status         " + "Rows Parsed        "+"Rows Loaded  ")
        write_audit("------------------------------------------------" + "---------------" + "-------------------"+"-------------------  ")
        while len(loadResult)> checkStatus:
            if loadResult[checkStatus][5] == 0:
                rowsLoaded = rowsLoaded + loadResult[checkStatus][3]
            else:
                checkFlag=1
            write_audit(str(loadResult[checkStatus][0])+"       "+str(loadResult[checkStatus][1])+"       "+str(loadResult[checkStatus][2])+"       "+str(loadResult[checkStatus][3])+"       ")
            checkStatus = checkStatus+1

        if checkFlag==0:

            write_audit(str(rowsLoaded) +" rows loaded.")
            try:
                #-- WsWrkTask call to updated row counts in Ws_Wrk_Task_Run/Log
                metaResult=WslPythonCommon.WsWrkTask(0,0,0,rowsLoaded,0,0,0)
            except:
                write_audit("Failed to update task row count")
            
            if loadTableProperties['rowCount'][1] == rowsLoaded:
                write_audit("Load successful. Source rowcount "+str(loadTableProperties['rowCount'][1])+". "+str(rowsLoaded)+" rows loaded.")
                write_audit("Source rowcount "+str(loadTableProperties['rowCount'][1])+". "+str(rowsLoaded)+" rows loaded.")
            else:
                write_error("Source and Target rowcount does not match. Source rowcount "+str(loadTableProperties['rowCount'][1])+". Target rowcount "+str(rowsLoaded)+".")
                raise Exception("Source and Target rowcount does not match. Source rowcount "+str(loadTableProperties['rowCount'][1])+". Target rowcount "+str(rowsLoaded)+".")
            

            write_detail("Temporary data files not removed as debug mode is enabled")
            if extendedProperty['DEBUG'] == "FALSE":
                
                x=0
                #For multiple input files add file name to list
                dataFiles = []
                for f in glob.glob(os.path.join(loadTableProperties['sourceFilePath'],loadTableProperties['sourceFileName']).split(".")[0]+"*"): 
                  dataFiles.append(f)
                while x< len(dataFiles):
                    if extendedProperty['SEND_FILES_ZIPPED'] == "TRUE":
                      if os.path.isfile(str(dataFiles[x]).split(".")[0]+".gz") == True:
                        os.remove(str(dataFiles[x]).split(".")[0]+".gz")
                    else:
                       if os.path.isfile(str(dataFiles[x])) == True:
                        os.remove(str(dataFiles[x]))
                    x=x+1
                if os.path.isfile(os.path.join(loadTableProperties['sourceFilePath'],loadTableProperties['sourceFileName']).replace(os.sep, '/')+".txt")==True:
                    os.remove(os.path.join(loadTableProperties['sourceFilePath'],loadTableProperties['sourceFileName']).replace(os.sep, '/')+".txt")

            if extendedProperty['EXTERNAL_STAGE'] =="":
                    try:
                        removeSQL = "remove @~/WSL-"+str(os.environ.get('WSL_SEQUENCE',''))+"-"+str(os.environ.get('WSL_TASK_KEY',''))+"*"+";"
                        executeSnowflakeQuery(removeSQL)
                    except Exception as exceptionError:
                        write_error("Failed to clean up file"+ repr( exceptionError))
                        raise exceptionError
            return 1
        else:
            write_error("Load failed")
            raise Exception("Load failed")











def loadDataUsingLocalFile(sourceFilePath, sourceFileName,dataFileList):
    dataFiles = dataFileList
    fileFormat = getFileFormat()
    if extendedProperty['EXTERNAL_STAGE'] == "":
        x=0
        while x< len(dataFiles):
            originalName = dataFiles[x]
            if extendedProperty['SEND_FILES_ZIPPED'] == "TRUE":
               dataFiles[x]=WslPythonCommon.GzipFile(dataFiles[x],'.gz',True,"")

               write_audit("File "+ originalName +" GZipped to "+ dataFiles[x] +" prior to upload") 
            x=x+1 

    write_audit("================= LOAD =================")

    if extendedProperty['EXTERNAL_STAGE'] =="": 
        externalStageName = "@~/WSL-"+str(os.environ.get('WSL_SEQUENCE',''))+"-"+str(os.environ.get('WSL_TASK_KEY',''))+"/"+" t" 
    else: 
        if sourceFileName.strip() == "":
            externalStageName="@"+ extendedProperty['EXTERNAL_STAGE'] +"/"+" t" 
        else:
            externalStageName="@"+ extendedProperty['EXTERNAL_STAGE'] +"/"+sourceFileName/+" t" 

    if (runMode != "S3" and runMode != "AZ" and runMode != "GCS") or extendedProperty['EXTERNAL_STAGE'] !="":
        if runMode != "S3" and runMode != "AZ" and runMode != "GCS" and extendedProperty['EXTERNAL_STAGE'] =="":
            #CLEAN UP SNOWFLAKE STAGE FILES

            removeSQL = "remove @~/WSL-"+str(os.environ.get('WSL_SEQUENCE',''))+"-"+str(os.environ.get('WSL_TASK_KEY',''))+"*"+";"
            try:
                executeSnowflakeQuery(removeSQL)
            except Exception as exceptionError:
                write_error("Failed to clean up file from snowflake stage")
            
            if extendedProperty['SEND_FILES_ZIPPED'] == "TRUE":
                putSQL = r"PUT 'file://" +os.path.join(sourceFilePath,sourceFileName).replace(os.sep, '/').replace("."+sourceFileName.split(".")[-1],"")+r"*.gz'"+" @~/WSL-"+str(os.environ.get('WSL_SEQUENCE',''))+"-"+str(os.environ.get('WSL_TASK_KEY',''))+"/ ;"
            else:
                putSQL = r"PUT 'file://" +os.path.join(sourceFilePath,sourceFileName).replace(os.sep, '/').replace("."+sourceFileName.split(".")[-1],"")+r"*'"+" @~/WSL-"+str(os.environ.get('WSL_SEQUENCE',''))+"-"+str(os.environ.get('WSL_TASK_KEY',''))+";"
            try:
                executeSnowflakeQuery(putSQL)
            except Exception as exceptionError:
                write_error("File "+ fileCheck +" was not found. ")
                raise exceptionError

            write_detail("BEGIN PUT of files matching" +sourceFilePath+sourceFileName+" : "+str(datetime.now())+'')
            write_audit("PUT:")
            write_audit(putSQL)
            write_audit("")

            write_detail("END PUT of files matching " +sourceFileName+" : "+str(datetime.now())+'')

            alterTimeZone()
            loadAllFiles(externalStageName)
        else:
            alterTimeZone()
            loadAllFiles(externalStageName)


